#!/usr/bin/env python3
"""silkgate — host control CLI for the egress-proxied agent sandbox.

`run` is one-shot: proxy + guest born and torn down per command. Persistent
sessions instead share ONE background mitmdump (a pool of listener ports) across
many background guests — `up`/`exec`/`attach`/`down`, one guest per session, one
dedicated proxy port each. Host state lives under ~/.silkgate. See ../README.md.

    silkgate build                 build the guest image and load it into msb
    silkgate verify [--full]       Tier-1 containment check (test/verify_guest.sh)
    silkgate proxy [--preset X]    run only the proxy (single-tenant), audit on stdout
    silkgate run [-- CMD ...]      ephemeral session (up + exec + down), foreground
    silkgate up [--name N ...]     start a persistent session (bg guest + shared proxy)
    silkgate exec N [-t] -- CMD    run a command in a session's guest
    silkgate attach N              attach a TTY to a session (default cmd: claude)
    silkgate logs N [-f|--audit]   tail a session's guest output (or its proxy decisions)
    silkgate down N                stop + remove a session (+ the proxy if it was the last)
    silkgate ls                    list sessions + shared-proxy health
    silkgate secret set NAME       push EGRESS_SECRET_<NAME> to the shared proxy (never argv)
    silkgate secret ls             list secret names held by the proxy (names only)

Secrets stay in the environment: EGRESS_SECRET_<NAME>="<header>: <value>" on the
host feeds inject_auth=<name> rules; the guest never sees them.
"""
import argparse
import json
import os
import platform
import re
import shutil
import signal
import socket
import subprocess
import sys
import termios
import time
from datetime import datetime
from pathlib import Path
from uuid import uuid4

REPO = Path(__file__).resolve().parent.parent
ADDON = REPO / "mitmaddon" / "proxy_addon.py"
PRESET_DIR = REPO / "mitmaddon" / "presets"
IMAGE_DIR = REPO / "image"
MITM_CA = Path.home() / ".mitmproxy" / "mitmproxy-ca-cert.pem"
SILK_DIR = Path.home() / ".silkgate"
LOG_DIR = SILK_DIR / "logs"
SESSIONS_DIR = SILK_DIR / "sessions"
PROXY_JSON = SILK_DIR / "proxy.json"          # shared-proxy meta (pid/ports/log/sock)
PROXY_SOCK = SILK_DIR / "proxy.sock"          # control socket (line-delimited JSON)
POOL_SIZE = 16                                 # base_port .. base_port+15
DEFAULT_BASE_PORT = 8090
PROXY_ALIAS = "host.microsandbox.internal"   # resolves via the guest's /etc/hosts
PROXY_ENV_VARS = ("HTTPS_PROXY", "HTTP_PROXY", "https_proxy", "http_proxy")
DEFAULT_IMAGE = "claude-sandbox:poc"

sys.path.insert(0, str(REPO / "mitmaddon"))
from rule_engine import RuleSet


def die(msg, code=1):
    print(f"silkgate: {msg}", file=sys.stderr)
    sys.exit(code)


def say(msg):
    print(f"silkgate: {msg}", file=sys.stderr)


def which(binary, hint):
    path = shutil.which(binary)
    if path is None:
        die(f"{binary} not found — {hint}")
    return path


def tail(path, lines=10):
    return "\n".join(path.read_text(errors="replace").splitlines()[-lines:])


# --- rules -------------------------------------------------------------------

def resolve_rules(presets, files):
    paths = []
    for name in presets:
        p = PRESET_DIR / f"{name}.txt"
        if not p.is_file():
            avail = ", ".join(sorted(q.stem for q in PRESET_DIR.glob("*.txt")))
            die(f"unknown preset {name!r} (available: {avail})")
        paths.append(p)
    for f in files:
        p = Path(f)
        if not p.is_file():
            die(f"rules file not found: {f}")
        paths.append(p.resolve())
    return paths


def load_ruleset(paths):
    """Parse up front so bad rules fail here, not inside mitmdump at startup."""
    rules = []
    for p in paths:
        try:
            rules.extend(RuleSet.parse(p.read_text()).rules)
        except ValueError as e:
            die(f"{p}: {e}")
    return RuleSet(rules)


def check_env(pairs):
    """Validate -e NAME=VALUE pairs; clobbering the proxy config is always an error."""
    for pair in pairs:
        name, sep, _ = pair.partition("=")
        if not sep or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
            die(f"bad -e argument {pair!r} (expected NAME=VALUE)")
        if name in PROXY_ENV_VARS:
            die(f"-e {name} collides with the proxy configuration silkgate sets")


def check_secrets(ruleset, fatal):
    names = sorted({r.inject_auth for r in ruleset.rules if r.inject_auth})
    missing = [n for n in names if not os.environ.get(f"EGRESS_SECRET_{n.upper()}")]
    if not missing:
        return
    msg = ("missing secret(s): "
           + ", ".join(f'EGRESS_SECRET_{n.upper()}="<header>: <value>"' for n in missing))
    if fatal:
        die(msg)
    say(f"warning: {msg} — inject_auth requests will 500")


# --- host processes ----------------------------------------------------------

def start_proxy(rule_paths, port):
    """Start mitmdump in the background; return (proc, audit log path)."""
    mitmdump = which("mitmdump", "pip install mitmproxy")
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    log_path = LOG_DIR / f"proxy-{datetime.now():%Y%m%d-%H%M%S}.log"
    env = dict(os.environ, EGRESS_RULES=":".join(str(p) for p in rule_paths))
    with open(log_path, "wb") as log:
        proc = subprocess.Popen([mitmdump, "-s", str(ADDON), "--listen-port", str(port)],
                                env=env, stdout=log, stderr=subprocess.STDOUT)
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        if proc.poll() is not None:
            die(f"proxy exited at startup — {log_path}:\n{tail(log_path)}")
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=0.5):
                return proc, log_path
        except OSError:
            time.sleep(0.2)
    stop(proc)
    die(f"proxy did not open port {port} within 15s — see {log_path}")


def stop(proc):
    if proc.poll() is None:
        proc.terminate()
        try:
            proc.wait(5)
        except subprocess.TimeoutExpired:
            proc.kill()


def wait_foreground(proc):
    """The child owns the terminal: Ctrl-C reaches it directly (same process group), so
    the parent must survive SIGINT to clean up afterwards. A Python-level handler is not
    inherited across exec, so the child's own SIGINT behavior is untouched."""
    previous = signal.signal(signal.SIGINT, lambda *a: None)
    try:
        return proc.wait()
    finally:
        signal.signal(signal.SIGINT, previous)


def msb_argv(image, cmd, port, *, pull_never=True, mounts=()):
    """One-shot `msb run` of a guest locked to one proxy port (the verify path)."""
    argv = [which("msb", "curl -fsSL https://install.microsandbox.dev | sh"), "run", image]
    if pull_never:
        argv += ["--pull", "never"]
    for m in mounts:
        argv += ["-v", m]
    url = f"http://{PROXY_ALIAS}:{port}"
    for var in PROXY_ENV_VARS:
        argv += ["-e", f"{var}={url}"]
    argv += ["--net-default-egress", "deny", "--net-rule", f"allow@host:tcp:{port}"]
    return argv + ["--"] + list(cmd)


def ensure_ca():
    """Put the mitmproxy CA cert at image/egress-ca.pem, generating it on first use."""
    if not MITM_CA.is_file():
        mitmdump = which("mitmdump", "pip install mitmproxy")
        say("generating the mitmproxy CA (first run)…")
        with socket.socket() as s:
            s.bind(("127.0.0.1", 0))
            port = s.getsockname()[1]
        proc = subprocess.Popen([mitmdump, "-q", "--listen-port", str(port)],
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        deadline = time.monotonic() + 15
        while time.monotonic() < deadline and not MITM_CA.is_file():
            time.sleep(0.2)
        stop(proc)
        if not MITM_CA.is_file():
            die(f"mitmproxy did not create {MITM_CA} — run mitmdump once manually")
    shutil.copyfile(MITM_CA, IMAGE_DIR / "egress-ca.pem")


# --- persistent sessions: host state ----------------------------------------

def now_iso():
    return datetime.now().astimezone().isoformat(timespec="seconds")


def _write_json(path, obj):
    """Atomic-ish write: temp file then rename, so a reader never sees half a file."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(obj))
    tmp.replace(path)


def _read_json(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return None


def session_dir(name):
    return SESSIONS_DIR / name


def sandbox_name(name):
    return f"sg-{name}"


def _validate_name(name):
    # Used as a dir name, an msb sandbox name (sg-<name>), and a net-rule component.
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]{0,31}", name or ""):
        die(f"invalid session name {name!r} (letters, digits, '-', '_'; ≤32 chars)")


def read_meta(name):
    return _read_json(session_dir(name) / "meta.json")


def list_metas():
    if not SESSIONS_DIR.is_dir():
        return []
    metas = []
    for d in sorted(SESSIONS_DIR.iterdir()):
        if d.name.startswith("."):               # staging dirs are not sessions
            continue
        m = read_meta(d.name)
        if m:
            metas.append(m)
    return metas


def _compose_rules(paths):
    """Snapshot the composed ruleset into one text blob for the session's rules.txt."""
    out = []
    for p in paths:
        out.append(f"# --- {p} ---")
        out.append(p.read_text().rstrip("\n"))
    return "\n".join(out) + "\n"


# --- shared proxy -----------------------------------------------------------

def read_proxy():
    return _read_json(PROXY_JSON)


def proxy_alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True          # exists but not ours — count it alive
    return True


def _proxy_running():
    m = read_proxy()
    return bool(m and proxy_alive(m.get("pid")))


def _clear_proxy_files():
    for p in (PROXY_JSON, PROXY_SOCK):
        try:
            p.unlink()
        except OSError:
            pass


def start_shared_proxy(base_port):
    """Start the detached multi-session mitmdump; write proxy.json; return its meta."""
    mitmdump = which("mitmdump", "pip install mitmproxy")
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    SESSIONS_DIR.mkdir(parents=True, exist_ok=True)
    log_path = LOG_DIR / f"proxy-{datetime.now():%Y%m%d-%H%M%S}.log"
    ports = list(range(base_port, base_port + POOL_SIZE))
    argv = [mitmdump, "-s", str(ADDON)]
    for p in ports:
        argv += ["--mode", f"regular@{p}"]
    # Multi-session mode: EGRESS_SESSIONS_DIR on, EGRESS_RULES off (addon needs exactly one).
    env = dict(os.environ, EGRESS_SESSIONS_DIR=str(SESSIONS_DIR),
               EGRESS_CONTROL_SOCK=str(PROXY_SOCK))
    env.pop("EGRESS_RULES", None)
    with open(log_path, "wb") as log:
        proc = subprocess.Popen(argv, env=env, stdout=log, stderr=subprocess.STDOUT,
                                start_new_session=True)
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        if proc.poll() is not None:
            die(f"proxy exited at startup — {log_path}:\n{tail(log_path)}")
        try:
            with socket.create_connection(("127.0.0.1", base_port), timeout=0.5):
                break
        except OSError:
            time.sleep(0.2)
    else:
        try:
            proc.kill()
        except OSError:
            pass
        die(f"proxy did not open port {base_port} within 15s — see {log_path}")
    meta = {"pid": proc.pid, "base_port": base_port, "ports": ports,
            "log": str(log_path), "sock": str(PROXY_SOCK), "started": now_iso()}
    _write_json(PROXY_JSON, meta)
    return meta


def ensure_proxy(base_port):
    """Return the running shared-proxy meta, starting it (on base_port) if need be."""
    meta = read_proxy()
    if meta and proxy_alive(meta.get("pid")):
        return meta
    if meta:                                  # stale meta from a dead proxy
        _clear_proxy_files()
    meta = start_shared_proxy(base_port)
    _wait_control_sock(10)                     # base-port readiness ≠ socket readiness
    return meta


def stop_proxy(meta):
    pid = meta.get("pid") if meta else None
    if pid and proxy_alive(pid):
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline and proxy_alive(pid):
            time.sleep(0.1)
        if proxy_alive(pid):
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
    _clear_proxy_files()


def pick_port(proxy, name):
    """Lowest pool port not already claimed by another session's meta."""
    claimed = {m.get("port") for m in list_metas() if m.get("name") != name}
    for p in proxy["ports"]:
        if p not in claimed:
            return p
    die(f"no free proxy ports (pool {proxy['ports'][0]}..{proxy['ports'][-1]} is full)")


# --- control socket ---------------------------------------------------------

def _sock_call(req):
    """One line-delimited JSON request/response against the proxy control socket."""
    if not PROXY_SOCK.exists():
        die("shared proxy control socket missing — is a session up?")
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(5)
            s.connect(str(PROXY_SOCK))
            f = s.makefile("rw")
            f.write(json.dumps(req) + "\n")
            f.flush()
            line = f.readline()
    except OSError as e:
        die(f"control socket error: {e}")
    if not line:
        die("control socket closed without a response")
    try:
        resp = json.loads(line)
    except ValueError:
        die("control socket sent a non-JSON response")
    if not resp.get("ok"):
        die(f"control op {req.get('op')!r} failed: {resp.get('error', 'unknown error')}")
    return resp


def _wait_control_sock(timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.settimeout(0.5)
                s.connect(str(PROXY_SOCK))
                f = s.makefile("rw")
                f.write('{"op": "ping"}\n')
                f.flush()
                if f.readline():
                    return
        except OSError:
            pass
        time.sleep(0.2)
    die("shared proxy control socket did not become ready")


def _push_secrets(ruleset):
    """Push every inject_auth secret we hold in the env, then fail on any still missing."""
    names = sorted({r.inject_auth for r in ruleset.rules if r.inject_auth})
    for n in names:
        value = os.environ.get(f"EGRESS_SECRET_{n.upper()}")
        if value:                                       # value goes over the socket only
            _sock_call({"op": "set_secret", "name": n.lower(), "value": value})
    have = {x.lower() for x in _sock_call({"op": "list_secrets"}).get("names", [])}
    missing = [n for n in names if n.lower() not in have]
    if missing:
        die("missing secret(s): "
            + ", ".join(f'EGRESS_SECRET_{n.upper()}="<header>: <value>"' for n in missing))


# --- msb session guests -----------------------------------------------------

def _msb():
    return which("msb", "curl -fsSL https://install.microsandbox.dev | sh")


def msb_create_argv(sandbox, image, port, *, mounts=(), env=()):
    """A backgrounded, idling guest whose only egress is its own proxy port."""
    argv = [_msb(), "create", image, "--name", sandbox, "--pull", "never"]
    for m in mounts:
        argv += ["-v", m]
    url = f"http://{PROXY_ALIAS}:{port}"
    for var in PROXY_ENV_VARS:                          # inherited by every later exec
        argv += ["-e", f"{var}={url}"]
    for pair in env:
        argv += ["-e", pair]
    argv += ["--net-default-egress", "deny", "--net-rule", f"allow@host:tcp:{port}"]
    return argv


def msb_exec_argv(sandbox, cmd, *, tty=False, env=()):
    argv = [_msb(), "exec", "-q"]                       # -q silences msb progress noise
    if tty:
        argv.append("-t")
    for pair in env:
        argv += ["-e", pair]
    return argv + [sandbox, "--"] + list(cmd)


# A PTY makes programs emit terminal control: colors, cursor moves, and a reset burst on
# exit. Downstream of the relay stdout is a pipe or a file, so those bytes are never drawn —
# they just corrupt logs and break JSON parsers. Strip them and keep the text.
_ANSI = re.compile(rb"\x1b\[[0-9:;<=>?]*[ -/]*[@-~]"        # CSI: params per ECMA-48, so the
                                                            # "<=>?" private forms match too
                   rb"|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\|$)"  # OSC, incl. one cut off at EOL
                   rb"|\x1b[()][A-Za-z0-9]"                # charset selection
                   rb"|\x1b[=>78]"                         # keypad / cursor save-restore
                   rb"|[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]")  # stray control bytes (keeps \t, \n)


def _plain(line):
    return _ANSI.sub(b"", line.rstrip(b"\r"))


_ERR_TAG = b"\x1e"          # RS: not something line-oriented guest output produces on its own

# msb forwards output as it arrives only when its own stdout is a terminal, so a live run
# needs a PTY — but the *command* must not be the one holding it, or it would switch to
# interactive behavior (colors, cursor control, a reset burst on exit) and its two streams
# would merge into the terminal. So give the command plain pipes and relay: two FIFOs carry
# its streams to loops that tag stderr and write into the PTY the shell holds. The shell
# waits for both loops, so no trailing line is lost to the race with the command's exit, and
# $? stays the command's own. POSIX sh + mkfifo; stdin is /dev/null, as for any captured run.
_RELAY_SH = ('d=$(mktemp -d); mkfifo "$d/o" "$d/e"; '
             'while IFS= read -r l || [ -n "$l" ]; do printf "%s\\n" "$l"; done <"$d/o" & po=$!; '
             f'while IFS= read -r l || [ -n "$l" ]; do printf "\\{ord(_ERR_TAG):03o}%s\\n" "$l"; done <"$d/e" & pe=$!; '
             '"$@" </dev/null >"$d/o" 2>"$d/e"; rc=$?; wait $po $pe; rm -rf "$d"; exit $rc')


def run_guest(build_argv, cmd, *, tty):
    """Run a guest command and return its exit code.

    Default (`--no-tty`): the command runs non-interactively with pipes for stdout/stderr,
    and its output still arrives live, split across our own two streams — see _RELAY_SH.
    With `-t` the command gets a real terminal instead, for a TUI.
    """
    if tty:
        if sys.stdout.isatty():
            # Inheriting a real terminal is what keeps a TUI fully interactive.
            return wait_foreground(subprocess.Popen(build_argv(cmd)))
        return _pty_relay(build_argv(cmd), demux=False)
    return _pty_relay(build_argv(["sh", "-c", _RELAY_SH, "_"] + list(cmd)), demux=True)


def _pty_relay(argv, *, demux):
    """Run argv with a PTY for its stdio and copy what it writes to our own streams.

    `demux` splits the tagged lines back out (and drops terminal control bytes, insurance
    against a program that colors regardless of not being on a terminal); without it the
    bytes pass through untouched, which a TUI driven from a pipe needs.
    """
    ptm, pts = os.openpty()
    try:
        attrs = termios.tcgetattr(pts)                  # no echo: our EOF byte below would
        attrs[3] &= ~termios.ECHO                       # otherwise come back as "^D"
        termios.tcsetattr(pts, termios.TCSANOW, attrs)
        proc = subprocess.Popen(argv, stdin=pts, stdout=pts, stderr=pts)
        os.close(pts)
        if not sys.stdin.isatty():
            os.write(ptm, b"\x04")                      # EOF: nothing will type at this PTY
        buf = b""
        while True:
            try:
                chunk = os.read(ptm, 65536)
            except OSError:                             # slave closed — the child is done
                break
            if not chunk:
                break
            if not demux:
                sys.stdout.buffer.write(chunk)
                sys.stdout.buffer.flush()
                continue
            buf += chunk
            while b"\n" in buf:                         # a line is the unit for both the
                line, buf = buf.split(b"\n", 1)         # stderr tag and ANSI stripping
                _relay(line, newline=True)
        if buf:
            _relay(buf, newline=False)
        return wait_foreground(proc)
    finally:
        os.close(ptm)


def _relay(line, *, newline):
    """Write one relayed line to our stdout, or to stderr if the guest tagged it."""
    tagged = line.startswith(_ERR_TAG)
    stream = sys.stderr.buffer if tagged else sys.stdout.buffer
    text = _plain(line[len(_ERR_TAG):] if tagged else line)
    stream.write(text + b"\n" if newline else text)
    stream.flush()


def _workspace_mount(workspace):
    if not workspace:
        return None, []
    w = Path(workspace).resolve()
    if not w.is_dir():
        die(f"workspace is not a directory: {w}")
    return str(w), [f"{w}:/workspace:rw"]


def _provision_session(name, image, port, rule_paths, ruleset, mounts, ws, env):
    """Stage the session dir then rename it into the registry, so its appearance is atomic:
    the addon rescans on the sessions-dir mtime and must never see (and cache) a half-written
    session. Boot the guest after; remove the session on any failure."""
    sdir = session_dir(name)
    if sdir.exists():
        die(f"session already exists: {sdir}")
    tmp = SESSIONS_DIR / f".tmp-{name}"                  # dot-prefixed: invisible to registries
    shutil.rmtree(tmp, ignore_errors=True)               # stale leftover from a crash
    tmp.mkdir(parents=True)
    try:
        (tmp / "rules.txt").write_text(_compose_rules(rule_paths))
        _write_json(tmp / "meta.json", {"name": name, "sandbox": sandbox_name(name),
                                        "port": port, "image": image, "workspace": ws,
                                        "created": now_iso()})
        try:
            tmp.rename(sdir)                             # atomic claim; fails if name raced us
        except OSError:
            die(f"session already exists: {sdir}")
        _push_secrets(ruleset)
        if subprocess.run(msb_create_argv(sandbox_name(name), image, port,
                                          mounts=mounts, env=env)).returncode:
            die(f"msb create failed for session {name!r}")
    except BaseException:                                # incl. SystemExit from die()
        shutil.rmtree(tmp, ignore_errors=True)
        shutil.rmtree(sdir, ignore_errors=True)
        raise


def _teardown_session(meta):
    """Stop (required) then rm the guest, then drop the session dir. Best-effort, fail-clean."""
    name = meta.get("name")
    sandbox = meta.get("sandbox") or (sandbox_name(name) if name else None)
    msb = shutil.which("msb")
    if msb and sandbox:
        subprocess.run([msb, "stop", sandbox],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if subprocess.run([msb, "rm", sandbox],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode:
            say(f"warning: msb rm {sandbox} failed — remove it manually")
    if name:
        shutil.rmtree(session_dir(name), ignore_errors=True)


def _maybe_stop_proxy():
    """Terminate the shared proxy once the last session is gone."""
    if list_metas():
        return
    meta = read_proxy()
    if meta:
        stop_proxy(meta)


# --- commands ------------------------------------------------------------------

_DOCKER_PLATFORMS = {"arm64": "linux/arm64", "aarch64": "linux/arm64",
                     "x86_64": "linux/amd64", "amd64": "linux/amd64"}


def cmd_build(args):
    docker = which("docker", "the guest image is built with docker, then loaded into msb")
    msb = which("msb", "curl -fsSL https://install.microsandbox.dev | sh")
    plat = args.platform or _DOCKER_PLATFORMS.get(platform.machine().lower())
    if plat is None:
        die(f"unknown host arch {platform.machine()!r} — pass --platform (e.g. linux/amd64)")
    ensure_ca()
    if subprocess.run([docker, "build", "--platform", plat,
                       "-t", args.tag, str(IMAGE_DIR)]).returncode:
        die("docker build failed")
    save = subprocess.Popen([docker, "save", args.tag], stdout=subprocess.PIPE)
    load = subprocess.run([msb, "load"], stdin=save.stdout)
    save.stdout.close()
    if save.wait() or load.returncode:
        die("docker save | msb load failed")
    say(f"loaded {args.tag} into msb")


def cmd_proxy(args):
    rule_paths = resolve_rules(args.preset or ["claude"], args.rules or [])
    check_secrets(load_ruleset(rule_paths), fatal=False)
    mitmdump = which("mitmdump", "pip install mitmproxy")
    env = dict(os.environ, EGRESS_RULES=":".join(str(p) for p in rule_paths))
    proc = subprocess.Popen([mitmdump, "-s", str(ADDON), "--listen-port", str(args.port)], env=env)
    try:
        sys.exit(wait_foreground(proc))
    finally:
        stop(proc)


def _strip_cmd_sep(cmd):
    return cmd[1:] if cmd and cmd[0] == "--" else cmd


def cmd_run(args):
    """One-shot over a persistent session: up (ephemeral) -> exec -> down, all foreground."""
    check_env(args.env)
    rule_paths = resolve_rules(args.preset or ["claude"], args.rules or [])
    ruleset = load_ruleset(rule_paths)
    cmd = _strip_cmd_sep(args.cmd) or ["claude"]
    tty = args.tty if args.tty is not None else sys.stdin.isatty()
    ws, mounts = _workspace_mount(args.workspace)
    name = uuid4().hex[:6]
    proxy_was_running = _proxy_running()        # --port is the base port iff WE start it
    proxy = ensure_proxy(args.port)
    port = pick_port(proxy, name)
    rc, provisioned = 1, False
    try:
        _provision_session(name, args.image, port, rule_paths, ruleset, mounts, ws, args.env)
        provisioned = True
        say(f"session {name} · proxy :{port} · audit: tail -f {proxy['log']}")
        rc = run_guest(lambda c: msb_exec_argv(sandbox_name(name), c, tty=tty, env=args.env),
                       cmd, tty=tty)
    finally:
        if provisioned:
            _teardown_session(read_meta(name) or
                              {"name": name, "sandbox": sandbox_name(name)})
        # Only tear down the proxy if this command started it and nothing else needs it.
        if not proxy_was_running and not list_metas():
            stop_proxy(read_proxy() or proxy)
    sys.exit(rc)


def cmd_up(args):
    check_env(args.env)
    rule_paths = resolve_rules(args.preset or ["claude"], args.rules or [])
    ruleset = load_ruleset(rule_paths)
    name = args.name or uuid4().hex[:6]
    _validate_name(name)
    if session_dir(name).exists():
        die(f"session {name!r} already exists")
    ws, mounts = _workspace_mount(args.workspace)
    proxy = ensure_proxy(args.port)
    port = pick_port(proxy, name)
    _provision_session(name, args.image, port, rule_paths, ruleset, mounts, ws, args.env)
    say(f"session {name} up · proxy :{port} · audit: tail -f {proxy['log']}")
    print(name)


def cmd_exec(args):
    meta = read_meta(args.name)
    if not meta:
        die(f"no such session: {args.name!r} (silkgate ls)")
    check_env(args.env)
    cmd = _strip_cmd_sep(args.cmd)
    if not cmd:
        die("nothing to run — usage: silkgate exec NAME [-t] [-e K=V]... -- CMD ...")
    tty = args.tty if args.tty is not None else sys.stdin.isatty()
    sys.exit(run_guest(lambda c: msb_exec_argv(meta["sandbox"], c, tty=tty, env=args.env),
                       cmd, tty=tty))


def cmd_attach(args):
    meta = read_meta(args.name)
    if not meta:
        die(f"no such session: {args.name!r} (silkgate ls)")
    sys.exit(run_guest(lambda c: msb_exec_argv(meta["sandbox"], c, tty=True),
                       ["claude"], tty=True))


def cmd_down(args):
    meta = read_meta(args.name)
    if not meta:
        die(f"no such session: {args.name!r} (silkgate ls)")
    _teardown_session(meta)
    _maybe_stop_proxy()
    say(f"session {args.name} down")


def _age(iso):
    try:
        t = datetime.fromisoformat(iso)
    except (TypeError, ValueError):
        return "?"
    secs = max(0, int((datetime.now(t.tzinfo) - t).total_seconds()))
    for size, unit in ((86400, "d"), (3600, "h"), (60, "m")):
        if secs >= size:
            return f"{secs // size}{unit}"
    return f"{secs}s"


def _msb_statuses():
    """sandbox name -> STATUS, parsed from `msb list` (NAME/IMAGE/STATUS columns)."""
    msb = shutil.which("msb")
    if not msb:
        return {}
    try:
        out = subprocess.run([msb, "list"], capture_output=True, text=True).stdout
    except OSError:
        return {}
    statuses = {}
    for line in out.splitlines()[1:]:            # skip the header row
        cols = line.split()
        if len(cols) >= 3:
            statuses[cols[0]] = cols[2]
    return statuses


def _print_table(rows):
    widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
    for r in rows:
        print("  ".join(c.ljust(widths[i]) for i, c in enumerate(r)).rstrip())


def cmd_ls(args):
    metas = list_metas()
    if not metas:
        print("no sessions")
    else:
        statuses = _msb_statuses()
        rows = [("NAME", "STATUS", "PORT", "WORKSPACE", "AGE")]
        for m in metas:
            rows.append((m["name"], statuses.get(m["sandbox"], "?"),
                         str(m.get("port", "?")), m.get("workspace") or "-",
                         _age(m.get("created"))))
        _print_table(rows)
    proxy = read_proxy()
    if proxy and proxy_alive(proxy.get("pid")):
        pool = proxy["ports"]
        print(f"proxy: pid {proxy['pid']} alive · ports {pool[0]}-{pool[-1]} · {proxy['log']}")
    else:
        print("proxy: not running")


# --- logs: per-session observability ----------------------------------------
# msb's exec is RPC-shaped — a parent sees nothing until the guest exits — but the
# sandbox's captured log IS live, and there is no `msb logs --follow`, so -f polls it.

def _emit(lines):
    """Print lines and flush now, so follow is live and a closed pipe surfaces promptly."""
    for ln in lines:
        print(ln)
    sys.stdout.flush()


def _run_msb_logs(sandbox, tail_n=None, since=None):
    """`msb logs` for one sandbox -> (lines, None) or (None, error). Non-zero/OSError => gone."""
    argv = [_msb(), "logs", sandbox]
    if tail_n is not None:
        argv += ["--tail", str(tail_n)]
    if since is not None:
        argv += ["--since", since]
    try:
        proc = subprocess.run(argv, capture_output=True, text=True)
    except OSError as e:
        return None, str(e)
    if proc.returncode:
        return None, (proc.stderr.strip() or f"msb logs exited {proc.returncode}")
    return proc.stdout.splitlines(), None


def _logs_guest(args, meta):
    sandbox = meta["sandbox"]
    if not args.follow:                              # one-shot: pass shaping straight to msb
        lines, err = _run_msb_logs(sandbox, args.tail, args.since)
        if err is not None:
            die(f"cannot read guest logs for {args.name!r}: {err}")
        _emit(lines)
        return
    # Follow: seed `printed` to the whole current log's length so history never reprints,
    # then each poll re-fetches from a FIXED start (the whole log, an append-only string)
    # and emits only the suffix past `printed`. --tail/--since shape the first view only:
    # --tail is a pure offset into `full`; --since needs msb's clock, so we ask msb how
    # many recent lines it counts and offset by that (fetching `full` first keeps it from
    # dropping/duplicating anything appended between the two calls).
    full, err = _run_msb_logs(sandbox)
    if err is not None:
        die(f"cannot read guest logs for {args.name!r}: {err}")
    start = 0
    if args.tail is not None:
        start = max(0, len(full) - args.tail)
    elif args.since is not None:
        win, werr = _run_msb_logs(sandbox, since=args.since)
        if werr is None:
            start = max(0, len(full) - len(win))
    _emit(full[start:])
    printed = len(full)
    while True:
        time.sleep(args.interval)
        if not session_dir(args.name).exists():      # someone ran `silkgate down`
            die(f"session {args.name!r} is gone — stopped following")
        lines, err = _run_msb_logs(sandbox)
        if err is not None:                          # sandbox removed / msb unhappy
            die(f"session {args.name!r}: {err} — stopped following")
        n = len(lines)
        if n < printed:                              # rotation/truncation: resync, don't replay
            say(f"guest log for {args.name!r} rotated — resyncing")
            printed = n
        elif n > printed:
            _emit(lines[printed:])
            printed = n


def _audit_match(line, name):
    """True iff `line` is a JSON audit record for session `name`.

    mitmdump stamps every log line with a "[HH:MM:SS.mmm] " prefix and emits its own
    connection chatter, so drop everything before the first brace and require a parse.
    """
    brace = line.find("{")
    if brace < 0:
        return False
    try:
        rec = json.loads(line[brace:])
    except ValueError:
        return False
    return isinstance(rec, dict) and rec.get("session") == name


def _read_from(path, offset):
    """Complete (newline-terminated) lines from byte `offset` -> (lines, new_offset), or
    (None, offset) if the file is unreadable. Advances only past whole lines, so a
    half-written trailing line is re-read on the next poll rather than split."""
    try:
        with open(path, "rb") as f:
            f.seek(offset)
            data = f.read()
    except OSError:
        return None, offset
    cut = data.rfind(b"\n")
    if cut == -1:
        return [], offset
    chunk = data[:cut + 1]
    return chunk.decode("utf-8", "replace").splitlines(), offset + len(chunk)


def _logs_audit(args):
    proxy = read_proxy()
    if not proxy or not proxy.get("log"):
        die("shared proxy not running — no audit log (silkgate ls)")
    if args.since is not None:
        say("--since has no effect on --audit (audit records carry no timestamp)")
    name = args.name
    path = Path(proxy["log"])
    lines, offset = _read_from(path, 0)              # first view = the whole file's history
    if lines is None:
        die(f"cannot read audit log {path}")
    matched = [ln for ln in lines if _audit_match(ln, name)]
    if args.tail is not None:
        matched = matched[-args.tail:] if args.tail > 0 else []
    _emit(matched)
    if not args.follow:
        return
    while True:
        time.sleep(args.interval)
        if not session_dir(name).exists():
            die(f"session {name!r} is gone — stopped following")
        p = read_proxy()
        if not (p and proxy_alive(p.get("pid"))):    # last `down` stopped the shared proxy
            die("shared proxy is gone — stopped following")
        new_path = Path(p.get("log") or path)
        if new_path != path:                         # proxy restarted onto a fresh log file
            say("audit log replaced — resyncing")
            path, offset = new_path, 0
        try:
            size = path.stat().st_size
        except OSError:
            die(f"audit log {path} vanished — stopped following")
        if size < offset:                            # truncated/rotated in place
            say("audit log rotated — resyncing")
            offset = 0
        new_lines, offset = _read_from(path, offset) # byte offset: only the new tail is read
        if new_lines is None:
            die(f"audit log {path} vanished — stopped following")
        _emit([ln for ln in new_lines if _audit_match(ln, name)])


def cmd_logs(args):
    """Stream one session's guest output, or (--audit) its proxy allow/deny decisions.

    A supervising parent sees nothing until an exec exits (msb's exec is RPC-shaped),
    so -f polls the live captured log (there is no `msb logs --follow`). --audit reads
    the shared audit log and keeps only lines whose "session" field is this session."""
    _validate_name(args.name)
    meta = read_meta(args.name)
    if not meta:
        die(f"no such session: {args.name!r} (silkgate ls)")
    if args.tail is not None and args.tail < 0:
        die("--tail must be >= 0")
    if args.interval <= 0:
        die("--interval must be > 0")
    try:
        if args.audit:
            _logs_audit(args)
        else:
            _logs_guest(args, meta)
    except KeyboardInterrupt:
        # Ctrl-C out of follow: quiet, status 130. os._exit skips interpreter shutdown, which
        # would otherwise re-surface the pending SIGINT as a traceback on stderr.
        sys.stdout.flush()
        os._exit(130)
    except BrokenPipeError:                          # `silkgate logs -f x | head`: quiet exit
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)


def cmd_secret_set(args):
    name = args.name
    value = os.environ.get(f"EGRESS_SECRET_{name.upper()}")
    if not value:
        die(f'missing secret: EGRESS_SECRET_{name.upper()}="<header>: <value>"')
    if not _proxy_running():
        die("shared proxy not running — start a session first (silkgate up)")
    _sock_call({"op": "set_secret", "name": name.lower(), "value": value})
    say(f"secret {name.lower()} set")            # value never printed


def cmd_secret_ls(args):
    if not _proxy_running():
        die("shared proxy not running — start a session first (silkgate up)")
    for n in sorted(_sock_call({"op": "list_secrets"}).get("names", [])):
        print(n)


