                        "config become guest-writable, which is host code execution the "
                        "next time a human runs git there")
    p.add_argument("--checkout", nargs="?", const="HEAD", default=None, metavar="REF",
                   help="give the guest a disposable, writable checkout of the enclosing "
                        "repo at REF (default HEAD) at /workspace — guest-local, nothing "
