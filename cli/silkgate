# The full check installs its own probe tools *through* the proxy, then trusts the CA so
# the https probes can complete. The CA is mounted in, since nothing is baked here.
FULL_SETUP = ("export DEBIAN_FRONTEND=noninteractive && "
              "apt-get update && "
              "apt-get install -y --no-install-recommends"
              " curl ca-certificates dnsutils iputils-ping iproute2 && "
              "cp /mnt/ca/egress-ca.pem /usr/local/share/ca-certificates/egress.crt && "
              "update-ca-certificates && ")


# verify_guest.sh scores eleven numbered checks and reports which of them ran. Checks 3 and 7
# are the containment core and 9-11 lean on the same tool-free built-ins, so a bare guest must
# run all five; the rest need tools only `--full` installs. A check that did not run proves
# nothing, so the set that ran is asserted rather than a count of passes — nine SKIPs and two
# PASSes is not containment.
_VERIFY_CHECKS = frozenset(range(1, 12))
_VERIFY_TOOL_FREE = frozenset({3, 7, 9, 10, 11})


def _ids(ids):
    return ", ".join(str(i) for i in sorted(ids))


def _parse_checks(line):
    """`CHECKS: ran=3,7 skipped=1,2` -> ({3, 7}, {1, 2})."""
    fields = dict(re.findall(r"(ran|skipped)=([\d,]*)", line))

    def ids(key):
        return {int(i) for i in fields.get(key, "").split(",") if i}

    return ids("ran"), ids("skipped")


def _verify_shortfall(passed, failed, ran, skipped, *, full):
    """Why a verify run does not prove containment, or None if it does."""
    if failed:
        return f"containment check FAILED ({passed} passed, {failed} failed)"
    missing = (_VERIFY_CHECKS if full else _VERIFY_TOOL_FREE) - ran
    if missing:
        return (f"containment unproven — check(s) {_ids(missing)} never ran"
                + (f" (skipped: {_ids(skipped)})" if skipped else "")
                + ("; --full installs the tools 1-8 need, and 9-11 skip only when an "
                   "in-guest control failed" if full
                   else "; those need no installed tool, so something else is wrong"))
    if passed != len(ran):
        return f"verify output disagrees with itself: {passed} passed of {len(ran)} that ran"
    return None


def cmd_verify(args):
    preflight("msb", "mitmdump")
    rules_text = compose_rules(resolve_profiles(["probe"], allow_verify_only=True))
    load_ruleset(rules_text)
    script = "bash /mnt/poc/test/verify_guest.sh"
    mounts = [f"{REPO}:/mnt/poc:ro"]
    if args.full:
        mounts.append(f"{ensure_ca().parent}:/mnt/ca:ro")
        script = FULL_SETUP + script
    proxy, log_path = start_proxy(rules_text, args.port)
    say(f"proxy :{args.port} · audit: tail -f {log_path}")
    argv = msb_argv("debian", ["bash", "-c", script], args.port,
                    pull_never=False, mounts=mounts)
    result = checks = guest = None
    try:
        guest = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        for line in guest.stdout:
            print(line, end="")
            m = re.search(r"RESULT: (\d+) passed, (\d+) failed", line)
            if m:
                result = (int(m[1]), int(m[2]))
            if "CHECKS: ran=" in line:
                checks = _parse_checks(line)
        wait_foreground(guest)
    finally:
        if guest is not None:
            stop(guest)
        stop(proxy)
    if result is None:
        die("no RESULT line — the guest never ran verify_guest.sh (msb server started?)")
    if checks is None:
        die("no CHECKS line — the guest did not report which checks ran, so nothing is proven")
    passed, failed = result
    ran, skipped = checks
    bad = _verify_shortfall(passed, failed, ran, skipped, full=args.full)
    if bad:
        die(bad)
    say(f"containment holds ({passed} passed, 0 failed; checks {_ids(ran)} ran)")


# --- entry point ---------------------------------------------------------------
# The two argument types that reach a generated Dockerfile or an msb argv are checked by
# argparse itself, so a rejection names the flag it came from: `--with node@22.11.0` is
# exactly the token a reviewer's eye slides over on a command line composed for approval.

def _with_arg(spec):
    """argparse type for --with: `name[@version]`. The name is resolved later, against the
    profiles that exist; only the version is a charset question, and it is asked here."""
    _, sep, version = spec.partition("@")
    if sep and not version:
        raise argparse.ArgumentTypeError(
            f"{spec!r} pins an empty version — drop the '@' or name a version (an unset shell "
            "variable expands to this, and would quietly install the default instead)")
    bad = _version_error(version) if version else None
    if bad:
        raise argparse.ArgumentTypeError(bad)
    return spec


def _image_arg(ref):
    """argparse type for --base and --image."""
    bad = _image_error(ref)
    if bad:
        raise argparse.ArgumentTypeError(bad)
    return ref


class _MarkedParser(argparse.ArgumentParser):
    """argparse whose stderr lines carry silkgate's voice mark.

    say()/die() open every line silkgate speaks as itself with the byte relayed guest
    output cannot carry (see say); argparse's `usage:` and `error:` lines go to stderr
    too, so they are host voice and get the same mark. Scripts read the exit status (2
    for a usage error) and the message text, so both stay exactly argparse's own — the
    mark opens each stderr line and terminals draw nothing for it. error() and exit()
    are argparse's documented override points, and add_subparsers() instantiates the
    calling class, so every subcommand's parser marks its errors the same way. Help goes
    to stdout, the stream that carries no claim of being silkgate's, and stays bare.
    """

    def exit(self, status=0, message=None):
        # argparse passes a message here only on the error path; help and version print
        # to stdout elsewhere and call this bare.
        if message:
            mark = _ERR_TAG.decode()
            sys.stderr.write("".join(mark + ln for ln in message.splitlines(keepends=True)))
            sys.stderr.flush()
        sys.exit(status)

    def error(self, message):
        # Exactly what stock error() prints — usage, then "prog: error: message" — folded
        # into one exit() message so every line passes through the marking above.
        self.exit(2, f"{self.format_usage()}{self.prog}: error: {message}\n")


def main():
    ap = _MarkedParser(prog="silkgate", description=__doc__,
                       formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="command", required=True)

    def profile_opts(p, *, rules_only=False):
        p.add_argument("-w", "--with", dest="with_", action="append", metavar="PROFILE[@VER]",
                       type=_with_arg,
                       help="a profile from profiles/ — what to install and what it may reach "
                            "(repeatable; `silkgate profiles` lists them)")
        if not rules_only:
            p.add_argument("--base", default=BASE_IMAGE, type=_image_arg,
                           help=f"image the profiles layer onto (default: {BASE_IMAGE})")
        p.add_argument("--rule", action="append", metavar="RULE",
                       help="one extra rule in DSL syntax, e.g. 'example.com/** GET' (repeatable)")

    p = sub.add_parser("profiles", help="list the available profiles")
    p.set_defaults(fn=cmd_profiles)

    p = sub.add_parser("doctor", help="report every missing tool (docker, msb, mitmdump) "
                                      "and its install command")
    p.set_defaults(fn=cmd_doctor)

    p = sub.add_parser("build", help="build the image a profile list describes, into msb")
    profile_opts(p)
    p.add_argument("--platform", metavar="P", help="docker platform (default: matches the host arch)")
    p.set_defaults(fn=cmd_build)

    p = sub.add_parser("proxy", help="run one ruleset on one port, in the foreground")
    profile_opts(p, rules_only=True)
    p.add_argument("--port", type=int, default=8090, help="proxy listen port (default: 8090)")
    p.set_defaults(fn=cmd_proxy)

    p = sub.add_parser("verify", help="Tier-1 containment check in a bare debian guest")
    p.add_argument("--full", action="store_true",
                   help="also exercise the proxy path (apt through the proxy + CA trust)")
    p.add_argument("--port", type=int, default=8090, help="proxy listen port (default: 8090)")
    p.set_defaults(fn=cmd_verify)

    def env_opt(p):
        p.add_argument("-e", "--env", action="append", default=[], metavar="NAME=VALUE",
                       help="set an env var in the guest (repeatable; secrets belong in "
                            "EGRESS_SECRET_* + inject_auth instead)")
        p.add_argument("--no-context", action="store_true",
                       help=f"don't describe the sandbox to the guest ({GUEST_CONTEXT} and "
                            "$SILKGATE_CONTEXT)")

    p = sub.add_parser("run", help="run an egress-locked guest behind the proxy")
    profile_opts(p)
    p.add_argument("--port", type=int, default=DEFAULT_BASE_PORT,
                   help="shared-proxy base port when this command starts it (default: 8090)")
    p.add_argument("--image", metavar="REF", type=_image_arg,
                   help="run this image instead of the one the profiles describe")
    p.add_argument("--workspace", metavar="DIR",
                   help="mount DIR at /workspace (rw). Not $HOME and not a directory "
                        "holding a .git directory — for a repo, mount a linked worktree")
    p.add_argument("--allow-git-dir", action="store_true",
                   help="mount --workspace even where it holds .git directories — their "
                        "hooks and config become guest-writable, which is host code "
                        "execution the next time a human runs git there")
    env_opt(p)
    p.add_argument("--tty", action=argparse.BooleanOptionalAction,
                   help="give the command a terminal, for a TUI (default: yes if stdin is a "
                        "TTY). --no-tty runs it non-interactively — output is still live, "
                        "with stdout and stderr kept apart")
    p.add_argument("cmd", nargs=argparse.REMAINDER, metavar="-- CMD ...",
                   help="guest command (default: whatever the profiles name)")
    p.set_defaults(fn=cmd_run)

    p = sub.add_parser("up", help="start a persistent session (background guest + shared proxy)")
    p.add_argument("--name", metavar="N", help="session name (default: random 6-char id)")
    p.add_argument("--workspace", metavar="DIR",
                   help="mount DIR at /workspace (rw). Not $HOME and not a directory "
                        "holding a .git directory — for a repo, mount a linked worktree")
    p.add_argument("--allow-git-dir", action="store_true",
                   help="mount --workspace even where it holds .git directories — their "
                        "hooks and config become guest-writable, which is host code "
                        "execution the next time a human runs git there")
    profile_opts(p)
    env_opt(p)
    p.add_argument("--image", metavar="REF", type=_image_arg,
                   help="run this image instead of the one the profiles describe")
    p.add_argument("--port", type=int, default=DEFAULT_BASE_PORT,
                   help="shared-proxy base port when this command starts it (default: 8090)")
    p.set_defaults(fn=cmd_up)

    p = sub.add_parser("exec", help="run a command in a session's guest")
    p.add_argument("name", metavar="NAME", help="session name")
    p.add_argument("-t", "--tty", action=argparse.BooleanOptionalAction,
                   help="give the command a terminal, for a TUI (default: yes if stdin is a "
                        "TTY). --no-tty runs it non-interactively — output is still live, "
                        "with stdout and stderr kept apart")
    env_opt(p)
    # nargs='*' (not REMAINDER): with a positional NAME first, REMAINDER would swallow
    # -t/-e that follow NAME. '*' lets them parse; use `--` to pass flags on to CMD.
    p.add_argument("cmd", nargs="*", metavar="-- CMD ...",
                   help="command to run in the guest (use -- before flag-bearing commands)")
    p.set_defaults(fn=cmd_exec)

    p = sub.add_parser("attach", help="attach a TTY to a session, running its default command")
    p.add_argument("name", metavar="NAME", help="session name")
    p.set_defaults(fn=cmd_attach)

    p = sub.add_parser("logs", help="tail a session's guest output (or --audit its proxy decisions)")
    p.add_argument("name", metavar="NAME", help="session name")
    p.add_argument("-f", "--follow", action="store_true",
                   help="keep printing new lines by polling (default: print once and exit)")
    p.add_argument("--tail", type=int, metavar="N", help="start from the last N lines")
    p.add_argument("--since", metavar="DUR",
                   help="start from lines newer than DUR (e.g. 30s, 5m); guest log only")
    p.add_argument("--audit", action="store_true",
                   help="this session's proxy allow/deny decisions instead of guest output")
    p.add_argument("--interval", type=float, default=1.0, metavar="SECS",
                   help="follow poll interval in seconds (default: 1.0)")
    p.set_defaults(fn=cmd_logs)

    p = sub.add_parser("down", help="stop + remove a session (and the proxy if it was the last)")
    p.add_argument("name", metavar="NAME", help="session name")
    p.set_defaults(fn=cmd_down)

    p = sub.add_parser("ls", help="list sessions and shared-proxy health")
    p.set_defaults(fn=cmd_ls)

    p = sub.add_parser("secret", help="manage host-held secrets in the shared proxy")
    ssub = p.add_subparsers(dest="secret_cmd", required=True)
    q = ssub.add_parser("set", help="push EGRESS_SECRET_<NAME> to the proxy, scoped to one "
                                    "session (value never on argv)")
    q.add_argument("name", metavar="NAME", help="secret name (reads EGRESS_SECRET_<NAME>)")
    q.add_argument("--session", required=True, metavar="SESSION",
                   help="session the secret belongs to — only its guest can spend it")
    q.set_defaults(fn=cmd_secret_set)
    q = ssub.add_parser("ls", help="list secret names held by the proxy (names only)")
    q.add_argument("--session", metavar="SESSION",
                   help="one session's names (default: every session, session-qualified)")
    q.set_defaults(fn=cmd_secret_ls)

    # SIGTERM must run the finally-blocks that stop mitmdump/msb, not kill us outright.
    signal.signal(signal.SIGTERM, lambda *a: sys.exit(143))
    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
