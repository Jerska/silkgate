                   help="run this image instead of the one the profiles describe")
    p.add_argument("--port", type=int, default=DEFAULT_BASE_PORT,
                   help="shared-proxy scan floor when this command starts it: the pool "
                        "lands on the first free 16-port range at or above this, not "
