def cmd_build(args):
    profiles = resolve_profiles(args.with_ or [])
    load_ruleset(compose_rules(profiles))            # bad rules fail before a long build
    preflight(*_build_tools())                       # every missing tool at once, pre-docker
    ref = build_image(profiles, base=args.base, platform_=args.platform)
    say(f"loaded {ref} into msb")
    print(ref)


def cmd_profiles(args):
    rows = [("PROFILE", "VERSION", "INSTALLS", "REACHES", "DESCRIPTION")]
    for d in sorted(p for p in PROFILE_DIR.iterdir() if p.is_dir()):
        prof = Profile(d.name)
        hosts = sorted({ln.split()[0].split("/")[0]
                        for ln in prof.rules.splitlines()
                        if ln.strip() and not ln.startswith("#")})
        installs = list(prof.packages) + (["setup.sh"] if prof.setup.strip() else [])
        desc = prof.conf.get("description", "")
        if prof.name in _VERIFY_ONLY:               # listed like the rest, usable unlike them
            desc = f"(silkgate verify only — refused with run/up/build/proxy) {desc}"
        rows.append((prof.name, prof.version or "-", " ".join(installs) or "-",
                     ", ".join(hosts) or "-", desc))
    _print_table(rows)


def cmd_doctor(args):
    """The whole toolchain's presence in one pass — the command to run (and to name in a
    brief) when a sandbox will not start. Presence means a PATH lookup, never a version
    call: whether containment actually holds is `silkgate verify`'s question."""
    rows = [("TOOL", "STATUS")]
    missing = []
    for binary, hint in _TOOL_HINTS.items():
        path = shutil.which(binary)
        rows.append((binary, path or f"missing — {hint}"))
        if path is None:
            missing.append(binary)
    _print_table(rows)
    sys.stdout.flush()                    # the verdict goes to stderr; table first, even piped
    if missing:
        die(f"missing {len(missing)} of {len(_TOOL_HINTS)} tools")
    say("toolchain complete")


def cmd_proxy(args):
    """One ruleset, one port, in the foreground — for guests silkgate doesn't manage.

    Binds PROXY_BINDS like the other two proxy entry points: loopback, both families,
    by default — each listener is an allowlist plus header-triggered credential
    injection, which no LAN peer was ever meant to reach. A guest on another machine
    needs a host interface it can route to; name it (and nothing wider) with
    SILKGATE_PROXY_BIND=<address> — see the note above PROXY_BINDS.
    """
    profiles = resolve_profiles(args.with_ or [])
    rules_text = compose_rules(profiles, args.rule or [])
    if not rules_text.strip():
        die("no rules — pass --with PROFILE and/or --rule 'host/path GET'")
    check_secrets(load_ruleset(rules_text))
    mitmdump = which("mitmdump", "pip install mitmproxy")
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    _prune_logs()
    stamp = f"{datetime.now():%Y%m%d-%H%M%S}"
    rules_file = LOG_DIR / f"standalone-{stamp}.rules"
    events_path = LOG_DIR / f"events-{stamp}.jsonl"
    rules_file.write_text(rules_text)
    env = dict(os.environ, SILKGATE_EGRESS_RULES=str(rules_file),
               SILKGATE_EGRESS_EVENTS_FILE=str(events_path))
    env.pop("SILKGATE_EGRESS_SESSIONS_DIR", None)
    # rawtcp=false: a CONNECT whose payload mitmproxy cannot read as TLS is refused
    # instead of becoming an opaque tunnel around the addon's per-request checks.
    argv = [mitmdump, "-s", str(ADDON), "--set", "rawtcp=false"] + _modes(args.port)
    proc = subprocess.Popen(argv, env=env)
    try:
        sys.exit(wait_foreground(proc))
    finally:
        stop(proc)


def _strip_cmd_sep(cmd):
    return cmd[1:] if cmd and cmd[0] == "--" else cmd


def cmd_run(args):
    """One-shot over a persistent session: up (ephemeral) -> exec -> down, all foreground."""
    check_env(args.env)
    _check_mount_flags(args)
    profiles, rules_text, ruleset = _session_policy(args)
    github_read = getattr(args, "github_read", None) or []
    github_write = getattr(args, "github_write", None) or []
    cmd = _strip_cmd_sep(args.cmd) or profile_command(profiles)
    if not cmd:
        die("nothing to run — pass a command after -- (or --with a profile that names one)")
    # The ask is well-formed; now the whole toolchain shortfall in one report, before any
    # host process. An explicit --image is run as-is, never built, so docker is not its
    # business.
    preflight(*(() if args.image else _build_tools()), "msb", "mitmdump",
              *(("git",) if args.branch or args.checkout is not None else ()))
    tty = args.tty if args.tty is not None else sys.stdin.isatty()
    if args.branch:
        spec = _branch_spec(args.branch, profiles, args.env, args.checkout or "HEAD")
    elif args.checkout is not None:
        spec = _checkout_spec(args.checkout, profiles, args.env)
    else:
        spec = None
    name = uuid4().hex[:6]
    vmounts = _mount_args(args.mount, allow_git_dir=args.allow_git_dir)
    mounts = [f"{host}:{guest}:{mode}" for host, guest, mode in vmounts]
    ws = None
    if args.branch:
        ws, extra = _branch_workspace(spec, name)
        mounts += extra
    elif spec:
        mounts += _checkout_workspace(spec)
    image = ensure_image(profiles, args.image, base=args.base)
    proxy_was_running = _proxy_running()        # --port is the base port iff WE start it
    rc, provisioned, branch_ready, proxy = 1, False, False, None
    create_env = list(args.env) + (list(_BRANCH_ENV) if args.branch else [])
    github_meta = {"github_read": github_read, "github_write": github_write} \
        if (github_read or github_write) else {}
    try:
        proxy = ensure_proxy(args.port)
        port = pick_port(proxy, name)
        ctx, ctx_paths = _context_for(args, profiles, ruleset, vmounts, persistent=False)
        meta_extra = {**_session_meta(profiles, cmd), **(spec or {}), **github_meta}
        if vmounts:
            meta_extra["mounts"] = [f"{h}:{g}:{m}" for h, g, m in vmounts]
        _provision_session(name, image, port, rules_text, ruleset, mounts, ws, create_env,
                           meta_extra, ctx, ctx_paths)
        provisioned = True
        fault = tier1_fault(sandbox_name(name), port)
        if fault:
            die(fault)                      # the finally below tears the session down
        if github_read or github_write:
            _setup_github_guest(sandbox_name(name))
        if args.branch:
            _setup_branch_guest(sandbox_name(name), args.branch, spec["base"], name)
            branch_ready = True
        elif spec:
            _setup_checkout_guest(sandbox_name(name), spec["base"], name)
        say(f"session {name} · proxy :{port} · audit: tail -f {proxy['log']}")
        rc = run_guest(lambda c: msb_exec_argv(sandbox_name(name), c, tty=tty, env=args.env),
                       cmd, tty=tty)
    finally:
        # One-shot means one-shot even interrupted: the unwind runs with the stop
        # signals deferred, so a second Ctrl-C cannot leave the session half-removed.
        with _deferred_interrupts():
            if provisioned:
                meta = read_meta(name) or {"name": name, "sandbox": sandbox_name(name)}
                # Harvest while the guest is still up — its gitdir dies with the VM. A
                # harvest that could not bank everything keeps the workspace and must not
                # let a green guest run mask it, hence the forced nonzero exit.
                keep = False
                if branch_ready:
                    keep = not _harvest_branch(meta)
                    if keep and rc == 0:
                        rc = 1
                _teardown_session(meta)
                if spec and not keep:
                    _reap_derived_workspace(meta)
            else:
                _release_port(name)     # a claim pick_port made, however far it got
                if spec and ws:
                    shutil.rmtree(ws, ignore_errors=True)   # empty: created before the try
            # Only tear down the proxy if this command started it and nothing else
            # needs it.
            if not proxy_was_running and not list_metas():
                stop_proxy(read_proxy() or proxy)
    sys.exit(rc)


def _session_policy(args):
    """Profiles -> (profiles, composed rules text, parsed ruleset), failing on bad rules.

    No profile and no --rule composes an empty ruleset, which is legal: it is the strictest
    policy silkgate can express — default-deny with nothing exempted — and the alternative
    of a rule written to match nothing would sit in shell history reading like an allowance.
    """
    profiles = resolve_profiles(args.with_ or [])
    reads = getattr(args, "github_read", None)
    reads = reads if isinstance(reads, list) else []
    writes = getattr(args, "github_write", None)
    writes = writes if isinstance(writes, list) else []
    if reads or writes:
        if not any(p.name == "git" for p in profiles):
            die("--github-read/--github-write need git in the guest — add --with git")
    github_extra = _github_rules(reads, writes)
    rules_text = compose_rules(profiles, list(args.rule or []) + github_extra)
    ruleset = load_ruleset(rules_text)
    if not ruleset.rules:
        say("empty allowlist — this guest can reach nothing; every request is denied")
    return profiles, rules_text, ruleset


def _session_meta(profiles, cmd):
    """What a session records about how it was asked for, so exec/attach/ls can use it."""
    return {"profiles": [p.spec for p in profiles], "command": cmd}


def _context_for(args, profiles, ruleset, mounts, *, persistent):
    """(context text, where to put it in the guest) — or (None, ()) with --no-context.

    Always at GUEST_CONTEXT, plus wherever a harness profile says its own tool looks for
    instructions (`context_path`), which is how this stays harness-agnostic.
    """
    if args.no_context:
        return None, ()
    paths = [GUEST_CONTEXT] + [p.conf["context_path"] for p in profiles
                               if p.conf.get("context_path")]
    return session_context(profiles, ruleset, mounts=mounts, persistent=persistent,
                           branch=args.branch, checkout=args.checkout,
                           github_read=getattr(args, "github_read", None) or (),
                           github_write=getattr(args, "github_write", None) or ()), paths


def cmd_up(args):
    check_env(args.env)
    _check_mount_flags(args)
    profiles, rules_text, ruleset = _session_policy(args)
    github_read = getattr(args, "github_read", None) or []
    github_write = getattr(args, "github_write", None) or []
    name = args.name or uuid4().hex[:6]
    _validate_name(name)
    if session_dir(name).exists():
        die(f"session {name!r} already exists")
    # The ask is well-formed; now the whole toolchain shortfall in one report, before any
    # host process. An explicit --image is run as-is, never built, so docker is not its
    # business.
    preflight(*(() if args.image else _build_tools()), "msb", "mitmdump",
              *(("git",) if args.branch or args.checkout is not None else ()))
    if args.branch:
        spec = _branch_spec(args.branch, profiles, args.env, args.checkout or "HEAD")
    elif args.checkout is not None:
        spec = _checkout_spec(args.checkout, profiles, args.env)
    else:
        spec = None
    vmounts = _mount_args(args.mount, allow_git_dir=args.allow_git_dir)
    mounts = [f"{host}:{guest}:{mode}" for host, guest, mode in vmounts]
    ws = None
    if args.branch:
        ws, extra = _branch_workspace(spec, name)
        mounts += extra
    elif spec:
        mounts += _checkout_workspace(spec)
    image = ensure_image(profiles, args.image, base=args.base)
    provisioned = False
    create_env = list(args.env) + (list(_BRANCH_ENV) if args.branch else [])
    github_meta = {"github_read": github_read, "github_write": github_write} \
        if (github_read or github_write) else {}
    try:
        proxy = ensure_proxy(args.port)
        port = pick_port(proxy, name)
        ctx, ctx_paths = _context_for(args, profiles, ruleset, vmounts, persistent=True)
        meta_extra = {**_session_meta(profiles, profile_command(profiles)), **(spec or {}),
                      **github_meta}
        if vmounts:
            meta_extra["mounts"] = [f"{h}:{g}:{m}" for h, g, m in vmounts]
        _provision_session(name, image, port, rules_text, ruleset, mounts, ws, create_env,
                           meta_extra, ctx, ctx_paths)
        provisioned = True
        fault = tier1_fault(sandbox_name(name), port)
        if fault:
            die(fault)
        if github_read or github_write:
            _setup_github_guest(sandbox_name(name))
        if args.branch:
            _setup_branch_guest(sandbox_name(name), args.branch, spec["base"], name)
        elif spec:
            _setup_checkout_guest(sandbox_name(name), spec["base"], name)
    except BaseException:
        # A session `up` never handed over is unwound whole, interrupt included:
        # nothing of the user's is in the guest yet — work accrues only once
        # exec/attach run, after `up` returns, and a derived workspace holds nothing
        # but the fresh checkout — while a session left behind would hide that the
        # command failed. The unwind defers the stop signals so a second Ctrl-C
        # cannot leave it half-removed.
        with _deferred_interrupts():
            if provisioned:
                _teardown_session(read_meta(name) or
                                  {"name": name, "sandbox": sandbox_name(name)})
            else:
                _release_port(name)     # a claim pick_port made, however far it got
            if spec and ws:
                shutil.rmtree(ws, ignore_errors=True)   # no commits can exist yet
            _maybe_stop_proxy()
        raise
    say(f"session {name} up · proxy :{port} · audit: tail -f {proxy['log']}")
    print(name)


def cmd_exec(args):
    meta = read_meta(args.name)
    if not meta:
        die(f"no such session: {args.name!r} (silkgate ls)")
    check_env(args.env)
    cmd = _strip_cmd_sep(args.cmd) or meta.get("command")
    if not cmd:
        die("nothing to run — usage: silkgate exec NAME [-t] [-e K=V]... -- CMD ...")
    tty = args.tty if args.tty is not None else sys.stdin.isatty()
    sys.exit(run_guest(lambda c: msb_exec_argv(meta["sandbox"], c, tty=tty, env=args.env),
                       cmd, tty=tty))


def cmd_attach(args):
    meta = read_meta(args.name)
    if not meta:
        die(f"no such session: {args.name!r} (silkgate ls)")
    cmd = meta.get("command")
    if not cmd:
        die(f"session {args.name!r} has no default command — use: silkgate exec {args.name} -t -- CMD")
    sys.exit(run_guest(lambda c: msb_exec_argv(meta["sandbox"], c, tty=True), cmd, tty=True))


def cmd_down(args):
    meta = read_meta(args.name)
    if not meta:
        die(f"no such session: {args.name!r} (silkgate ls)")
    # Teardown needs msb to stop/rm the guest; without this, its absence surfaces as
    # "msb rm failed — session kept", which reads as a broken sandbox, not a missing tool.
    preflight("msb", *(("git",) if meta.get("branch") else ()))
    # The removal holds the stop signals: a Ctrl-C partway through would leave the
    # session half-removed, the one state worse than up or gone.
    with _deferred_interrupts():
        # Harvest first: the guest's gitdir dies with the VM. A retried down harvests
        # again — new commits fast-forward the branch; nothing new is a quiet no-op.
        keep = bool(meta.get("branch")) and not _harvest_branch(meta)
        _teardown_session(meta)
        if meta.get("branch") and not keep:
            _reap_derived_workspace(meta)
        _maybe_stop_proxy()
    say(f"session {args.name} down")
    if keep:
        sys.exit(1)


def cmd_harvest(args):
    """Bundle the session's branch out of the live guest and fast-forward the host branch —
    the mid-session save point. No teardown, no workspace reaping."""
    meta = read_meta(args.name)
    if not meta:
        die(f"no such session: {args.name!r} (silkgate ls)")
    if not meta.get("branch"):
        die(f"session {args.name!r} has no --branch — nothing to harvest")
    preflight("msb", "git")
    sys.exit(0 if _harvest_branch(meta) else 1)


def _age(iso):
    try:
        t = datetime.fromisoformat(iso)
    except (TypeError, ValueError):
        return "?"
    secs = max(0, int((datetime.now(t.tzinfo) - t).total_seconds()))
    for size, unit in ((86400, "d"), (3600, "h"), (60, "m")):
        if secs >= size:
            return f"{secs // size}{unit}"
    return f"{secs}s"


def _msb_statuses():
    """sandbox name -> STATUS, parsed from `msb list` (NAME/IMAGE/STATUS columns)."""
    msb = shutil.which("msb")
    if not msb:
        return {}
    try:
        out = subprocess.run([msb, "list"], capture_output=True, text=True).stdout
    except OSError:
        return {}
    statuses = {}
    for line in out.splitlines()[1:]:            # skip the header row
        cols = line.split()
        if len(cols) >= 3:
            statuses[cols[0]] = cols[2]
    return statuses


def _print_table(rows):
    widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
    for r in rows:
        print("  ".join(c.ljust(widths[i]) for i, c in enumerate(r)).rstrip())


def cmd_ls(args):
    metas = list_metas()
    if not metas:
        print("no sessions")
    else:
        statuses = _msb_statuses()
        rows = [("NAME", "STATUS", "PORT", "MOUNTS", "AGE")]
        for m in metas:
            parts = []
            if m.get("branch"):
                parts.append(f"{m.get('workspace') or '-'} (branch {m['branch']})")
            elif m.get("checkout"):
                parts.append(f"(checkout {m['checkout']})")
            for entry in m.get("mounts") or []:
                path, _, mode = str(entry).rpartition(":")
                parts.append(f"{path} ({mode})")
            rows.append((m["name"], statuses.get(m["sandbox"], "?"),
                         str(m.get("port", "?")), ", ".join(parts) or "-",
                         _age(m.get("created"))))
        _print_table(rows)
    proxy = read_proxy()
    ident = _proxy_ident()               # identity via the control socket, never pid alone:
    if ident is None:                    # after an unclean exit proxy.json survives and its
        print("proxy: not running")      # pid may belong to a recycled, unrelated process
    elif proxy is None:
        print(f"proxy: pid {ident or 'unknown'} answers on {PROXY_SOCK} but {PROXY_JSON} "
              "is gone — kill that process and retry")
    else:
        pool = proxy["ports"]
        pid = ident or proxy.get("pid")  # 0 = answered, but the kernel could not name it
        print(f"proxy: pid {pid} alive · ports {pool[0]}-{pool[-1]} · {proxy['log']}")


# --- logs: per-session observability ----------------------------------------
# msb's exec is RPC-shaped — a parent sees nothing until the guest exits — but the
# sandbox's captured log IS live, and there is no `msb logs --follow`, so -f polls it.

def _emit(lines):
    """Print lines and flush now, so follow is live and a closed pipe surfaces promptly."""
    for ln in lines:
        print(ln)
    sys.stdout.flush()


def _run_msb_logs(sandbox, tail_n=None, since=None):
    """`msb logs` for one sandbox -> (lines, None) or (None, error). Non-zero/OSError => gone."""
    argv = [_msb(), "logs", sandbox]
    if tail_n is not None:
        argv += ["--tail", str(tail_n)]
    if since is not None:
        argv += ["--since", since]
    try:
        proc = subprocess.run(argv, capture_output=True, text=True)
    except OSError as e:
        return None, str(e)
    if proc.returncode:
        return None, (proc.stderr.strip() or f"msb logs exited {proc.returncode}")
    return proc.stdout.splitlines(), None


def _logs_guest(args, meta):
    sandbox = meta["sandbox"]
    if not args.follow:                              # one-shot: pass shaping straight to msb
        lines, err = _run_msb_logs(sandbox, args.tail, args.since)
        if err is not None:
            die(f"cannot read guest logs for {args.name!r}: {err}")
        _emit(lines)
        return
    # Follow: seed `printed` to the whole current log's length so history never reprints,
    # then each poll re-fetches from a FIXED start (the whole log, an append-only string)
    # and emits only the suffix past `printed`. --tail/--since shape the first view only:
    # --tail is a pure offset into `full`; --since needs msb's clock, so we ask msb how
    # many recent lines it counts and offset by that (fetching `full` first keeps it from
    # dropping/duplicating anything appended between the two calls).
    full, err = _run_msb_logs(sandbox)
    if err is not None:
        die(f"cannot read guest logs for {args.name!r}: {err}")
    start = 0
    if args.tail is not None:
        start = max(0, len(full) - args.tail)
    elif args.since is not None:
        win, werr = _run_msb_logs(sandbox, since=args.since)
        if werr is None:
            start = max(0, len(full) - len(win))
    _emit(full[start:])
    printed = len(full)
    while True:
        time.sleep(args.interval)
        if not session_dir(args.name).exists():      # someone ran `silkgate down`
            die(f"session {args.name!r} is gone — stopped following")
        lines, err = _run_msb_logs(sandbox)
        if err is not None:                          # sandbox removed / msb unhappy
            die(f"session {args.name!r}: {err} — stopped following")
        n = len(lines)
        if n < printed:                              # rotation/truncation: resync, don't replay
            say(f"guest log for {args.name!r} rotated — resyncing")
            printed = n
        elif n > printed:
            _emit(lines[printed:])
            printed = n


def _audit_match(line, name):
    """True iff `line` is a JSON audit record for session `name`.

    mitmdump stamps every log line with a "[HH:MM:SS.mmm] " prefix and emits its own
    connection chatter, so drop everything before the first brace and require a parse.
    """
    brace = line.find("{")
    if brace < 0:
        return False
    try:
        rec = json.loads(line[brace:])
    except ValueError:
        return False
    return isinstance(rec, dict) and rec.get("session") == name


def _read_from(path, offset):
    """Complete (newline-terminated) lines from byte `offset` -> (lines, new_offset), or
    (None, offset) if the file is unreadable. Advances only past whole lines, so a
    half-written trailing line is re-read on the next poll rather than split."""
    try:
        with open(path, "rb") as f:
            f.seek(offset)
            data = f.read()
    except OSError:
        return None, offset
    cut = data.rfind(b"\n")
    if cut == -1:
        return [], offset
    chunk = data[:cut + 1]
    return chunk.decode("utf-8", "replace").splitlines(), offset + len(chunk)


def _logs_audit(args):
    proxy = read_proxy()
    if not proxy or not proxy.get("log"):
        die("shared proxy not running — no audit log (silkgate ls)")
    if args.since is not None:
        say("--since applies to the guest log only — --audit starts from the whole "
            "file (--tail trims it)")
    name = args.name
    path = Path(proxy["log"])
    lines, offset = _read_from(path, 0)              # first view = the whole file's history
    if lines is None:
        die(f"cannot read audit log {path}")
    matched = [ln for ln in lines if _audit_match(ln, name)]
    if args.tail is not None:
        matched = matched[-args.tail:] if args.tail > 0 else []
    _emit(matched)
    if not args.follow:
        return
    while True:
        time.sleep(args.interval)
        if not session_dir(name).exists():
            die(f"session {name!r} is gone — stopped following")
        p = read_proxy()
        # Identity, not pid liveness: after an unclean exit proxy.json survives and its
        # pid may be recycled, so only a proxy answering on the control socket counts.
        if not (p and _proxy_running()):
            die("shared proxy is gone — stopped following")
        new_path = Path(p.get("log") or path)
        if new_path != path:                         # proxy restarted onto a fresh log file
            say("audit log replaced — resyncing")
            path, offset = new_path, 0
        try:
            size = path.stat().st_size
        except OSError:
            die(f"audit log {path} vanished — stopped following")
        if size < offset:                            # truncated/rotated in place
            say("audit log rotated — resyncing")
            offset = 0
        new_lines, offset = _read_from(path, offset) # byte offset: only the new tail is read
        if new_lines is None:
            die(f"audit log {path} vanished — stopped following")
        _emit([ln for ln in new_lines if _audit_match(ln, name)])


def cmd_logs(args):
    """Stream one session's guest output, or (--audit) its proxy allow/deny decisions.

    A supervising parent sees nothing until an exec exits (msb's exec is RPC-shaped),
    so -f polls the live captured log (there is no `msb logs --follow`). --audit reads
    the shared audit log and keeps only lines whose "session" field is this session."""
    _validate_name(args.name)
    meta = read_meta(args.name)
    if not meta:
        die(f"no such session: {args.name!r} (silkgate ls)")
    if args.tail is not None and args.tail < 0:
        die("--tail must be >= 0")
    if args.interval <= 0:
        die("--interval must be > 0")
    try:
        if args.audit:
            _logs_audit(args)
        else:
            _logs_guest(args, meta)
    except KeyboardInterrupt:
        # Ctrl-C out of follow: quiet, status 130. os._exit skips interpreter shutdown, which
        # would otherwise re-surface the pending SIGINT as a traceback on stderr.
        sys.stdout.flush()
        os._exit(130)
    except BrokenPipeError:                          # `silkgate logs -f x | head`: quiet exit
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)


def cmd_secret_set(args):
    """Secrets are scoped per session in the proxy, so a set names the one it is for."""
    name = args.name
    value = os.environ.get(f"SILKGATE_EGRESS_SECRET_{name.upper()}")
    if not value:
        die(f'missing secret: SILKGATE_EGRESS_SECRET_{name.upper()}="<header>: <value>"')
    if _parse_secret(value) is None:
        die(f'SILKGATE_EGRESS_SECRET_{name.upper()} is not a valid "<Header>: <value>" line — '
            "expected a printable-ASCII header name (not a routing header) and a non-empty value")
    if not read_meta(args.session):
        die(f"no such session: {args.session!r} (silkgate ls)")
    if not _proxy_running():
        die("shared proxy not running — start a session first (silkgate up)")
    _sock_call({"op": "set_secret", "name": name.lower(), "value": value,
                "session": args.session})
    say(f"secret {name.lower()} set for session {args.session}")   # value never printed


def cmd_secret_ls(args):
    if not _proxy_running():
        die("shared proxy not running — start a session first (silkgate up)")
    if args.session:
        if not read_meta(args.session):
            die(f"no such session: {args.session!r} (silkgate ls)")
        for n in sorted(_sock_call({"op": "list_secrets",
                                    "session": args.session}).get("names", [])):
            print(n)
        return
    by_session = _sock_call({"op": "list_secrets"}).get("sessions", {})
    for s in sorted(by_session):                 # names only, one per line, session-qualified
        for n in sorted(by_session[s]):
            print(f"{s}/{n}")


# --- ui: a local web view over the events files -------------------------------------
# `silkgate ui` serves ui/ and three JSON endpoints on 127.0.0.1 — the host's browser
# and nothing else: the trail has no auth, a guest's Tier-1 rules allow only its own
# proxy port, and the LAN never sees a loopback bind. The server holds no state about
# the trail itself: history is a filtered read of the retained events-*.jsonl files,
# the live view is a byte-offset tail of the one the proxy is writing, and the
# allow/response join happens client-side on `id` — which is what lets a dropped
# stream resume from a plain Last-Event-ID instead of a server-side session.

UI_DIR = REPO / "ui"
DEFAULT_UI_PORT = 8642       # clear of the proxy pool (8090..8105) and common dev ports
UI_EVENTS_LIMIT = 2000       # /api/events default page
UI_EVENTS_LIMIT_MAX = 20000
UI_STREAM_POLL = 0.5         # seconds between tail passes on /api/stream
UI_STREAM_HEARTBEAT = 15.0   # idle seconds before an SSE comment keeps the pipe alive

# Every asset the UI can serve, by exact request path. A map instead of a filesystem
# walk makes traversal structurally impossible: a path outside it resolves to nothing.
_UI_ROUTES = {
    "/": ("index.html", "text/html; charset=utf-8"),
    "/app.js": ("app.js", "text/javascript; charset=utf-8"),
    "/store.js": ("store.js", "text/javascript; charset=utf-8"),
    "/style.css": ("style.css", "text/css; charset=utf-8"),
}


def _events_files():
    """The retained events files, oldest first — the stamp in the name is the order."""
    return sorted(LOG_DIR.glob("events-*.jsonl"))


def _event_passes(rec, filters):
    """Whether one parsed record survives the /api/events filters.

    `session` compares exactly, with "null" selecting unattributed records (a deny on
    an unclaimed pool port carries session: null); `host` is a case-folded substring,
    mirroring the UI's filter box; `method` compares case-folded; `since`/`until` are
    offset-aware datetimes, and a record whose `ts` cannot be parsed — or is naive —
    fails a time filter rather than slipping past it."""
    since, until = filters.get("since"), filters.get("until")
    if since is not None or until is not None:
        try:
            ts = datetime.fromisoformat(rec.get("ts") or "")
        except (TypeError, ValueError):
            return False
        if ts.tzinfo is None:
            return False
        if since is not None and ts < since:
            return False
        if until is not None and ts > until:
            return False
    session = filters.get("session")
    if session is not None:
        if session == "null":
            if rec.get("session") is not None:
                return False
        elif rec.get("session") != session:
            return False
    decision = filters.get("decision")
    if decision is not None and rec.get("decision") != decision:
        return False
    method = filters.get("method")
    if method is not None and (rec.get("method") or "").upper() != method.upper():
        return False
    host = filters.get("host")
    if host is not None and host.lower() not in (rec.get("host") or "").lower():
        return False
    return True


def _events_history(filters, limit):
    """The newest `limit` records passing `filters`, oldest first, across every
    retained events file (filename order — the stamp is chronological, and records
    within a file are append-ordered). Unparsable lines are skipped: the live file's
    tail can be half-written mid-read, and history must not die on it."""
    kept = []
    for path in _events_files():
        try:
            lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
        except OSError:                          # pruned mid-scan: already gone
            continue
        for line in lines:
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            if isinstance(rec, dict) and _event_passes(rec, filters):
                kept.append(rec)
    return kept[-limit:]


class _EventsTailer:
    """Byte-offset tail of the live events file, one poll at a time.

    The handler owns the socket, the sleep and the serialization; this owns which file
    is live and how far into it the client has read, which is what makes the stream
    testable without a server. `poll` takes the current proxy.json each pass — the
    caller re-reads it, following _logs_audit — and answers ("reset"|"record",
    payload, cursor) tuples. A cursor is "<events-file name>:<offset past the line>",
    doubling as the SSE frame id, so a reconnecting client resumes mid-file.

    Resets: a proxy restart swaps the events path → adopt the new file from 0 (it just
    started, so replaying it is cheap and complete); in-place truncation → same file
    from 0; a start cursor naming anything but the live file → the live file's EOF,
    since the client refetches history on reset and history covers the gap. No proxy
    at all yields nothing — the caller keeps polling and heartbeating, so a `down`
    followed by an `up` flows into the same open stream."""

    def __init__(self, cursor=None):
        self._path = None                        # nothing live seen yet
        self._offset = 0
        self._start = cursor                     # consumed when a live file first appears

    @staticmethod
    def _parse_cursor(cursor):
        name, sep, off = (cursor or "").rpartition(":")
        if sep and off.isdigit():
            return name, int(off)
        return None, None

    def poll(self, proxy_meta):
        out = []
        events = (proxy_meta or {}).get("events")
        if not events:
            return out
        path = Path(events)
        if self._path is None:                   # first pass that sees a live file
            cursor, self._start = self._start, None
            self._path = path
            name, offset = self._parse_cursor(cursor)
            if name == path.name:
                self._offset = offset            # hand-over from /api/events, or a reconnect
            else:
                try:
                    self._offset = path.stat().st_size
                except OSError:
                    self._offset = 0
                if cursor is not None:           # a cursor was given, but for another file
                    out.append(("reset", None, f"{path.name}:{self._offset}"))
        if path != self._path:                   # proxy restarted onto a fresh file
            self._path, self._offset = path, 0
            out.append(("reset", None, f"{path.name}:0"))
        try:
            size = self._path.stat().st_size
        except OSError:
            size = None
        if size is not None and size < self._offset:     # truncated in place
            self._offset = 0
            out.append(("reset", None, f"{self._path.name}:0"))
        lines, new_offset = _read_from(self._path, self._offset)
        if lines is None:                        # unreadable this pass: try again later
            return out
        pos = self._offset
        for i, line in enumerate(lines):
            # json.dumps output is ASCII, so a line's length is its byte length; the
            # final line's cursor is pinned to _read_from's own offset regardless.
            pos = new_offset if i == len(lines) - 1 else pos + len(line.encode()) + 1
            try:
                rec = json.loads(line)
            except ValueError:                   # a torn write that still ended in \n
                continue
            if isinstance(rec, dict):
                out.append(("record", line, f"{self._path.name}:{pos}"))
        self._offset = new_offset
        return out


def _ui_server(port):
    """The bound, threaded HTTP server behind `silkgate ui`; the caller runs it.

    Threads, because one open SSE stream on a plain HTTPServer would block every other
    request; daemon threads, so main()'s os._exit(130) on Ctrl-C reaps the open
    streams. Loopback only, and every response carries nosniff + a self-only CSP: the
    UI must not be able to send the trail anywhere, even if a record smuggles markup.
    """
    # Local imports: only this command needs an HTTP server, and every `silkgate exec`
    # would otherwise pay for importing one.
    import urllib.parse
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"
        server_version = "silkgate-ui"
        sys_version = ""

        def log_message(self, *a):               # the events files are the record
            pass

        def _security(self):
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Content-Security-Policy", "default-src 'self'")

        def _reply(self, code, ctype, body):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self._security()
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(body)

        def _json(self, obj, code=200):
            self._reply(code, "application/json", json.dumps(obj).encode())

        def do_GET(self):
            url = urllib.parse.urlsplit(self.path)
            query = {k: v[-1] for k, v in urllib.parse.parse_qs(url.query).items()}
            try:
                if url.path == "/api/sessions":
                    self._sessions()
                elif url.path == "/api/events":
                    self._events(query)
                elif url.path == "/api/stream":
                    self._stream(query)
                else:
                    self._static(url.path)
            except (BrokenPipeError, ConnectionResetError):
                self.close_connection = True     # the tab closed; nobody to answer

        def _refuse(self):
            self.close_connection = True         # keep a HEAD from desyncing keep-alive
            self._json({"error": "method not allowed"}, 405)

        do_POST = do_PUT = do_PATCH = do_DELETE = do_HEAD = do_OPTIONS = _refuse

        def _static(self, path):
            route = _UI_ROUTES.get(path)
            if route is None:
                return self._json({"error": "not found"}, 404)
            name, ctype = route
            try:
                body = (UI_DIR / name).read_bytes()
            except OSError:
                return self._json({"error": f"{name} is missing from {UI_DIR}"}, 404)
            self._reply(200, ctype, body)

        def _sessions(self):
            meta = read_proxy() or {}
            ident = _proxy_ident()               # identity via the control socket, as ever:
            running = ident is not None          # a recycled pid must not read as "running"
            self._json({"sessions": list_metas(),
                        "proxy": {"running": running,
                                  "pid": (ident or meta.get("pid")) if running else None,
                                  "ports": meta.get("ports"),
                                  "started": meta.get("started"),
                                  "log": meta.get("log"),
                                  "events": meta.get("events")}})

        def _events(self, query):
            filters = {}
            for key in ("since", "until"):
                if key in query:
                    try:
                        t = datetime.fromisoformat(query[key])
                    except ValueError:
                        return self._json({"error": f"{key}: not an ISO-8601 timestamp"},
                                          400)
                    if t.tzinfo is None:         # records are offset-aware; comparing one
                        return self._json(       # to a naive time raises, so refuse early
                            {"error": f"{key}: needs a UTC offset "
                                      f"(e.g. {query[key]}+00:00)"}, 400)
                    filters[key] = t
            for key in ("session", "decision", "method", "host"):
                if key in query:
                    filters[key] = query[key]
            try:
                limit = int(query.get("limit", UI_EVENTS_LIMIT))
            except ValueError:
                return self._json({"error": "limit: not an integer"}, 400)
            if limit < 1:
                return self._json({"error": "limit: must be >= 1"}, 400)
            limit = min(limit, UI_EVENTS_LIMIT_MAX)
            # The live file's size is read BEFORE the history: a record appended between
            # the two shows up in both history and the stream — the client dedupes on
            # (id, decision) — where a size read after would show it in neither.
            cursor = None
            live = (read_proxy() or {}).get("events")
            if live:
                try:
                    cursor = f"{Path(live).name}:{Path(live).stat().st_size}"
                except OSError:
                    cursor = f"{Path(live).name}:0"
            self._json({"events": _events_history(filters, limit), "cursor": cursor})

        def _stream(self, query):
            tailer = _EventsTailer(self.headers.get("Last-Event-ID")
                                   or query.get("cursor"))
            self.close_connection = True         # no Content-Length: the stream is the body
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-cache")
            self._security()
            self.end_headers()
            self.wfile.write(b"retry: 2000\n\n")
            self.wfile.flush()                   # BufferedWriter: an unflushed SSE frame
            beat = time.monotonic()              # sits in the buffer, never on the wire
            while True:
                try:
                    for kind, payload, cursor in tailer.poll(read_proxy()):
                        if kind == "reset":
                            frame = f"id: {cursor}\nevent: reset\ndata: {{}}\n\n"
                        else:
                            frame = f"id: {cursor}\ndata: {payload}\n\n"
                        self.wfile.write(frame.encode())
                        self.wfile.flush()
                        beat = time.monotonic()
                    if time.monotonic() - beat >= UI_STREAM_HEARTBEAT:
                        self.wfile.write(b": alive\n\n")
                        self.wfile.flush()
                        beat = time.monotonic()
                except (BrokenPipeError, ConnectionResetError):
                    return                       # closed tab: this thread's work is done
                time.sleep(UI_STREAM_POLL)

    class Server(ThreadingHTTPServer):
        daemon_threads = True                    # Ctrl-C must not wait on an open stream

    return Server(("127.0.0.1", port), Handler)


def cmd_ui(args):
    """Serve the local audit UI: static assets from ui/ plus the sessions, history and
    live-stream endpoints. Needs no running proxy — history and session listings work
    on their own, and the stream heartbeats until a proxy appears."""
    if not (UI_DIR / "index.html").is_file():
        die(f"ui assets not found at {UI_DIR} — run from a complete checkout "
            "(the ui/ directory ships with the repo)")
    try:
        server = _ui_server(args.port)
    except OSError:
        die(f"cannot bind the ui at 127.0.0.1:{args.port} — "
            + _port_in_use_error(args.port))
    host, port = server.server_address[:2]
    say(f"silkgate ui at http://{host}:{port}/ — Ctrl-C stops it")
    server.serve_forever()


# The full check installs its own probe tools *through* the proxy, then trusts the CA so
# the https probes can complete. The CA is mounted in, since nothing is baked here.
# -q sets apt's quiet level explicitly rather than leaving it to apt's own tty detection,
# which asks about the *guest's* stdout, not ours: with a terminal there it draws a progress
# meter that repaints with \r and pads with spaces, and none of that survives being read line
# by line on this side. One -q drops the meter and keeps the Get:/Fetched lines, which are the
# part worth reading when a probe tool fails to install.
FULL_SETUP = ("export DEBIAN_FRONTEND=noninteractive && "
              "apt-get -q update && "
              "apt-get -q -o Dpkg::Use-Pty=0 install -y --no-install-recommends"
              " curl ca-certificates dnsutils iputils-ping iproute2 && "
              "cp /mnt/ca/egress-ca.pem /usr/local/share/ca-certificates/egress.crt && "
              "update-ca-certificates && ")


# verify_guest.sh scores numbered checks and reports which of them ran. A check that did not
# run proves nothing, so the set that ran is asserted rather than a count of passes — nine
# SKIPs and two PASSes is not containment.
#
# Which checks exist, and which of them a BARE guest must produce, are read off the script
# rather than restated here. Every check there opens with a declaration line naming what it
# needs installed:
#
#     # CHECK 7 tools:ip — root routes around the boundary
#     # CHECK 3 tools:none — direct TCP/443 to a raw IP
#
# and `tools:none` is what makes a check part of the bare run. Restating that set beside this
# comment is what shipped a documented `silkgate verify` that could not pass: 7 was listed
# tool-free while the script skipped it without `ip` — which `--full` installs precisely
# because the base image lacks it — and the unit tests pinned the same wrong set from a
# synthetic `ran` string, so nothing could notice. Deriving it means the two cannot disagree:
# adding a `have` gate to a tool-free check moves it out of the bare set in the same commit.
#
# A `subject:<capability>` field on the same line declares the one other thing a check may
# report: UNAVAILABLE, for a guest that observably lacks what the check would probe (a v6
# check on a platform with no v6 path has no subject, which is neither a pass nor a skip).
# The permission is derived here for the same reason the tool sets are: _verify_shortfall
# refuses an unavailable claim from any check whose declaration names no subject, so a
# verdict that means "nothing to test" can never creep in as an output string alone.
#
# If the script cannot be read at all, the sets come out empty and _verify_shortfall refuses
# the run rather than blessing whatever the guest reported. Nothing else in this CLI needs
# them, so an unrelated command still works.
_VERIFY_SCRIPT = REPO / "test" / "verify_guest.sh"
_CHECK_DECL = re.compile(r"^#\s*CHECK\s+(\d+)\s+tools:(\S+)(?:\s+subject:(\S+))?", re.M)


def _declared_checks(path=None):
    """(every check id, the ids needing no installed tool, {id: the subject a guest may
    lack}) as verify_guest.sh declares them."""
    try:
        text = (path or _VERIFY_SCRIPT).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return frozenset(), frozenset(), {}
    declared = _CHECK_DECL.findall(text)
    return (frozenset(int(n) for n, _, _ in declared),
            frozenset(int(n) for n, tools, _ in declared if tools == "none"),
            {int(n): subject for n, _, subject in declared if subject})


_VERIFY_CHECKS, _VERIFY_TOOL_FREE, _VERIFY_SUBJECTS = _declared_checks()


def _ids(ids):
    return ", ".join(str(i) for i in sorted(ids))


def _parse_checks(line):
    """`CHECKS: ran=3,7 skipped=1,2 unavailable=5` -> ({3, 7}, {1, 2}, {5}). A line from
    before the unavailable field parses with an empty third set."""
    fields = dict(re.findall(r"(ran|skipped|unavailable)=([\d,]*)", line))

    def ids(key):
        return {int(i) for i in fields.get(key, "").split(",") if i}

    return ids("ran"), ids("skipped"), ids("unavailable")


def _verify_shortfall(passed, failed, ran, skipped, unavailable=frozenset(), *, full):
    """Why a verify run does not prove containment, or None if it does."""
    if failed:
        return f"containment check FAILED ({passed} passed, {failed} failed)"
    expected = _VERIFY_CHECKS if full else _VERIFY_TOOL_FREE
    if not expected:
        return (f"cannot tell which checks should have run: no '# CHECK n tools:' declarations "
                f"in {_VERIFY_SCRIPT} — containment unproven")
    # "Nothing to test" is the easiest verdict to abuse — accepted wholesale, unavailable=1..15
    # from a guest that ran nothing would read as containment — so it is honoured only from
    # the checks whose declarations say their subject can be absent, and never for a check
    # that also claims to have run.
    undeclared = unavailable - _VERIFY_SUBJECTS.keys()
    if undeclared:
        return (f"check(s) {_ids(undeclared)} report their subject absent, but their CHECK "
                f"declarations name no subject: a guest may lack "
                f"(only {_ids(_VERIFY_SUBJECTS) or 'none of them'} do) — a check that could "
                "have run did not, so containment is unproven")
    contradicted = unavailable & ran
    if contradicted:
        return (f"verify output disagrees with itself: check(s) {_ids(contradicted)} both ran "
                "and reported nothing to test")
    missing = expected - ran - unavailable
    if missing:
        needs_tools = _ids(_VERIFY_CHECKS - _VERIFY_TOOL_FREE) or "none of them"
        return (f"containment unproven — check(s) {_ids(missing)} never ran"
                + (f" (skipped: {_ids(skipped)})" if skipped else "")
                + (f"; --full installs what {needs_tools} need, and the rest skip only when "
                   "an in-guest control failed" if full
                   else "; those declare tools:none, so something other than a missing tool "
                        "is wrong"))
    if passed != len(ran):
        return f"verify output disagrees with itself: {passed} passed of {len(ran)} that ran"
    return None


# --- verify: evidence outside the guest ---------------------------------------------------
# Everything above renders verify's verdict from two lines the GUEST printed, and checks 1/2
# prove only that *a* proxy answered on that port: a guest running arbitrary code can print
# both lines, and a guest that reached some other listener passes them honestly. What follows
# is the host's own record of the same run — the audit log this run's proxy wrote, a listener
# that either receives a packet or does not, and an HTTP endpoint that records the header that
# actually arrived. None of the three can be produced from inside the guest.
#
# Each oracle reports problems as (kind, text): "observed" means the host saw something that
# must not happen (a packet arrived, a credential was added, a refused method got through) and
# "unproven" means the evidence that should corroborate the guest's verdict is missing. The two
# read differently on purpose — a failed check is a boundary result, while a silent audit log
# is a broken oracle, and pointing a reader at the boundary for the second wastes the trip.

_VERIFY_IMAGE = "debian"                  # the guest verify boots; bare, so probes stay honest

# The credential the recording endpoint must see arrive. Deliberately the string
# test/test_addon.py already uses, for the same reason: what proves the injection path must
# never be a real key, and one grep finds both the unit test and this live fixture.
_VERIFY_SENTINEL = "SENTINEL-NOT-A-REAL-KEY"
_VERIFY_SECRET_NAME = "verify_sentinel"   # -> SILKGATE_EGRESS_SECRET_VERIFY_SENTINEL, set for this run
_VERIFY_AUTH_HEADER = "x-api-key"         # the header the guest sends and the secret replaces

# The recorder's rule host must be a NAME: normalize_host rejects IP literals by design, in
# both the pattern and the request. `localhost` is the one name every host resolves to
# loopback without a hosts-file edit, and only the *proxy* resolves it — it runs on the host,
# and the guest names the same authority in an absolute-form request line it never resolves.
_RECORDER_HOST = "localhost"
_RECORDER_PATH = "/verify/record"

# The two hosts the guest's proxy-path checks reach, named here so a missing audit record can
# say which guest line it was supposed to corroborate. The first is the probe profile's own
# allowance (profiles/probe/rules.txt) and check 1's target; the second is check 2's. They live
# in test/verify_guest.sh, which this file does not own — a run whose script changed them fails
# the audit assertion naming the host it expected, which is a one-line fix here.
_VERIFY_ALLOWED_HOST = "registry.npmjs.org"
_VERIFY_UNLISTED_HOST = "evil.com"
# What control 0 asks the proxy for: a host no ruleset allows, so it is refused from the proxy's
# own memory. The record it produces is the only host-side evidence a *bare* run leaves.
_VERIFY_CONTROL_HOST = "silkgate.invalid"

# Verify guests are named so an interrupted run can be cleaned up afterwards: `msb run` left
# the sandbox registered when its client died, and two were found alive from earlier runs. The
# pid in the name is what makes a leftover identifiable as one — a name whose pid is gone had
# no owner left to remove it. The prefix cannot collide with a session's sandbox, which
# sandbox_name() always prefixes `sg-`.
_VERIFY_GUEST_RE = re.compile(r"silkgate-verify-(\d+)-(?:main|leaky)\Z")


def _verify_guest_name(kind):
    return f"silkgate-verify-{os.getpid()}-{kind}"


def _verify_msb_argv(sandbox, port, *, mounts=()):
    """`msb create` argv for a named verify guest whose only egress is one proxy port.

    Named, and therefore removable — which is why this is a `create` + `exec` + `rm` guest
    rather than the one-shot `msb run` verify used to take: `stop()` on an `msb run` kills the
    client and leaves the sandbox it created running, holding a Tier-1 rule and a port
    allowance that collides with the next run's proxy. The flag shape is msb_argv's, so the
    policy under test is the one every session gets, and this is the only place that emits it —
    the negative control derives its own from this one, through _leaky_argv.
    """
    argv = [_msb(), "create", _VERIFY_IMAGE, "--name", sandbox]
    for m in mounts:
        argv += ["-v", m]
    url = f"http://{PROXY_ALIAS}:{port}"
    for var in PROXY_ENV_VARS:
        argv += ["-e", f"{var}={url}"]
    argv += ["--net-default-egress", "deny", "--net-rule", f"allow@host:tcp:{port}"]
    return argv


def _leaky_argv(argv):
    """The same guest with msb's egress default flipped to allow — a guest that really leaks.

    FEEDBACK records that *dropping* --net-default-egress deny does NOT open egress (msb
    denies by default once any --net-rule is present) while `allow` does, and that the
    always-on Tier-1 probe was verified against exactly that. So the flip is the whole
    mechanism, and a refactor that renamed the flag must fail here rather than quietly
    produce a contained guest whose silence would read as "the checks cannot fail".
    """
    out = list(argv)
    try:
        i = out.index("--net-default-egress")
    except ValueError:
        die("cannot build the negative control: the verify guest's argv carries no "
            "--net-default-egress to flip, so nothing here would open egress — the guest "
            "would be contained and its passing checks would prove nothing")
    if out[i + 1] != "deny":
        die(f"cannot build the negative control: --net-default-egress is {out[i + 1]!r}, "
            "not 'deny' — refusing to guess what would open egress")
    out[i + 1] = "allow"
    return out


def _create_verify_guest(sandbox, port, *, mounts=(), leaky=False, why=""):
    """Create (and boot) one named verify guest, or die. msb's own output is inherited rather
    than captured, as in _provision_session: the first run pulls the image, and a silent minute
    reads as a hang. `leaky` is the negative control's guest — the same guest, egress open."""
    argv = _verify_msb_argv(sandbox, port, mounts=mounts)
    if subprocess.run(_leaky_argv(argv) if leaky else argv).returncode:
        _remove_sandbox(sandbox)              # a failed create can still register the name
        die(f"msb create failed for verify guest {sandbox} (see msb's output above){why}")


def _drop_verify_guest(sandbox, guests):
    """Remove one verify guest now, keeping it in `guests` if it is not verifiably gone.

    _remove_sandbox is the sessions' treatment — stop, then rm, forgiving a failed rm only
    when `msb list` no longer shows the name — and a guest that survives it is not a tidiness
    problem: it holds a Tier-1 rule and a port allowance the next verify collides with.
    """
    if _remove_sandbox(sandbox):
        guests.discard(sandbox)
        return True
    return False


def _reap_leaked_verify_guests():
    """Remove verify guests earlier runs left behind, naming each.

    Only guests whose pid is gone: a name whose owner still runs belongs to a concurrent
    verify (proxy_alive is a bare pid-liveness test despite its name — a recycled pid
    therefore keeps a leftover, which errs toward leaving another process's guest alone).
    """
    msb = shutil.which("msb")
    if not msb:
        return
    listed = subprocess.run([msb, "list"], capture_output=True, text=True)
    if listed.returncode:
        return
    for line in listed.stdout.splitlines()[1:]:
        name = (line.split() or [""])[0]
        match = _VERIFY_GUEST_RE.fullmatch(name)
        if not match or int(match[1]) == os.getpid() or proxy_alive(int(match[1])):
            continue
        say(f"removing {name}: an interrupted verify left it behind (pid {match[1]} is gone), "
            "and it still holds a Tier-1 rule and a port allowance")
        if not _remove_sandbox(name):
            say(f"could not remove {name} — `msb stop {name} && msb rm {name}` by hand")


def _oracle_port(proxy_port, offset):
    """A host port `offset` above the proxy's, folded below it at the top of the range — the
    same fold check 10 does for the neighbouring port it probes."""
    port = proxy_port + offset
    return port if port <= 65535 else proxy_port - offset


def _port_holder(port):
    """Who holds `port`, for an error message: lsof's answer where lsof is installed, else the
    command that would say. Same remedy shape as _port_in_use_error, which covers the proxy's
    own ports; these are the oracles'."""
    ask = f"lsof -nP -i:{port} names the holder"
    lsof = shutil.which("lsof")
    if not lsof:
        return ask
    try:
        out = subprocess.run([lsof, "-nP", f"-i:{port}"], capture_output=True, text=True,
                             timeout=5).stdout.splitlines()
    except (OSError, subprocess.SubprocessError):
        return ask
    rows = [ln.split() for ln in out[1:] if ln.strip()]
    named = "; ".join(f"{r[0]} (pid {r[1]})" for r in rows[:3] if len(r) >= 2)
    return f"held by {named}" if named else ask


def _oracle_bind(port, socktype, what):
    """Bind `port` on every address the proxy listens on, or die naming the holder.

    The same addresses (PROXY_BINDS), because that is where guest->host traffic lands:
    microsandbox delivers it over loopback, and the guest's /etc/hosts hands out the v6 alias
    address first — an oracle bound to one family could be silent because the guest chose the
    other one, which is the failure mode that looks exactly like containment.
    """
    socks = []
    for addr in PROXY_BINDS or ("127.0.0.1",):
        sock = socket.socket(socket.AF_INET6 if ":" in addr else socket.AF_INET, socktype)
        try:
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            sock.bind((addr, port))
            if socktype == socket.SOCK_STREAM:
                sock.listen(16)
        except OSError as e:
            sock.close()
            for other in socks:
                other.close()
            die(f"cannot bind the {what} at {addr}:{port} ({e.strerror}) — {_port_holder(port)}")
        socks.append(sock)
    return socks


class _ArrivalObserver:
    """A host listener — TCP and UDP — on a port the guest's Tier-1 rule does not allow.

    Nothing else in silkgate ever sees a packet reach the host: every containment verdict is
    the guest reporting that it heard nothing, and for UDP the guest cannot even do that (a
    sendto to a denied destination succeeds and no ICMP comes back). This is the other end of
    the wire. The port stays out of the allow rule, so the policy shape is a real session's —
    an arrival here is the rule being wider than `tcp:<proxy port>`, not an artefact of asking.

    Nothing is read while the guest runs: a pending connection waits in the accept backlog and
    a datagram in the socket buffer until drain() takes them, so the evidence needs neither a
    thread nor good timing. Silence is allowed to mean something only after self_test() has
    shown these very sockets receiving their own token, on every address and both protocols.
    """

    def __init__(self, port):
        self.port = port
        self.arrivals = []
        self.self_token = "self-" + uuid4().hex
        self.guest_token = "guest-" + uuid4().hex
        self._socks = []
        try:
            self._socks = [("tcp", s) for s in
                           _oracle_bind(port, socket.SOCK_STREAM, "arrival observer (tcp)")]
            self._socks += [("udp", s) for s in
                            _oracle_bind(port, socket.SOCK_DGRAM, "arrival observer (udp)")]
        except BaseException:                  # incl. SystemExit from die(): keep no half-bind
            self.close()
            raise
        for _, sock in self._socks:
            sock.setblocking(False)
        # Recorded at construction, not read off the sockets on demand: what has to be proven
        # is what this observer *bound*, and a closed observer whose bound() answered "nothing"
        # would make the self-proof below vacuous — silence passing for the reason it must not.
        self._bound = [(proto, sock.getsockname()[0]) for proto, sock in self._socks]

    def bound(self):
        """The (proto, address) pairs this observer listened on, closed or not."""
        return list(self._bound)

    def self_test(self):
        """Send this observer's own token to every address it bound, both protocols. What
        comes back is what the caller may treat as functional; anything else makes this
        observer's later silence meaningless, and the run says so instead of concluding."""
        for proto, sock in self._socks:
            addr = sock.getsockname()[0]
            family = sock.family
            try:
                if proto == "tcp":
                    with socket.socket(family, socket.SOCK_STREAM) as probe:
                        probe.settimeout(2)
                        probe.connect((addr, self.port))
                        probe.sendall(self.self_token.encode())
                else:
                    with socket.socket(family, socket.SOCK_DGRAM) as probe:
                        probe.settimeout(2)
                        probe.sendto(self.self_token.encode(), (addr, self.port))
            except OSError:
                continue                       # the missing arrival is the report
        self.drain()

    def drain(self, settle=0.3):
        """Take everything the kernel has queued on these sockets into self.arrivals."""
        time.sleep(settle)                     # a loopback or VMM delivery lands in µs
        for proto, sock in self._socks:
            addr = sock.getsockname()[0]
            while True:
                try:
                    if proto == "tcp":
                        conn, peer = sock.accept()
                        with conn:
                            conn.settimeout(0.3)
                            try:
                                data = conn.recv(4096)
                            except OSError:    # connected and sent nothing: still an arrival
                                data = b""
                    else:
                        data, peer = sock.recvfrom(4096)
                except OSError:                # BlockingIOError included: nothing more queued
                    break
                self.arrivals.append({
                    "proto": proto, "addr": addr,
                    "peer": f"{peer[0]}:{peer[1]}" if isinstance(peer, tuple) else str(peer),
                    "data": data.decode("ascii", "replace")[:200],
                })

    def close(self):
        for _, sock in self._socks:
            try:
                sock.close()
            except OSError:
                pass
        self._socks = []


def _observer_problems(arrivals, *, bound, self_token, guest_token, port, proxy_port):
    """(problems, summary) for what did and did not reach the observer."""
    proved = {(a["proto"], a["addr"]) for a in arrivals if self_token in a["data"]}
    missing = [pair for pair in bound if pair not in proved]
    problems = []
    if missing:
        problems.append(("unproven",
                         "the arrival observer never received its own loopback send on "
                         + ", ".join(f"{proto} {addr}:{port}" for proto, addr in missing)
                         + " — a listener that cannot hear itself proves nothing by staying "
                         "silent, so this run observed nothing either way"))
    for a in arrivals:
        if guest_token in a["data"]:
            problems.append(("observed",
                             f"a {a['proto']} packet from the verify guest REACHED the host at "
                             f"{a['addr']}:{port} (peer {a['peer']}), carrying this run's "
                             f"token — the Tier-1 rule is wider than tcp:{proxy_port}, which "
                             "no probe inside the guest can see"))
        elif self_token not in a["data"]:
            problems.append(("observed",
                             f"a {a['proto']} arrival at {a['addr']}:{port} from {a['peer']} "
                             f"carried neither token ({a['data'][:60]!r}) — something reached a "
                             "host port this run denies, and it is not this fixture"))
    return problems, (f"observer: {len(proved)}/{len(bound)} self-sends heard, "
                      f"nothing from the guest at :{port}" if not problems
                      else f"observer: {len(problems)} problem(s) at :{port}")


def _recorder_rules(port):
    """The one verify-only rule that puts the recording endpoint in the guest's reach.

    Deliberately narrow, and deliberately in no shipped profile: it is the "host loopback
    service in reach" hazard, scoped to one port, one path prefix and one method, composed here
    and nowhere else. POST only, so the same fixture settles method enforcement; no `q:` and no
    `h:`, so query and header stripping stay live; no max_body, so the default (no body) holds.
    """
    return (f"# --- verify only: the host-side Tier-2 recorder, port {port} ---\n"
            f"{_RECORDER_HOST}:{port}{_RECORDER_PATH}/** POST "
            f"inject_auth={_VERIFY_SECRET_NAME}\n")


class _HeaderRecorder:
    """A host-loopback HTTP endpoint that RECORDS what arrived and reflects nothing.

    This is what makes "full code execution in the guest cannot steal the API key" testable
    against the real proxy instead of a stub: the guest sends a request carrying a dummy
    credential, the host holds a sentinel, and the header the endpoint receives says which one
    went upstream. Recording rather than reflecting is what keeps that sound — the answer is
    204 and nothing else, so the assertion happens here and the guest learns nothing. That is
    also why this is not the reflector the docs warn against: the warning protects a real
    credential from a destination nobody controls, and this destination is a socket on the
    host, allowlisted for one port and one path, for one run.
    """

    def __init__(self, port):
        # Local imports: only this fixture needs an HTTP server, and every `silkgate exec`
        # would otherwise pay for importing one.
        import threading
        from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

        self.port = port
        self.records = []
        records = self.records

        class Handler(BaseHTTPRequestHandler):
            protocol_version = "HTTP/1.1"
            server_version = "silkgate-verify-recorder"
            sys_version = ""

            def _record(self):
                length = int(self.headers.get("content-length") or 0)
                body = self.rfile.read(length) if length else b""
                records.append({"method": self.command, "target": self.path,
                                "headers": [(k.lower(), v) for k, v in self.headers.items()],
                                "body_len": len(body)})
                self.send_response(204)        # nothing useful: not the guest's oracle
                self.send_header("Content-Length", "0")
                self.end_headers()

            do_GET = do_POST = do_PUT = do_PATCH = do_DELETE = do_HEAD = _record
            do_OPTIONS = _record

            def log_message(self, *a):         # the audit log is the record; this is noise
                pass

        class V4Server(ThreadingHTTPServer):
            daemon_threads = True              # on subclasses of our own, never on the stdlib's

        class V6Server(V4Server):
            address_family = socket.AF_INET6

        self._servers = []
        for addr in PROXY_BINDS or ("127.0.0.1",):
            cls = V6Server if ":" in addr else V4Server
            try:
                server = cls((addr, port), Handler)
            except OSError as e:
                self.close()
                die(f"cannot bind the Tier-2 recorder at {addr}:{port} ({e.strerror}) — "
                    f"{_port_holder(port)}")
            self._servers.append(server)
            threading.Thread(target=server.serve_forever, daemon=True).start()

    def rules(self):
        return _recorder_rules(self.port)

    def close(self):
        for server in getattr(self, "_servers", []):
            try:
                server.shutdown()
                server.server_close()
            except Exception:                  # already down; the records are the point
                pass
        self._servers = []


def _clip_oracle(text, limit=200):
    """Guest-supplied text in a host-side message, bounded — a header the guest chose must not
    be able to bury the finding it is evidence for."""
    return text if len(text) <= limit else text[:limit] + "..."


def _recorder_problems(records, *, token, port):
    """(problems, summary) for what the recording endpoint received.

    Two sentinels moving in opposite directions decide it. The guest's token must appear in
    nothing that arrived — it is in the query, in the dummy credential and in an extra header,
    so one absent string covers query stripping, header hygiene and the value the guest tried
    to send. The host's sentinel must be the value of the auth header on the request that sent
    one, and must be absent from the request that did not.
    """
    by_path = {}
    for rec in records:
        by_path.setdefault(rec["target"].partition("?")[0], []).append(rec)
    problems, seen = [], []
    for leaf, why in (("replace", "the request that carried a credential"),
                      ("add", "the request that carried none")):
        path = f"{_RECORDER_PATH}/{leaf}"
        got = by_path.pop(path, [])
        if not got:
            problems.append(("unproven",
                             f"nothing arrived at {_RECORDER_HOST}:{port}{path} — {why} never "
                             "reached the recorder, so Tier 2 is not proven end to end here "
                             "(the guest's own reply code and the audit log say which hop "
                             "dropped it)"))
            continue
        rec = got[-1]
        seen.append(leaf)
        auth = [v for name, v in rec["headers"] if name == _VERIFY_AUTH_HEADER]
        arrived = rec["target"] + " " + " ".join(f"{n}: {v}" for n, v in rec["headers"])
        if token in arrived:
            problems.append(("observed",
                             f"the guest's own token crossed the proxy to {path}: "
                             f"{_clip_oracle(arrived)} — a query param, a header or a header "
                             "value the ruleset does not allow was forwarded"))
        if rec["method"] != "POST":
            problems.append(("observed",
                             f"{rec['method']} reached {path}, and the rule allows POST only"))
        if leaf == "replace" and not auth:
            problems.append(("unproven",
                             f"no {_VERIFY_AUTH_HEADER} arrived at {path} at all, though the "
                             "guest sent one and the rule injects into it — the request got "
                             "through with the header dropped, which proves nothing either way"))
        elif leaf == "replace" and auth != [_VERIFY_SENTINEL]:
            problems.append(("observed",
                             f"{_VERIFY_AUTH_HEADER} arrived at {path} as {auth!r}, not the "
                             "host's sentinel exactly once — the injected value must REPLACE "
                             "the header the guest sent"))
        elif leaf == "add" and auth:
            problems.append(("observed",
                             f"{_VERIFY_AUTH_HEADER} arrived at {path} as {auth!r}, and that "
                             "request sent none — the proxy ADDED a credential to a request "
                             "that did not carry one, which is the guarantee every guest is "
                             "given"))
    for path, got in by_path.items():
        problems.append(("observed",
                         f"{got[-1]['method']} {path} reached the recorder, and no rule in this "
                         "run's ruleset allows it — the proxy forwarded a request it must have "
                         "refused"))
    return problems, (f"recorder: credential replaced, never added, on {len(seen)}/2 requests "
                      f"at :{port}; nothing else got through" if not problems
                      else f"recorder: {len(problems)} problem(s) at :{port}")


def _oracle_guest_script(*, proxy_port, observer_port, recorder_port, token):
    """The probes the guest runs for the host-side oracles: tool-free bash, one line each.

    Tool-free on purpose — /dev/tcp, /dev/udp and printf, nothing installed, no CA trust — so
    these run on the bare image the default `verify` uses and the recorder is exercised over
    plain absolute-form HTTP through the proxy, which is the path the addon's `request` hook
    decides. Every literal is baked in here, so the script quotes nothing dynamic.

    The observer probes go to a host port Tier 1 denies: a refusal is the guest's own evidence
    (the errno, which the script keeps rather than discarding), and the observer's silence is
    the host's. The three recorder requests carry the guest's token where the ruleset must
    strip it, a dummy credential where the host's sentinel must replace it, no credential
    where none may be added, and a method the rule forbids.
    """
    alias, req = PROXY_ALIAS, f"http://{_RECORDER_HOST}:{recorder_port}{_RECORDER_PATH}"
    host_hdr = f"Host: {_RECORDER_HOST}:{recorder_port}"

    def request(method, leaf, *headers):
        """One request as bash ANSI-C quoting will carry it: CRLF-terminated, body-less.

        `$'...'` and not a command substitution, because $() strips the trailing newlines —
        which here are the blank line that ends the request.
        """
        lines = [f"{method} {req}/{leaf} HTTP/1.1", host_hdr, *headers,
                 "Content-Length: 0", "Connection: close", "", ""]
        return "\\r\\n".join(lines)

    replace = request("POST", f"replace?leak={token}",
                      f"{_VERIFY_AUTH_HEADER}: DUMMY-{token}", f"x-exfil: {token}")
    return "\n".join([
        "set -u",
        f"probe(){{ if err=$(timeout 5 bash -c \"exec 3<>/dev/$1/{alias}/{observer_port} "
        f"&& printf %s {token} >&3\" 2>&1); then echo \"ORACLE observer-$1 sent\"; "
        "else echo \"ORACLE observer-$1 blocked $(printf %s \"$err\" | tr -d '\\r' | "
        "tail -n1 | cut -c1-90)\"; fi; }",
        "probe tcp",
        "probe udp",
        # One connection per request, and only the status line is read: the guest's view of the
        # fixture is a three-digit number, which is all a hostile guest could learn here. The
        # code is reported as 000 unless it really is three digits, so a connection that never
        # got a reply cannot be read on the host as a status the proxy sent.
        f"req(){{ label=$1; out=$(timeout 5 bash -c 'exec 3<>/dev/tcp/{alias}/{proxy_port} "
        "|| exit 9\n"
        'printf %s "$1" >&3\nIFS= read -r line <&3\nprintf %s "$line"\' _ "$2" 2>&1); rc=$?; '
        "out=$(printf %s \"$out\" | tr -d '\\r' | head -n1); set -- $out; code=${2:-000}; "
        "case $code in [0-9][0-9][0-9]) ;; *) code=000 ;; esac; "
        "echo \"ORACLE $label code=$code rc=$rc reply=$(printf %s \"$out\" | cut -c1-70)\"; }",
        "req recorder-replace $'" + replace + "'",
        "req recorder-add $'" + request("POST", "add") + "'",
        "req recorder-method $'" + request("GET", "method") + "'",
    ]) + "\n"


_ORACLE_LINE_RE = re.compile(r"ORACLE\s+(\S+)\s+(.*)")


def _oracle_report(lines):
    """{label: detail} from the guest's own ORACLE lines — what it says it attempted."""
    report = {}
    for line in lines:
        m = _ORACLE_LINE_RE.search(line)
        if m:
            report[m[1]] = m[2].strip()
    return report


def _probe_problems(report, *, observer_port):
    """(problems, summary) for what the guest says its probes did.

    The observer's silence is only evidence once the guest confirms it sent: a UDP send that
    never left is silence for the wrong reason. A TCP refusal is the expected outcome and is
    itself evidence — it carries the errno that separates a boundary decision from a guest
    whose stack had no route — so `blocked` there is a pass, while a missing line is not.
    """
    problems, notes = [], []
    for proto in ("tcp", "udp"):
        detail = report.get(f"observer-{proto}")
        if detail is None:
            problems.append(("unproven",
                             f"the guest never reported its {proto} probe of the observer "
                             f"port {observer_port}, so nothing observed there means anything"))
        else:
            notes.append(f"{proto} {detail}")
    if report.get("observer-udp", "").split()[:1] == ["blocked"]:
        problems.append(("unproven",
                         "the guest could not even open a UDP socket to the observer port "
                         f"({report['observer-udp']}) — a denied sendto succeeds everywhere "
                         "this was verified, so a failure here is a broken probe, not "
                         "containment"))
    for label, want in (("recorder-replace", "204"), ("recorder-add", "204"),
                        ("recorder-method", "403")):
        detail = report.get(label)
        if detail is None:
            problems.append(("unproven",
                             f"the guest never reported {label}, so its half of the Tier-2 "
                             "fixture did not run"))
            continue
        got = re.search(r"code=(\d{3})", detail)
        if got is None or got[1] == "000":
            problems.append(("unproven",
                             f"the guest got no status line for {label} ({detail}) — its "
                             "request reached no proxy at all, so it says nothing about what "
                             "the proxy does with one"))
        elif got[1] != want:
            observed = label == "recorder-method" and got[1].startswith("2")
            problems.append(("observed" if observed else "unproven",
                             f"the guest saw {got[1]} for {label}, not {want} ({detail}) — "
                             + ("a method the rule does not allow was forwarded"
                                if observed else
                                "so what that request proves about Tier 2 is not what this "
                                "fixture claims")))
    return problems, ("guest probes: " + "; ".join(notes) if notes else "guest probes: none")


def _audit_records(text):
    """The addon's JSON audit records out of a proxy log, in order.

    mitmdump stamps every line with its own `[HH:MM:SS.mmm] ` prefix and prints connection
    chatter of its own, so drop everything before the first brace and require a parse — the
    same reading `logs --audit` does, without the session filter (verify runs one ruleset,
    where the addon records no session).
    """
    records = []
    for line in text.splitlines():
        brace = line.find("{")
        if brace < 0:
            continue
        try:
            rec = json.loads(line[brace:])
        except ValueError:
            continue
        if isinstance(rec, dict) and rec.get("decision"):
            records.append(rec)
    return records


def _audit_expectations(*, full, recorder_port=None):
    """What this run's audit log must contain, each naming the guest line it corroborates."""
    expect = []
    if full:
        # Checks 1 and 2 are the two the guest reports as proxy-path results. Tying them to
        # the host's record is what closes the loop: a `403` the guest saw could have come
        # from anything on that port, and an allowed host it reached could have been reached
        # around the proxy entirely.
        expect.append({"decision": "allow", "host": _VERIFY_ALLOWED_HOST,
                       "why": "check 1's allowed host"})
        expect.append({"decision": "deny", "host": _VERIFY_UNLISTED_HOST,
                       "why": "check 2's unlisted host"})
    if recorder_port is not None:
        # Method, not path: the allow record is written after query stripping has rewritten the
        # request's path, and pinning the string mitmproxy leaves there would make this oracle
        # fail for a reason that is not about egress. The two POSTs are told apart at the
        # recorder, which sees what actually arrived.
        expect.append({"decision": "allow", "host": _RECORDER_HOST, "port": recorder_port,
                       "method": "POST", "why": "the recorder's two allowed POSTs"})
        expect.append({"decision": "deny", "host": _RECORDER_HOST, "port": recorder_port,
                       "method": "GET", "why": "the recorder request whose method no rule allows"})
    return expect


def _audit_missing(records, expectations):
    """The expectations no record satisfies — pure, because the poll loop below and the verdict
    itself must ask exactly the same question."""
    return [want for want in expectations
            if not any(all(rec.get(k) == v for k, v in want.items() if k != "why")
                       for rec in records)]


def _audit_problems(text, expectations, *, log_path):
    """(problems, summary) for the audit log against what this run should have provoked."""
    records = _audit_records(text)
    problems = []
    if not records:
        return ([("unproven",
                  f"{log_path} holds no audit record at all — either the addon stopped "
                  "auditing or the guest never reached this proxy, and the guest's own "
                  "proxy-path lines cannot tell those apart from success")],
                "audit: no records")
    for want in _audit_missing(records, expectations):
        fields = " ".join(f"{k}={v}" for k, v in want.items() if k != "why")
        problems.append(("unproven",
                         f"{log_path} holds no {fields} — nothing on the host corroborates "
                         f"{want['why']}, so that line is the guest's word alone"))
    if not any(rec["decision"] == "deny" for rec in records):
        problems.append(("unproven",
                         f"{log_path} records no deny at all, though every verify guest probes "
                         "the proxy with a host no ruleset allows (control 0) — an audit trail "
                         "with no refusal in it is not this run's"))
    elif not any(rec.get("host") == _VERIFY_CONTROL_HOST for rec in records):
        # Not fatal: the guest script owns that probe's URL, and a script that changed it is
        # not a containment finding. Worth a line, because this is the record that ties the
        # guest's `[OKAY] 0` to the proxy verify itself started.
        say(f"note: no audit record names {_VERIFY_CONTROL_HOST} — control 0's probe host is "
            "not the one this oracle expects, so only the remaining records tie the guest to "
            "this proxy")
    if _VERIFY_SENTINEL in text:
        problems.append(("observed",
                         f"the host's sentinel credential appears in {log_path} — the audit "
                         "trail is written where operators read it, and an injected value must "
                         "never be part of it"))
    decisions = {}
    for rec in records:
        decisions[rec["decision"]] = decisions.get(rec["decision"], 0) + 1
    counted = ", ".join(f"{n} {d}" for d, n in sorted(decisions.items()))
    return problems, (f"audit: {counted} in {log_path.name}" if not problems
                      else f"audit: {len(problems)} problem(s) in {log_path.name}")


def _await_audit(log_path, expectations, timeout=3.0):
    """The log's text once every expectation matches, or after `timeout` — mitmproxy logs
    through a StreamHandler, which flushes per record, but a decision made microseconds before
    the guest exited should not read as a missing one. The verdict is _audit_problems'; this
    only decides when to stop waiting for it."""
    deadline = time.monotonic() + timeout
    while True:
        try:
            text = log_path.read_text(errors="replace")
        except OSError as e:
            # No skip condition here, deliberately: the log is the host's half of the verdict,
            # and a run that cannot read it has no more evidence than the guest's word.
            die(f"cannot read the audit log {log_path} ({e.strerror}) — the run's own record "
                "is what the guest's verdict has to agree with, so nothing here is proven")
        records = _audit_records(text)
        settled = (records and not _audit_missing(records, expectations)
                   and any(rec["decision"] == "deny" for rec in records))
        if settled or time.monotonic() >= deadline:
            return text
        time.sleep(0.2)


_CHECK_LINE_RE = re.compile(r"\[(PASS|FAIL|SKIP)\]\s+(\d+)\.")


def _check_outcomes(lines):
    """{check id: 'PASS'|'FAIL'|'SKIP'} from the guest's own per-check lines.

    The per-check outcome, which the CHECKS/RESULT pair does not carry, and which the negative
    control needs: whether a *named* check failed where it should. Last line per id wins.
    """
    outcomes = {}
    for line in lines:
        m = _CHECK_LINE_RE.search(line)
        if m:
            outcomes[int(m[2])] = m[1]
    return outcomes


_NEGATIVE_CONTROL_CHECK = 3        # direct TCP to a live public service: what `allow` opens


def _negative_control_problem(contained, leaky):
    """(problem or None, summary) for the same script run in a guest that really leaks.

    The entry condition is one named check failing there, not a count: a future msb that
    accepted `--net-default-egress allow` and enforced deny anyway would leave every check
    passing in both guests, and reading that as "the checks work" is the exact inversion this
    control exists to prevent. So a leaky guest whose check 3 still passes proves nothing and
    says so. Beyond that, checks that passed in both guests are named rather than judged —
    the proxy-path ones are supposed to pass in both, and which of the rest can be explained
    is a reader's call, not this function's.
    """
    got = leaky.get(_NEGATIVE_CONTROL_CHECK, "no line")
    if got != "FAIL":
        return (f"the negative control established no leak: check {_NEGATIVE_CONTROL_CHECK} "
                f"reported {got} in the guest whose egress was left open, and that check is a "
                "direct connect to a live public service. Either msb no longer honours "
                "--net-default-egress allow or the probe cannot succeed on this host — either "
                "way nothing here shows the blocked-direction checks capable of failing, so "
                "this run draws no conclusion from them", None)
    both = sorted(i for i, outcome in leaky.items()
                  if outcome == "PASS" and contained.get(i) == "PASS")
    summary = (f"negative control: check {_NEGATIVE_CONTROL_CHECK} FAILED in the leaking guest"
               + (f"; checks {_ids(both)} passed in both guests" if both else
                  "; no check passed in both guests"))
    return None, summary


class _VerifyOracles:
    """The host-side half of one verify run: ports bound here, evidence read here.

    Built before the proxy starts, because the recorder's port has to be in the ruleset the
    proxy is handed and every port must be proven free before a mitmdump is spawned. Closed
    before the negative control's leaking guest boots: that guest may legitimately reach host
    loopback, and an arrival nobody asked for is precisely what the observer reports.
    """

    def __init__(self, proxy_port):
        # The observer takes the port beside the proxy's deliberately: check 10 already probes
        # exactly that port from inside the guest and expects a refusal, so the host is now
        # watching the port the guest pokes — they agree, or the disagreement is the finding.
        self.proxy_port = proxy_port
        self.observer = _ArrivalObserver(_oracle_port(proxy_port, 1))
        try:
            self.recorder = _HeaderRecorder(_oracle_port(proxy_port, 2))
        except BaseException:                  # incl. SystemExit from die()
            self.observer.close()
            raise
        # The proxy inherits this process's environment, and SecretStore reads SILKGATE_EGRESS_SECRET_*
        # for the unscoped (single-ruleset) proxy verify starts. The value is the sentinel, so
        # what this fixture spends is never a credential.
        os.environ[f"SILKGATE_EGRESS_SECRET_{_VERIFY_SECRET_NAME.upper()}"] = \
            f"{_VERIFY_AUTH_HEADER}: {_VERIFY_SENTINEL}"

    def rules(self):
        return self.recorder.rules()

    def arm(self):
        """Prove the observer functional before anything is allowed to conclude from silence."""
        self.observer.self_test()

    def probe(self, sandbox):
        """Run the guest's half in `sandbox`, before the check script: check 7 changes the
        guest's routing and never restores it, so probes that run after it are measuring a
        network the script broke."""
        lines = []
        script = _oracle_guest_script(proxy_port=self.proxy_port,
                                      observer_port=self.observer.port,
                                      recorder_port=self.recorder.port,
                                      token=self.observer.guest_token)
        run_guest(lambda cmd: msb_exec_argv(sandbox, cmd), ["bash", "-c", script],
                  tty=False, on_line=lines.append)
        self.observer.drain()
        return _oracle_report(lines)

    def expectations(self):
        return _audit_expectations(full=False, recorder_port=self.recorder.port)

    def problems(self, report):
        """(problems, summaries) from the observer, the recorder and the guest's own report."""
        problems, summaries = [], []
        for found, summary in (
            _probe_problems(report, observer_port=self.observer.port),
            _observer_problems(self.observer.arrivals, bound=self.observer.bound(),
                               self_token=self.observer.self_token,
                               guest_token=self.observer.guest_token,
                               port=self.observer.port, proxy_port=self.proxy_port),
            _recorder_problems(self.recorder.records, token=self.observer.guest_token,
                               port=self.recorder.port),
        ):
            problems += found
            summaries.append(summary)
        return problems, summaries

    def close(self):
        self.observer.close()
        self.recorder.close()


def _oracle_die(problems, log_path):
    """Refuse the run, with the loudest framing the problems justify.

    An "observed" problem is the host having seen containment or enforcement fail, which
    outranks everything the guest said; an "unproven" one is the oracle itself not being
    trustworthy, which must not be reported as a boundary failure — that would send a reader
    to msb's flags when the fault is in the audit path, the ruleset or which proxy the guest
    reached.
    """
    observed = [text for kind, text in problems if kind == "observed"]
    unproven = [text for kind, text in problems if kind == "unproven"]
    lines = []
    if observed:
        lines.append("CONTAINMENT FAILED OUTSIDE THE GUEST — the host itself saw this, so it "
                     "rests on nothing the guest printed:")
        lines += [f"  - {t}" for t in observed]
    if unproven:
        lines.append("  and the evidence for the rest is incomplete:" if observed else
                     "ORACLE UNPROVEN — the guest's checks passed and the host's own record of "
                     "the same run does not corroborate them. This is not a failed check: "
                     "suspect the audit path, the composed ruleset, or which proxy the guest "
                     "reached.")
        lines += [f"  - {t}" for t in unproven]
    lines.append(f"audit log: {log_path}")
    die("\n".join(lines))


def cmd_verify(args):
    preflight("msb", "mitmdump")
    _reap_leaked_verify_guests()
    rules_text = compose_rules(resolve_profiles(["probe"], allow_verify_only=True))
    oracles = _VerifyOracles(args.port) if args.oracles else None
    if oracles:
        rules_text += oracles.rules()
    load_ruleset(rules_text)
    script = "bash /mnt/poc/test/verify_guest.sh"
    mounts = [f"{REPO}:/mnt/poc:ro"]
    if args.full:
        mounts.append(f"{ensure_ca().parent}:/mnt/ca:ro")
        script = FULL_SETUP + script

    # The same relay every other guest command uses, for the same two reasons and one more.
    # msb forwards output as it happens only when it has a terminal of its own, and it decides
    # what to give the guest the same way — so reading msb through a plain pipe means the whole
    # run arrives at once, while handing it this terminal means everything inside formats for a
    # screen (apt's progress meter, msb's cursor moves) and leaves the terminal in raw mode
    # afterwards. The relay resolves both: msb gets a PTY, the command inside gets pipes and
    # /dev/null. The third reason is ours — the parse below then reads exactly the cleaned text
    # a human sees, rather than a separately buffered copy of it.
    found, lines, report = {}, [], {}

    def note(text):
        lines.append(text)
        m = re.search(r"RESULT: (\d+) passed, (\d+) failed", text)
        if m:
            found["result"] = (int(m[1]), int(m[2]))
        if "CHECKS: ran=" in text:
            found["checks"] = _parse_checks(text)

    guests, proxy = set(), None
    try:
        proxy, log_path = start_proxy(rules_text, args.port)
        say(f"proxy :{args.port} · audit: tail -f {log_path}")
        guest = _verify_guest_name("main")
        with _guarded_terminal():
            _create_verify_guest(guest, args.port, mounts=mounts)
            guests.add(guest)
            if oracles:
                oracles.arm()
                report = oracles.probe(guest)
            run_guest(lambda cmd: msb_exec_argv(guest, cmd), ["bash", "-c", script],
                      tty=False, on_line=note)
        _drop_verify_guest(guest, guests)      # nothing waits on it; the finally re-tries

        result, checks = found.get("result"), found.get("checks")
        if result is None:
            die("no RESULT line — the guest never ran verify_guest.sh (msb server started?)")
        if checks is None:
            die("no CHECKS line — the guest did not report which checks ran, so nothing is "
                "proven")
        passed, failed = result
        ran, skipped, unavailable = checks
        bad = _verify_shortfall(passed, failed, ran, skipped, unavailable, full=args.full)
        if bad:
            die(bad)

        # The guest's own verdict holds. Now the host's record of the same run, which is the
        # half no guest can write.
        expect = _audit_expectations(full=args.full,
                                     recorder_port=oracles.recorder.port if oracles else None)
        problems, summaries = [], []
        if oracles:
            problems, summaries = oracles.problems(report)
        audit_problems, audit_summary = _audit_problems(
            _await_audit(log_path, expect), expect, log_path=log_path)
        problems += audit_problems
        summaries.append(audit_summary)
        if problems:
            _oracle_die(problems, log_path)
        if oracles:
            oracles.close()                    # before any guest with open egress exists

        if args.negative_control:
            leaky = _verify_guest_name("leaky")
            say("negative control: booting a second guest with --net-default-egress allow, "
                "which is what FEEDBACK records as actually opening egress")
            leaky_lines = []
            with _guarded_terminal():
                _create_verify_guest(leaky, args.port, mounts=mounts, leaky=True,
                                     why=" — the control did not run, so this verify says "
                                         "nothing about whether its checks can fail")
                guests.add(leaky)
                run_guest(lambda cmd: msb_exec_argv(leaky, cmd), ["bash", "-c", script],
                          tty=False, on_line=leaky_lines.append)
            _drop_verify_guest(leaky, guests)
            problem, summary = _negative_control_problem(_check_outcomes(lines),
                                                         _check_outcomes(leaky_lines))
            if problem:
                die(problem)
            summaries.append(summary)

        left = sorted(guests)
        if left:
            die(f"verify guest(s) {', '.join(left)} could not be removed — each still holds a "
                f"Tier-1 rule and a port allowance, and the next verify collides with proxy "
                f"port {args.port}. `msb stop NAME && msb rm NAME`, then re-run")
        for summary in summaries:
            say(summary)
        # _verify_shortfall already refused any unavailable id without a declared subject,
        # so the lookup below cannot miss; the guest's [UNAV] lines above carry the detail.
        absent = ", ".join(sorted({_VERIFY_SUBJECTS[i] for i in unavailable}))
        say(f"containment holds ({passed} passed, 0 failed; checks {_ids(ran)} ran; "
            + (f"checks {_ids(unavailable)} had no subject — this guest has no {absent}, "
               "see their [UNAV] lines; " if unavailable else "")
            + ("host-side oracles agree" if oracles else "host-side oracles skipped") + ")")
    finally:
        if proxy is not None:
            stop(proxy)
        if oracles:
            oracles.close()
        for name in sorted(guests):
            if not _remove_sandbox(name):
                say(f"could not remove verify guest {name} — `msb stop {name} && msb rm "
                    f"{name}` by hand; it holds a Tier-1 rule and a port allowance")


# --- entry point ---------------------------------------------------------------
# The two argument types that reach a generated Dockerfile or an msb argv are checked by
# argparse itself, so a rejection names the flag it came from: `--with node@22.11.0` is
# exactly the token a reviewer's eye slides over on a command line composed for approval.

def _github_repo_arg(value):
    """argparse type for --github-read/--github-write: OWNER/REPO with no traversal."""
    if not _GITHUB_REPO_RE.fullmatch(value) or ".." in value:
        raise argparse.ArgumentTypeError(
            f"invalid repo {value!r} — expected OWNER/REPO (letters, digits, '.', '-', '_'; "
            "exactly one slash, no path traversal)")
    return value


def _mount_arg(spec):
    """argparse type for -v/--mount: SRC:DST[:MODE] syntax alone — the path guards run at
    dispatch, where the mount list is checked as a whole (_mount_args)."""
    if _split_mount(spec) is None:
        raise argparse.ArgumentTypeError(
            f"invalid mount {spec!r} — expected SRC:DST[:ro|rw] (MODE defaults to ro)")
    return spec


def _with_arg(spec):
    """argparse type for --with: `name[@version]`. The name is resolved later, against the
    profiles that exist; only the version is a charset question, and it is asked here."""
    _, sep, version = spec.partition("@")
    if sep and not version:
        raise argparse.ArgumentTypeError(
            f"{spec!r} pins an empty version — drop the '@' or name a version (an unset shell "
            "variable expands to this, and would quietly install the default instead)")
    bad = _version_error(version) if version else None
    if bad:
        raise argparse.ArgumentTypeError(bad)
    return spec


def _image_arg(ref):
    """argparse type for --base and --image."""
    bad = _image_error(ref)
    if bad:
        raise argparse.ArgumentTypeError(bad)
    return ref


class _MarkedParser(argparse.ArgumentParser):
    """argparse whose stderr lines carry silkgate's voice mark.

    say()/die() open every line silkgate speaks as itself with the byte relayed guest
    output cannot carry (see say); argparse's `usage:` and `error:` lines go to stderr
    too, so they are host voice and get the same mark. Scripts read the exit status (2
    for a usage error) and the message text, so both stay exactly argparse's own — the
    mark opens each stderr line and terminals draw nothing for it. error() and exit()
    are argparse's documented override points, and add_subparsers() instantiates the
    calling class, so every subcommand's parser marks its errors the same way. Help goes
    to stdout, the stream that carries no claim of being silkgate's, and stays bare.
    """

    def exit(self, status=0, message=None):
        # argparse passes a message here only on the error path; help and version print
        # to stdout elsewhere and call this bare.
        if message:
            mark = _ERR_TAG.decode()
            sys.stderr.write("".join(mark + ln for ln in message.splitlines(keepends=True)))
            sys.stderr.flush()
        sys.exit(status)

    def error(self, message):
        # Exactly what stock error() prints — usage, then "prog: error: message" — folded
        # into one exit() message so every line passes through the marking above.
        self.exit(2, f"{self.format_usage()}{self.prog}: error: {message}\n")


def main():
    ap = _MarkedParser(prog="silkgate", description=__doc__,
                       formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="command", required=True)

    def profile_opts(p, *, rules_only=False):
