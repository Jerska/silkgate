def _events_files(pattern="events-*.jsonl"):
    """The retained files of one trail kind, oldest first — the stamp in the name is
    the order. The audit trail and the capture trail share the layout, so the glob is
    the only parameter."""
    return sorted(LOG_DIR.glob(pattern))


def _event_passes(rec, filters):
    """Whether one parsed record survives the /api/events filters.

    `session` is exact, and "null" selects unattributed records. `host` is a case-folded
    substring, `method` case-folded. `since`/`until` are aware datetimes, and a record
    whose `ts` is unparsable or naive fails a time filter, never slips past it."""
    since, until = filters.get("since"), filters.get("until")
    if since is not None or until is not None:
        try:
            ts = datetime.fromisoformat(rec.get("ts") or "")
        except (TypeError, ValueError):
            return False
        if ts.tzinfo is None:
            return False
        if since is not None and ts < since:
            return False
        if until is not None and ts > until:
            return False
    session = filters.get("session")
    if session is not None:
        if session == "null":
            if rec.get("session") is not None:
                return False
        elif rec.get("session") != session:
            return False
    decision = filters.get("decision")
    if decision is not None and rec.get("decision") != decision:
        return False
    method = filters.get("method")
    if method is not None and (rec.get("method") or "").upper() != method.upper():
        return False
    host = filters.get("host")
    if host is not None and host.lower() not in (rec.get("host") or "").lower():
        return False
    return True


def _events_history(filters, limit, pattern="events-*.jsonl"):
    """The newest `limit` records passing `filters`, oldest first, across every
    retained file of one kind (filename order — the stamp is chronological, and
    records within a file are append-ordered). Unparsable lines are skipped: the live
    file's tail can be half-written mid-read, and history must not die on it."""
    kept = []
    for path in _events_files(pattern):
        try:
            lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
        except OSError:                          # pruned mid-scan: already gone
            continue
        for line in lines:
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            if isinstance(rec, dict) and _event_passes(rec, filters):
                kept.append(rec)
    return kept[-limit:]


class _EventsTailer:
    """Byte-offset tail of the live events file, one poll at a time.

    This tracks which file is live and how far the client has read, so the stream tests
    without a server. `poll` takes the current proxy.json and yields ("reset"|"record",
    payload, cursor). A cursor, "<file>:<offset>", doubles as the SSE id.

    | Event | Resumes at |
    |---|---|
    | the proxy restarted (new events path) | the new file, from 0 |
    | the file was truncated | the same file, from 0 |
    | a cursor names another file | the live file's EOF. The client refetches history. |
    | no proxy | nothing yet, and a later `up` flows into the same stream |

    `meta_key` picks the proxy.json entry: "events" or "capture"."""

    def __init__(self, cursor=None, meta_key="events"):
        self._path = None                        # nothing live seen yet
        self._offset = 0
        self._start = cursor                     # consumed when a live file first appears
        self._meta_key = meta_key

    @staticmethod
    def _parse_cursor(cursor):
        name, sep, off = (cursor or "").rpartition(":")
        if sep and off.isdigit():
            return name, int(off)
        return None, None

    def poll(self, proxy_meta):
        out = []
        events = (proxy_meta or {}).get(self._meta_key)
        if not events:
            return out
        path = Path(events)
        if self._path is None:                   # first pass that sees a live file
            cursor, self._start = self._start, None
            self._path = path
            name, offset = self._parse_cursor(cursor)
            if name == path.name:
                self._offset = offset            # hand-over from /api/events, or a reconnect
            else:
                try:
                    self._offset = path.stat().st_size
                except OSError:
                    self._offset = 0
                if cursor is not None:           # a cursor was given, but for another file
                    out.append(("reset", None, f"{path.name}:{self._offset}"))
        if path != self._path:                   # proxy restarted onto a fresh file
            self._path, self._offset = path, 0
            out.append(("reset", None, f"{path.name}:0"))
        try:
            size = self._path.stat().st_size
        except OSError:
            size = None
        if size is not None and size < self._offset:     # truncated in place
            self._offset = 0
            out.append(("reset", None, f"{self._path.name}:0"))
        lines, new_offset = _read_from(self._path, self._offset)
        if lines is None:                        # unreadable this pass: try again later
            return out
        pos = self._offset
        for i, line in enumerate(lines):
            # json.dumps output is ASCII, so a line's length is its byte length; the
            # final line's cursor is pinned to _read_from's own offset regardless.
            pos = new_offset if i == len(lines) - 1 else pos + len(line.encode()) + 1
            try:
                rec = json.loads(line)
            except ValueError:                   # a torn write that still ended in \n
                continue
            if isinstance(rec, dict):
                out.append(("record", line, f"{self._path.name}:{pos}"))
        self._offset = new_offset
        return out


# --- ui: per-session detail, control and search -------------------------------------
# Module-level (not nested in the handler) for the same reason _bundle_in_guest is:
# every host/guest boundary here is a seam the tests stub, and every cache must be
# one per process, not one per request thread.

UI_BRIEF_MAX_BYTES = 256 << 10   # /api/session serves at most this much brief text
UI_ARCHIVED_LIMIT = 50           # newest archived metas /api/sessions carries
UI_OUTPUT_TAIL = 200             # /api/session/<ident>/output default tail
UI_OUTPUT_TAIL_MAX = 2000
UI_OUTPUT_TTL = 1.0              # seconds one output fetch answers for, per session
UI_METRICS_TTL = 2.0             # seconds one msb metrics run answers for
UI_SEARCH_LIMIT = 200            # /api/search early-exits at this many results
UI_SEARCH_MIN_QUERY = 3
UI_SEARCH_MAX_BYTES = 32 << 20   # /api/search stops scanning past this many bytes

_EXEC_ID_RE = re.compile(r"[0-9a-f]{8}")

_OUTPUT_LOCK = threading.Lock()
_OUTPUT_CACHE = {}               # (name, tail) -> (monotonic stamp, payload, code)
_METRICS_LOCK = threading.Lock()
_METRICS_CACHE = {"at": None, "payload": None}
_DIFF_LOCK = threading.Lock()
_DIFF_BUSY = set()               # idents with a diff in flight: one guest git at a time


def _resolve_ident(ident):
    """(meta, state, session dir) for a live name or an archived sid, or three Nones.

    The ident is checked before it's a path: by read_meta for a name, read_archived_meta
    for a sid. Their die() on a planted meta becomes a not-found here, not a dead thread.
    A name that also parses as a sid resolves live first."""
    if _NAME_RE.fullmatch(ident or ""):
        try:
            meta = read_meta(ident)
        except SystemExit:
            return None, None, None
        if meta:
            return meta, "live", session_dir(ident)
    if _SID_RE.fullmatch(ident or ""):
        try:
            meta = read_archived_meta(ident)
        except SystemExit:
            return None, None, None
        if meta:
            return meta, "archived", ARCHIVE_DIR / ident
    return None, None, None


def _brief_entry(path, source):
    """One briefs-map entry read from `path`, or None where no file answers. Text is
    capped at UI_BRIEF_MAX_BYTES and the sha256 covers the bytes served."""
    try:
        with open(path, "rb") as f:
            data = f.read(UI_BRIEF_MAX_BYTES + 1)
    except OSError:
        return None
    truncated = len(data) > UI_BRIEF_MAX_BYTES
    data = data[:UI_BRIEF_MAX_BYTES]
    return {"source": source, "text": data.decode("utf-8", "replace"),
            "sha256": hashlib.sha256(data).hexdigest(), "truncated": truncated}


def _session_briefs(meta, state, sdir):
    """The briefs map for /api/session: per exec_id, plus "default" and "workspace".

    Each exec's source ("flag" or "default") comes from its exec_start record, and a lost
    record reads as "flag". exec_ids are 8 hex chars, so the two reserved keys can't
    collide. "workspace" (<workspace>/BRIEF.md) appears only for a live session with no
    operator brief. It's guest-writable, so its label is the warning, and symlinks aren't
    followed."""
    sources = {}
    for rec in _read_journal(sdir / "journal.jsonl"):
        if rec.get("event") == "exec_start" and rec.get("brief_source"):
            sources[str(rec.get("exec_id"))] = str(rec["brief_source"])
    briefs = {}
    bdir = sdir / "briefs"
    if bdir.is_dir():
        for p in sorted(bdir.glob("*.md")):
            if not _EXEC_ID_RE.fullmatch(p.stem):    # not something silkgate stored
                continue
            entry = _brief_entry(p, sources.get(p.stem, "flag"))
            if entry:
                briefs[p.stem] = entry
    if (sdir / "brief.md").is_file():
        entry = _brief_entry(sdir / "brief.md", "default")
        if entry:
            briefs["default"] = entry
    if not briefs and state == "live" and meta.get("workspace"):
        path = Path(meta["workspace"]) / "BRIEF.md"
        if not path.is_symlink() and path.is_file():
            entry = _brief_entry(path, "workspace")
            if entry:
                briefs["workspace"] = entry
    return briefs


def _session_output(meta, state, sdir, tail):
    """(payload, status) for /api/session/<ident>/output. Archived sessions read the
    output.log snapshot; live ones ask msb, behind a 1 s TTL cache per (session,
    tail) — N open tabs cost one subprocess per second, and a failure is cached the
    same so a dead sandbox is not re-poked every poll."""
    if state == "archived":
        try:
            text = (sdir / "output.log").read_text(encoding="utf-8", errors="replace")
        except OSError:
            text = ""
        lines = text.splitlines()
        return {"source": "archive", "lines": lines[-tail:],
                "truncated": len(lines) > tail}, 200
    key = (meta["name"], tail)
    with _OUTPUT_LOCK:
        hit = _OUTPUT_CACHE.get(key)
        if hit and time.monotonic() - hit[0] < UI_OUTPUT_TTL:
            return hit[1], hit[2]
        lines, err = _run_msb_logs(meta["sandbox"], tail_n=tail)
        if err is not None:
            payload, code = {"error": f"cannot read guest output: {err}"}, 502
        else:
            # tail lines came back full: there may be more — that is all msb says.
            payload, code = {"source": "live", "lines": lines,
                             "truncated": len(lines) >= tail}, 200
        _OUTPUT_CACHE[key] = (time.monotonic(), payload, code)
        return payload, code


_DIFF_TIMEOUT = 30
_DIFF_MAX_BYTES = 2 << 20

# One in-guest pass for /api/session/<ident>/diff: status, then a patch against $1, split
# by a marker. Both gits run with --no-pager and GIT_PAGER=cat: a pager would block until
# _DIFF_TIMEOUT and draw `(END)` on the guest console, which the output snapshot reads.
_DIFF_SH = """\
set -eu
GIT_PAGER=cat; export GIT_PAGER
{cd}git --no-pager status --porcelain
echo SILKGATE_DIFF_SPLIT
git --no-pager diff "$1"
"""


def _diff_in_guest(meta):
    """(status, diff, error) from a live guest — a branch session diffs through the
    GIT_DIR/GIT_WORK_TREE pair, a checkout session from /workspace where its clone's
    own .git lives."""
    if meta.get("branch"):
        script, env = _DIFF_SH.format(cd=""), _BRANCH_ENV
    else:
        script, env = _DIFF_SH.format(cd="cd /workspace\n"), ()
    try:
        # stdin closed: the script reads none, and msb exec waits on an inherited
        # stdin for EOF (see tier1_fault) — a detached caller's would never close.
        proc = subprocess.run(msb_exec_argv(meta["sandbox"],
                                            ["sh", "-c", script, "_", meta["base"]],
                                            env=env),
                              stdin=subprocess.DEVNULL, capture_output=True, text=True,
                              errors="replace", start_new_session=True,
                              timeout=_DIFF_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired):
        return None, None, "the guest did not answer the diff request in time"
    if proc.returncode:
        return None, None, (proc.stderr.strip().splitlines()
                            or ["guest git diff failed"])[-1]
    status, sep, diff = proc.stdout.partition("SILKGATE_DIFF_SPLIT\n")
    if not sep:
        return None, None, "no diff verdict from the guest"
    return status, diff, None


def _clip_text(text, cap):
    """(text within `cap` utf-8 bytes, whether it was cut)."""
    data = text.encode("utf-8", "replace")
    if len(data) <= cap:
        return text, False
    return data[:cap].decode("utf-8", "replace"), True


def _run_msb_metrics():
    """`msb metrics --format json` parsed, or None on any failure — the seam
    /api/metrics stubs in tests and the TTL cache sits in front of."""
    msb = shutil.which("msb")
    if not msb:
        return None
    try:
        proc = subprocess.run([msb, "metrics", "--format", "json"],
                              capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if proc.returncode:
        return None
    try:
        parsed = json.loads(proc.stdout)
    except ValueError:
        return None
    return parsed


def _metrics_snapshot():
    """The /api/metrics payload, behind a 2 s TTL cache under one lock, so N tabs cost one
    msb call per TTL. An empty registry skips msb, and a failure is cached like a success,
    so a hung msb isn't re-poked every poll.

    Each row is msb's entry, with one rename: msb's memory gauge is the VMM's host-side RSS,
    not guest usage, and can exceed the guest cap. So it's `memory_rss_bytes`, never framed
    as a ratio of `memory_limit_bytes`."""
    with _METRICS_LOCK:
        now = time.monotonic()
        if (_METRICS_CACHE["at"] is not None
                and now - _METRICS_CACHE["at"] < UI_METRICS_TTL):
            return _METRICS_CACHE["payload"]
        metrics = []
        metas = list_metas()
        if metas:
            raw = _run_msb_metrics()
            by_sandbox = {}
            if isinstance(raw, list):                # msb's native shape: one entry per
                for entry in raw:                    # sandbox, named inside the entry
                    if isinstance(entry, dict) and entry.get("name"):
                        by_sandbox[str(entry["name"])] = entry
            elif isinstance(raw, dict):
                by_sandbox = {k: v for k, v in raw.items() if isinstance(v, dict)}
            for m in metas:
                entry = by_sandbox.get(m["sandbox"])
                if entry is not None:
                    row = {k: v for k, v in entry.items() if k != "name"}
                    if "memory_bytes" in row:
                        row["memory_rss_bytes"] = row.pop("memory_bytes")
                    metrics.append({"session": m["name"], **row})
        payload = {"sampled": now_iso(), "ttl": UI_METRICS_TTL, "metrics": metrics}
        _METRICS_CACHE.update(at=now, payload=payload)
        return payload


def _search_files():
    """(path, source) pairs for /api/search, newest file first by mtime across the
    capture trail, the audit trail and every archived journal — so an early exit
    keeps the freshest records."""
    entries = []
    for pattern, source in (("capture-*.jsonl", "capture"), ("events-*.jsonl", "audit")):
        entries += [(p, source) for p in LOG_DIR.glob(pattern)]
    if ARCHIVE_DIR.is_dir():
        entries += [(d / "journal.jsonl", "journal") for d in ARCHIVE_DIR.iterdir()
                    if _SID_RE.fullmatch(d.name) and (d / "journal.jsonl").is_file()]

    def mtime(entry):
        try:
            return entry[0].stat().st_mtime
        except OSError:
            return 0.0
    return sorted(entries, key=mtime, reverse=True)


def _search_trail(query, session, limit):
    """(results, truncated) for /api/search: a case-folded substring scan of the raw
    JSONL lines, newest file first and newest line first within a file, early-exited
    at `limit` results and at a scanned-bytes ceiling.

    A bounded linear scan fits one operator's trails. If the ceiling starts truncating
    routine queries, add an SQLite index over the same files."""
    needle = query.casefold()
    results, scanned = [], 0
    for path, source in _search_files():
        if len(results) >= limit or scanned >= UI_SEARCH_MAX_BYTES:
            return results, True
        # Journal records carry no session field; the archive's sid names it
        # (<stamp>-<name>-<hex>), so the filter still lands.
        journal_session = path.parent.name[17:-7] if source == "journal" else None
        try:
            data = path.read_bytes()
        except OSError:
            continue
        scanned += len(data)
        for line in reversed(data.decode("utf-8", "replace").splitlines()):
            if needle not in line.casefold():
                continue
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            if not isinstance(rec, dict):
                continue
            if session is not None:
                held = journal_session if source == "journal" else rec.get("session")
                if held != session:
                    continue
            results.append({"source": source, "record": rec})
            if len(results) >= limit:
                return results, True
    return results, False


def _session_state(name):
    """One live session's state as the UI reports it: "frozen" while rules.frozen
    holds the preserved ruleset, else "live". The VM runs either way — frozen is
    about egress, not placement, so archive stays out of this answer."""
    return "frozen" if (session_dir(name) / "rules.frozen").exists() else "live"


def _freeze_session(name):
    """Freeze one live session's egress: rules.txt moves to rules.frozen and an empty
    ruleset takes its place — deny-by-default does the rest, since the addon re-reads
    the session's rules on every resolve. Why it failed, or None."""
    sdir = session_dir(name)
    if (sdir / "rules.frozen").exists():
        return "already frozen"
    try:
        (sdir / "rules.txt").rename(sdir / "rules.frozen")
        (sdir / "rules.txt").write_text("")
    except OSError as e:
        return f"could not freeze: {e}"
    _journal(name, "frozen")
    return None


def _resume_session(name):
    """Undo _freeze_session: the preserved ruleset moves back over the empty one (one
    atomic rename). Why it failed, or None."""
    sdir = session_dir(name)
    if not (sdir / "rules.frozen").exists():
        return "not frozen"
    try:
        (sdir / "rules.frozen").rename(sdir / "rules.txt")
    except OSError as e:
        return f"could not resume: {e}"
    _journal(name, "resumed")
    return None


_KILL_GRACE = 5     # seconds between TERM and the KILL escalation, in-guest

# One in-guest pass for the kill endpoint: signal the process group the exec's
# pidfile names, politely first, then hard once the grace runs out. The pidfile is
# guest-written, so its content is held to digits before it reaches kill's argv.
_KILL_SH = ("set -eu\n"
            f'pidfile={GUEST_EXECS}/$1.pid\n'
            'if [ ! -f "$pidfile" ]; then echo SILKGATE_NO_PIDFILE; exit 0; fi\n'
            'pgid=$(cat "$pidfile")\n'
            'case "$pgid" in ""|*[!0-9]*) echo SILKGATE_NO_PIDFILE; exit 0;; esac\n'
            'kill -TERM -- -"$pgid" 2>/dev/null || :\n'
            f'i=0; while [ $i -lt {_KILL_GRACE} ] && kill -0 -- -"$pgid" 2>/dev/null; '
            'do sleep 1; i=$((i+1)); done\n'
            'if kill -0 -- -"$pgid" 2>/dev/null; '
            'then kill -KILL -- -"$pgid" 2>/dev/null || :; fi\n'
            'echo SILKGATE_KILLED\n')


def _kill_in_guest(meta, exec_id):
    """(token, detail) from the guest: SILKGATE_KILLED, SILKGATE_NO_PIDFILE (the exec
    already ended — its wrapper's trap removed the pidfile), or SILKGATE_ERROR."""
    try:
        # stdin closed: the script reads none, and msb exec waits on an inherited
        # stdin for EOF (see tier1_fault) — a detached caller's would never close.
        proc = subprocess.run(msb_exec_argv(meta["sandbox"],
                                            ["sh", "-c", _KILL_SH, "_", exec_id]),
                              stdin=subprocess.DEVNULL, capture_output=True, text=True,
                              start_new_session=True,
                              timeout=_KILL_GRACE + _MSB_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired):
        return "SILKGATE_ERROR", "the guest did not answer the kill request in time"
    for line in reversed(proc.stdout.splitlines()):
        token = line.strip()
        if token in ("SILKGATE_KILLED", "SILKGATE_NO_PIDFILE"):
            return token, ""
    return "SILKGATE_ERROR", (proc.stderr.strip().splitlines()
                              or ["no verdict from the guest"])[-1]


def _ui_server(port):
    """The bound, threaded HTTP server behind `silkgate ui`; the caller runs it.

    Threaded, because one open SSE stream would block a plain HTTPServer. Daemon threads,
    so Ctrl-C's os._exit reaps open streams. Every response sends nosniff and a self-only
    CSP: even a record that smuggles markup can't send the trail anywhere.

    No auth, by design: the 127.0.0.1 bind is the boundary, and Tier 1 keeps guests off
    every host port. Never bind beyond loopback. Remote use is an SSH tunnel, and a future
    --bind needs token auth first. Against the host's own browsers, every request needs a
    loopback Host (a DNS-rebound page sends its own) and a loopback Origin, if present.
    """
    # Local imports: only this command needs an HTTP server, and every `silkgate exec`
    # would otherwise pay for importing one.
    import urllib.parse
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"
        server_version = "silkgate-ui"
        sys_version = ""

        def log_message(self, *a):               # the events files are the record
            pass

        def _security(self):
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Content-Security-Policy", "default-src 'self'")

        def _reply(self, code, ctype, body):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self._security()
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(body)

        def _json(self, obj, code=200):
            self._reply(code, "application/json", json.dumps(obj).encode())

        def _guarded(self):
            """Whether this request came from this host's browser, pointed at this server.

            Host must be loopback, which a DNS-rebound page fails. A present Origin must be
            loopback too, and browsers always send it on cross-origin POSTs. That guards
            every endpoint that runs `msb exec` or tears a session down."""
            loopback = ("127.0.0.1", "localhost", "::1")
            try:
                host = urllib.parse.urlsplit("//" + (self.headers.get("Host") or ""))
            except ValueError:
                return False
            if host.hostname not in loopback:
                return False
            origin = self.headers.get("Origin")
            if origin is None:
                return True
            try:
                parts = urllib.parse.urlsplit(origin)
            except ValueError:
                return False
            return parts.scheme in ("http", "https") and parts.hostname in loopback

        def do_GET(self):
            url = urllib.parse.urlsplit(self.path)
            query = {k: v[-1] for k, v in urllib.parse.parse_qs(url.query).items()}
            try:
                if not self._guarded():
                    return self._json({"error": "forbidden"}, 403)
                if url.path == "/api/sessions":
                    self._sessions()
                elif url.path == "/api/events":
                    self._events(query)
                elif url.path == "/api/capture":
                    self._capture(query)
                elif url.path == "/api/stream":
                    self._stream(query)
                elif url.path == "/api/capture/stream":
                    self._stream(query, meta_key="capture")
                elif url.path == "/api/metrics":
                    self._json(_metrics_snapshot())
                elif url.path == "/api/search":
                    self._search(query)
                elif url.path.startswith("/api/session/"):
                    ident, _, sub = url.path[len("/api/session/"):].partition("/")
                    if not sub:
                        self._session(ident)
                    elif sub == "output":
                        self._output(ident, query)
                    else:
                        self._json({"error": "not found"}, 404)
                else:
                    self._static(url.path)
            except (BrokenPipeError, ConnectionResetError):
                self.close_connection = True     # the tab closed; nobody to answer

        def do_POST(self):
            # POSTs are the control plane: freeze/resume/down/kill/diff all reach a
            # guest or the registry, so the guard above is what stands between them
            # and any web page (see _guarded — Origin is always on a cross-site POST).
            self.close_connection = True         # request bodies are never read here
            url = urllib.parse.urlsplit(self.path)
            parts = url.path.split("/")
            try:
                if not self._guarded():
                    return self._json({"error": "forbidden"}, 403)
                if parts[:3] == ["", "api", "session"] and len(parts) == 5 \
                        and parts[4] in ("freeze", "resume", "down", "diff"):
                    if parts[4] == "diff":
                        self._diff(parts[3])
                    else:
                        self._control(parts[3], parts[4])
                elif parts[:3] == ["", "api", "session"] and len(parts) == 7 \
                        and parts[4] == "exec" and parts[6] == "kill":
                    self._kill(parts[3], parts[5])
                else:                            # POST exists for the control plane
                    self._refuse()               # alone; everything else stays 405
            except (BrokenPipeError, ConnectionResetError):
                self.close_connection = True

        def _refuse(self):
            self.close_connection = True         # keep a HEAD from desyncing keep-alive
            self._json({"error": "method not allowed"}, 405)

        do_PUT = do_PATCH = do_DELETE = do_HEAD = do_OPTIONS = _refuse

        def _static(self, path):
            route = _UI_ROUTES.get(path)
            if route is None:
                return self._json({"error": "not found"}, 404)
            name, ctype = route
            try:
                body = (UI_DIR / name).read_bytes()
            except OSError:
                return self._json({"error": f"{name} is missing from {UI_DIR}"}, 404)
            self._reply(200, ctype, body)

        def _sessions(self):
            meta = read_proxy() or {}
            ident = _proxy_ident()               # identity via the control socket, as ever:
            running = ident is not None          # a recycled pid must not read as "running"
            # Archived rows carry the keys a listing needs; /api/session/<sid> has
            # the rest. last_rc rides along only where an exec_end recorded one.
            archived = [{"sid": m["sid"], "name": m.get("name"),
                         "created": m.get("created"),
                         "ended": m.get("ended"),
                         **({"last_rc": m["last_rc"]} if "last_rc" in m else {}),
                         **({"branch": m["branch"]} if m.get("branch") else {})}
                        for m in reversed(list_archived_metas()[-UI_ARCHIVED_LIMIT:])]
            self._json({"sessions": [{**m, "state": _session_state(m["name"])}
                                     for m in list_metas()],
                        "archived": archived,
                        "proxy": {"running": running,
                                  "pid": (ident or meta.get("pid")) if running else None,
                                  "ports": meta.get("ports"),
                                  "started": meta.get("started"),
                                  "log": meta.get("log"),
                                  "events": meta.get("events")}})

        def _limit(self, query, default, cap):
            """The validated limit parameter, or None after a 400 went out."""
            try:
                limit = int(query.get("limit", default))
            except ValueError:
                self._json({"error": "limit: not an integer"}, 400)
                return None
            if limit < 1:
                self._json({"error": "limit: must be >= 1"}, 400)
                return None
            return min(limit, cap)

        def _page(self, filters, limit, meta_key, pattern):
            """One history page plus the live cursor — /api/events and /api/capture
            differ only in which trail they read. The live file's size is read BEFORE
            the history: a record appended between the two shows up in both history
            and the stream — the client dedupes on (id, decision) — where a size read
            after would show it in neither."""
            cursor = None
            live = (read_proxy() or {}).get(meta_key)
            if live:
                try:
                    cursor = f"{Path(live).name}:{Path(live).stat().st_size}"
                except OSError:
                    cursor = f"{Path(live).name}:0"
            self._json({"events": _events_history(filters, limit, pattern),
                        "cursor": cursor})

        def _events(self, query):
            filters = {}
            for key in ("since", "until"):
                if key in query:
                    try:
                        t = datetime.fromisoformat(query[key])
                    except ValueError:
                        return self._json({"error": f"{key}: not an ISO-8601 timestamp"},
                                          400)
                    if t.tzinfo is None:         # records are offset-aware; comparing one
                        return self._json(       # to a naive time raises, so refuse early
                            {"error": f"{key}: needs a UTC offset "
                                      f"(e.g. {query[key]}+00:00)"}, 400)
                    filters[key] = t
            for key in ("session", "decision", "method", "host"):
                if key in query:
                    filters[key] = query[key]
            limit = self._limit(query, UI_EVENTS_LIMIT, UI_EVENTS_LIMIT_MAX)
            if limit is None:
                return
            self._page(filters, limit, "events", "events-*.jsonl")

        def _capture(self, query):
            filters = {}
            if "session" in query:
                filters["session"] = query["session"]
            limit = self._limit(query, UI_EVENTS_LIMIT, UI_EVENTS_LIMIT_MAX)
            if limit is None:
                return
            self._page(filters, limit, "capture", "capture-*.jsonl")

        def _search(self, query):
            q = query.get("q") or ""
            if len(q) < UI_SEARCH_MIN_QUERY:
                return self._json(
                    {"error": f"q: need at least {UI_SEARCH_MIN_QUERY} characters"}, 400)
            limit = self._limit(query, UI_SEARCH_LIMIT, UI_SEARCH_LIMIT)
            if limit is None:
                return
            results, truncated = _search_trail(q, query.get("session"), limit)
            self._json({"results": results, "truncated": truncated})

        def _session(self, ident):
            meta, state, sdir = _resolve_ident(ident)
            if meta is None:
                return self._json({"error": f"no such session: {ident}"}, 404)
            try:
                rules = (sdir / "rules.txt").read_text(encoding="utf-8",
                                                       errors="replace")
            except OSError:
                rules = ""
            proxy = read_proxy() or {}
            # A live session can be frozen. Only the reported state says so:
            # `state` is placement (live vs archived) and keeps driving the
            # briefs map — a frozen VM still runs, so it reads as live there.
            reported = _session_state(meta["name"]) if state == "live" else state
            self._json({"session": meta, "state": reported,
                        "journal": _read_journal(sdir / "journal.jsonl"),
                        "briefs": _session_briefs(meta, state, sdir),
                        "rules": rules,
                        "pointers": {"events": proxy.get("events"),
                                     "captures": [str(p) for p in
                                                  _events_files("capture-*.jsonl")]}})

        def _output(self, ident, query):
            meta, state, sdir = _resolve_ident(ident)
            if meta is None:
                return self._json({"error": f"no such session: {ident}"}, 404)
            try:
                tail = int(query.get("tail", UI_OUTPUT_TAIL))
            except ValueError:
                return self._json({"error": "tail: not an integer"}, 400)
            if tail < 1:
                return self._json({"error": "tail: must be >= 1"}, 400)
            payload, code = _session_output(meta, state, sdir,
                                            min(tail, UI_OUTPUT_TAIL_MAX))
            self._json(payload, code)

        def _diff(self, ident):
            meta, state, sdir = _resolve_ident(ident)
            if meta is None:
                return self._json({"error": f"no such session: {ident}"}, 404)
            with _DIFF_LOCK:
                if ident in _DIFF_BUSY:          # one guest git per session at a time
                    return self._json(
                        {"error": "a diff for this session is already running"}, 429)
                _DIFF_BUSY.add(ident)
            try:
                if state == "live":
                    if not (meta.get("branch") or meta.get("checkout")):
                        return self._json(
                            {"error": "this session has no git checkout to diff"}, 409)
                    status, diff, err = _diff_in_guest(meta)
                    if err is not None:
                        return self._json({"error": err}, 409)
                    diff, truncated = _clip_text(diff, _DIFF_MAX_BYTES)
                    return self._json({"mode": "guest", "status": status,
                                       "diff": diff, "truncated": truncated})
                if not meta.get("branch"):
                    return self._json(
                        {"error": "this session had no branch — nothing came back"}, 409)
                if not meta.get("branch_ingested"):
                    return self._json(
                        {"error": "never harvested — no commits reached the host"}, 409)
                proc = _git(meta["git_dir"], "diff",
                            f"{meta['base']}..refs/heads/{meta['branch']}")
                if proc is None or proc.returncode:
                    return self._json({"error": "host git diff failed — the branch "
                                                "may be gone from the repository"}, 409)
                diff, truncated = _clip_text(proc.stdout, _DIFF_MAX_BYTES)
                # An archived diff has no worktree, so there is no status to report.
                self._json({"mode": "host", "status": "", "diff": diff,
                            "truncated": truncated})
            finally:
                with _DIFF_LOCK:
                    _DIFF_BUSY.discard(ident)

        # This and _kill are mirrored in README.md (Audit UI). Update both.
        def _control(self, ident, action):
            meta, state, _ = _resolve_ident(ident)
            if meta is None:
                return self._json({"error": f"no such session: {ident}"}, 404)
            if state != "live":
                return self._json(
                    {"error": "an archived session cannot be controlled"}, 409)
            if action == "down":
                try:
                    _down_session(meta)
                except SystemExit:               # die() inside the teardown: kept whole
                    return self._json({"error": "teardown failed — the session is "
                                                "kept; run `silkgate down` for the "
                                                "full report"}, 409)
                return self._json({"ok": True})
            err = (_freeze_session(meta["name"]) if action == "freeze"
                   else _resume_session(meta["name"]))
            if err is not None:
                return self._json({"error": err}, 409)
            self._json({"ok": True})

        def _kill(self, ident, exec_id):
            if not _EXEC_ID_RE.fullmatch(exec_id or ""):   # before it nears any argv
                return self._json({"error": f"invalid exec id: {exec_id}"}, 400)
            meta, state, _ = _resolve_ident(ident)
            if meta is None:
                return self._json({"error": f"no such session: {ident}"}, 404)
            if state != "live":
                return self._json(
                    {"error": "an archived session has nothing to kill"}, 409)
            token, detail = _kill_in_guest(meta, exec_id)
            if token == "SILKGATE_KILLED":
                _journal(meta["name"], "killed", exec_id=exec_id)
                return self._json({"ok": True})
            if token == "SILKGATE_NO_PIDFILE":
                return self._json({"error": f"no pidfile for exec {exec_id} — "
                                            "it already ended"}, 409)
            self._json({"error": detail or "kill failed"}, 409)

        def _stream(self, query, meta_key="events"):
            tailer = _EventsTailer(self.headers.get("Last-Event-ID")
                                   or query.get("cursor"), meta_key=meta_key)
            self.close_connection = True         # no Content-Length: the stream is the body
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-cache")
            self._security()
            self.end_headers()
            self.wfile.write(b"retry: 2000\n\n")
            self.wfile.flush()                   # BufferedWriter: an unflushed SSE frame
            beat = time.monotonic()              # sits in the buffer, never on the wire
            while True:
                try:
                    for kind, payload, cursor in tailer.poll(read_proxy()):
                        if kind == "reset":
                            frame = f"id: {cursor}\nevent: reset\ndata: {{}}\n\n"
                        else:
                            frame = f"id: {cursor}\ndata: {payload}\n\n"
                        self.wfile.write(frame.encode())
                        self.wfile.flush()
                        beat = time.monotonic()
                    if time.monotonic() - beat >= UI_STREAM_HEARTBEAT:
                        self.wfile.write(b": alive\n\n")
                        self.wfile.flush()
                        beat = time.monotonic()
                except (BrokenPipeError, ConnectionResetError):
                    return                       # closed tab: this thread's work is done
                time.sleep(UI_STREAM_POLL)

    class Server(ThreadingHTTPServer):
        daemon_threads = True                    # Ctrl-C must not wait on an open stream

    return Server(("127.0.0.1", port), Handler)


def cmd_ui(args):
    """Serve the local audit UI: static assets from ui/ plus the sessions, history and
    live-stream endpoints. Needs no running proxy — history and session listings work
    on their own, and the stream heartbeats until a proxy appears."""
    if not (UI_DIR / "index.html").is_file():
        die(f"ui assets not found at {UI_DIR} — run from a complete checkout "
            "(the ui/ directory ships with the repo)")
    try:
        server = _ui_server(args.port)
    except OSError:
        die(f"cannot bind the ui at 127.0.0.1:{args.port} — "
            + _port_in_use_error(args.port))
    host, port = server.server_address[:2]
    say(f"silkgate ui at http://{host}:{port}/ — Ctrl-C stops it")
    server.serve_forever()


# The full check installs its own probe tools *through* the proxy, then trusts the CA so
# the https probes can complete. The CA is mounted in, since nothing is baked here.
# -q is explicit because apt's tty detection asks about the guest's stdout, and a terminal
# there gets a \r-repainting meter that's unreadable line by line. One -q drops the meter
# and keeps the Get:/Fetched lines, which explain a failed install.
FULL_SETUP = ("export DEBIAN_FRONTEND=noninteractive && "
              "apt-get -q update && "
              "apt-get -q -o Dpkg::Use-Pty=0 install -y --no-install-recommends"
              " curl ca-certificates dnsutils iputils-ping iproute2 && "
              "cp /mnt/ca/egress-ca.pem /usr/local/share/ca-certificates/egress.crt && "
              "update-ca-certificates && ")


# verify_guest.sh reports which checks ran. A check that didn't run proves nothing, so the
# set that ran is asserted, not a count of passes.
#
# The checks, and which ones a bare guest must run, are read from the script. Each check
# opens with a line naming what it needs installed:
#
#     # CHECK 7 tools:ip — root routes around the boundary
#     # CHECK 3 tools:none — direct TCP/443 to a raw IP
#
# and `tools:none` is what makes a check part of the bare run. The set is derived, never
# restated here, so it can't drift from the script: a `have` gate added to a tool-free check
# moves it out of the bare set by itself. Check 7, for example, needs `ip`, which only
# `--full` installs.
#
# A `subject:<capability>` field lets a check report UNAVAILABLE, when the guest lacks what
# it would probe (a v6 check with no v6 path). _verify_shortfall refuses UNAVAILABLE from a
# check that declares no subject, so "nothing to test" can't slip in as a bare string.
#
# If the script can't be read, the sets are empty and _verify_shortfall refuses the run.
# Other commands don't need them, and still work.
_VERIFY_SCRIPT = REPO / "test" / "verify_guest.sh"
_CHECK_DECL = re.compile(r"^#\s*CHECK\s+(\d+)\s+tools:(\S+)(?:\s+subject:(\S+))?", re.M)


def _declared_checks(path=None):
    """(every check id, the ids needing no installed tool, {id: the subject a guest may
    lack}) as verify_guest.sh declares them."""
    try:
        text = (path or _VERIFY_SCRIPT).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return frozenset(), frozenset(), {}
    declared = _CHECK_DECL.findall(text)
    return (frozenset(int(n) for n, _, _ in declared),
            frozenset(int(n) for n, tools, _ in declared if tools == "none"),
            {int(n): subject for n, _, subject in declared if subject})


_VERIFY_CHECKS, _VERIFY_TOOL_FREE, _VERIFY_SUBJECTS = _declared_checks()


def _ids(ids):
    return ", ".join(str(i) for i in sorted(ids))


def _parse_checks(line):
    """`CHECKS: ran=3,7 skipped=1,2 unavailable=5` -> ({3, 7}, {1, 2}, {5}). A line from
    before the unavailable field parses with an empty third set."""
    fields = dict(re.findall(r"(ran|skipped|unavailable)=([\d,]*)", line))

    def ids(key):
        return {int(i) for i in fields.get(key, "").split(",") if i}

    return ids("ran"), ids("skipped"), ids("unavailable")


def _verify_shortfall(passed, failed, ran, skipped, unavailable=frozenset(), *, full):
    """Why a verify run does not prove containment, or None if it does."""
    if failed:
        return f"containment check FAILED ({passed} passed, {failed} failed)"
    expected = _VERIFY_CHECKS if full else _VERIFY_TOOL_FREE
    if not expected:
        return (f"cannot tell which checks should have run: no '# CHECK n tools:' declarations "
                f"in {_VERIFY_SCRIPT} — containment unproven")
    # "Nothing to test" is the easiest verdict to abuse — accepted wholesale, unavailable=1..15
    # from a guest that ran nothing would read as containment — so it is honoured only from
    # the checks whose declarations say their subject can be absent, and never for a check
    # that also claims to have run.
    undeclared = unavailable - _VERIFY_SUBJECTS.keys()
    if undeclared:
        return (f"check(s) {_ids(undeclared)} report their subject absent, but their CHECK "
                f"declarations name no subject: a guest may lack "
                f"(only {_ids(_VERIFY_SUBJECTS) or 'none of them'} do) — a check that could "
                "have run did not, so containment is unproven")
    contradicted = unavailable & ran
    if contradicted:
        return (f"verify output disagrees with itself: check(s) {_ids(contradicted)} both ran "
                "and reported nothing to test")
    missing = expected - ran - unavailable
    if missing:
        needs_tools = _ids(_VERIFY_CHECKS - _VERIFY_TOOL_FREE) or "none of them"
        return (f"containment unproven — check(s) {_ids(missing)} never ran"
                + (f" (skipped: {_ids(skipped)})" if skipped else "")
                + (f"; --full installs what {needs_tools} need, and the rest skip only when "
                   "an in-guest control failed" if full
                   else "; those declare tools:none, so something other than a missing tool "
                        "is wrong"))
    if passed != len(ran):
        return f"verify output disagrees with itself: {passed} passed of {len(ran)} that ran"
    return None


# --- verify: evidence outside the guest ---------------------------------------------------
# Everything above trusts two lines the GUEST printed, and a hostile guest can print them.
# The oracles are the host's own record of the same run, which no guest can produce: the
# run's audit log, a listener that does or doesn't receive a packet, and an endpoint that
# records the header that arrived.
#
# Each oracle reports (kind, text). "observed": the host saw something forbidden (a packet,
# an added credential). "unproven": corroborating evidence is missing. A failed check is a
# boundary result, a silent audit log is a broken oracle, so they read differently.

_VERIFY_IMAGE = "debian"                  # the guest verify boots; bare, so probes stay honest

# The credential the recording endpoint must see arrive. Deliberately the string
# test/test_addon.py already uses, for the same reason: what proves the injection path must
# never be a real key, and one grep finds both the unit test and this live fixture.
_VERIFY_SENTINEL = "SENTINEL-NOT-A-REAL-KEY"
_VERIFY_SECRET_NAME = "verify_sentinel"   # -> SILKGATE_EGRESS_SECRET_VERIFY_SENTINEL, set for this run
_VERIFY_AUTH_HEADER = "x-api-key"         # the header the guest sends and the secret replaces

# The recorder's rule host must be a NAME: normalize_host rejects IP literals by design, in
# both the pattern and the request. `localhost` is the one name every host resolves to
# loopback without a hosts-file edit, and only the *proxy* resolves it — it runs on the host,
# and the guest names the same authority in an absolute-form request line it never resolves.
_RECORDER_HOST = "localhost"
_RECORDER_PATH = "/verify/record"

# The hosts checks 1 and 2 reach (check 1's is profiles/probe/rules.txt's), so a missing
# audit record can name its check. They mirror test/verify_guest.sh: if it changes them,
# the audit assertion fails naming the expected host.
_VERIFY_ALLOWED_HOST = "registry.npmjs.org"
_VERIFY_UNLISTED_HOST = "evil.com"
# What control 0 asks the proxy for: a host no ruleset allows, so it is refused from the proxy's
# own memory. The record it produces is the only host-side evidence a *bare* run leaves.
_VERIFY_CONTROL_HOST = "silkgate.invalid"

# Verify guests are named, so an interrupted run's guest can be removed later. The pid in the
# name marks a leftover: if that pid is gone, nobody owns it. The prefix can't collide with
# session sandboxes, which start with `sg-`.
_VERIFY_GUEST_RE = re.compile(r"silkgate-verify-(\d+)-(?:main|leaky)\Z")


def _verify_guest_name(kind):
    return f"silkgate-verify-{os.getpid()}-{kind}"


def _verify_msb_argv(sandbox, port, *, mounts=()):
    """`msb create` argv for a named verify guest whose only egress is one proxy port.

    A named `create` + `exec` + `rm` guest, because stopping an `msb run` client leaves its
    sandbox running, with a port allowance the next run collides with. The flags are
    msb_argv's, so verify tests the policy every session gets. _leaky_argv derives the
    negative control from this.
    """
    argv = [_msb(), "create", _VERIFY_IMAGE, "--name", sandbox]
    for m in mounts:
        argv += ["-v", m]
    url = f"http://{PROXY_ALIAS}:{port}"
    for var in PROXY_ENV_VARS:
        argv += ["-e", f"{var}={url}"]
    argv += ["--net-default-egress", "deny", "--net-rule", f"allow@host:tcp:{port}"]
    return argv


def _leaky_argv(argv):
    """The same guest with msb's egress default flipped to allow — a guest that really leaks.

    Dropping --net-default-egress deny does NOT open egress: msb denies by default once
    any --net-rule is present. Setting it to `allow` does. So the flip is the whole
    mechanism, and a renamed flag must fail here, not quietly produce a contained guest
    whose silence would read as "the checks cannot fail".
    """
    out = list(argv)
    try:
        i = out.index("--net-default-egress")
    except ValueError:
        die("cannot build the negative control: the verify guest's argv carries no "
            "--net-default-egress to flip, so nothing here would open egress — the guest "
            "would be contained and its passing checks would prove nothing")
    if out[i + 1] != "deny":
        die(f"cannot build the negative control: --net-default-egress is {out[i + 1]!r}, "
            "not 'deny' — refusing to guess what would open egress")
    out[i + 1] = "allow"
    return out


def _create_verify_guest(sandbox, port, *, mounts=(), leaky=False, why=""):
    """Create (and boot) one named verify guest, or die. msb's own output is inherited rather
    than captured, as in _provision_session: the first run pulls the image, and a silent minute
    reads as a hang. `leaky` is the negative control's guest — the same guest, egress open."""
    argv = _verify_msb_argv(sandbox, port, mounts=mounts)
    if subprocess.run(_leaky_argv(argv) if leaky else argv).returncode:
        _remove_sandbox(sandbox)              # a failed create can still register the name
        die(f"msb create failed for verify guest {sandbox} (see msb's output above){why}")


def _drop_verify_guest(sandbox, guests):
    """Remove one verify guest now, keeping it in `guests` if it is not verifiably gone.

    Uses _remove_sandbox, as sessions do. A guest that survives isn't just untidy: its port
    allowance collides with the next verify.
    """
    if _remove_sandbox(sandbox):
        guests.discard(sandbox)
        return True
    return False


def _reap_leaked_verify_guests():
    """Remove verify guests earlier runs left behind, naming each.

    Only guests whose pid is gone: a name whose owner still runs belongs to a concurrent
    verify (proxy_alive is a bare pid-liveness test despite its name — a recycled pid
    therefore keeps a leftover, which errs toward leaving another process's guest alone).
    """
    msb = shutil.which("msb")
    if not msb:
        return
    listed = subprocess.run([msb, "list"], capture_output=True, text=True)
    if listed.returncode:
        return
    for line in listed.stdout.splitlines()[1:]:
        name = (line.split() or [""])[0]
        match = _VERIFY_GUEST_RE.fullmatch(name)
        if not match or int(match[1]) == os.getpid() or proxy_alive(int(match[1])):
            continue
        say(f"removing {name}: an interrupted verify left it behind (pid {match[1]} is gone), "
            "and it still holds a Tier-1 rule and a port allowance")
        if not _remove_sandbox(name):
            say(f"could not remove {name} — `msb stop {name} && msb rm {name}` by hand")


def _oracle_port(proxy_port, offset):
    """A host port `offset` above the proxy's, folded below it at the top of the range — the
    same fold check 10 does for the neighbouring port it probes."""
    port = proxy_port + offset
    return port if port <= 65535 else proxy_port - offset


def _port_holder(port):
    """Who holds `port`, for an error message: lsof's answer where lsof is installed, else the
    command that would say. Same remedy shape as _port_in_use_error, which covers the proxy's
    own ports; these are the oracles'."""
    ask = f"lsof -nP -i:{port} names the holder"
    lsof = shutil.which("lsof")
    if not lsof:
        return ask
    try:
        out = subprocess.run([lsof, "-nP", f"-i:{port}"], capture_output=True, text=True,
                             timeout=5).stdout.splitlines()
    except (OSError, subprocess.SubprocessError):
        return ask
    rows = [ln.split() for ln in out[1:] if ln.strip()]
    named = "; ".join(f"{r[0]} (pid {r[1]})" for r in rows[:3] if len(r) >= 2)
    return f"held by {named}" if named else ask


def _oracle_bind(port, socktype, what):
    """Bind `port` on every address the proxy listens on, or die naming the holder.

    PROXY_BINDS, because guest traffic lands there, and the guest tries the v6 alias first.
    An oracle on one family could stay silent because the guest used the other, which would
    look exactly like containment.
    """
    socks = []
    for addr in PROXY_BINDS or ("127.0.0.1",):
        sock = socket.socket(socket.AF_INET6 if ":" in addr else socket.AF_INET, socktype)
        try:
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            sock.bind((addr, port))
            if socktype == socket.SOCK_STREAM:
                sock.listen(16)
        except OSError as e:
            sock.close()
            for other in socks:
                other.close()
            die(f"cannot bind the {what} at {addr}:{port} ({e.strerror}) — {_port_holder(port)}")
        socks.append(sock)
    return socks


class _ArrivalObserver:
    """A host listener — TCP and UDP — on a port the guest's Tier-1 rule does not allow.

    Every other verdict is the guest saying it heard nothing, and for UDP it can't even
    tell (a denied sendto succeeds silently). This is the wire's other end. The port stays
    out of the allow rule, so an arrival means the rule is wider than `tcp:<proxy port>`.

    Nothing is read during the run: connections wait in the backlog, datagrams in the
    buffer, until drain(). Silence counts only after self_test() shows these sockets
    receive their own token, on every address and protocol.
    """

    def __init__(self, port):
        self.port = port
        self.arrivals = []
        self.self_token = "self-" + uuid4().hex
        self.guest_token = "guest-" + uuid4().hex
        self._socks = []
        try:
            self._socks = [("tcp", s) for s in
                           _oracle_bind(port, socket.SOCK_STREAM, "arrival observer (tcp)")]
            self._socks += [("udp", s) for s in
                            _oracle_bind(port, socket.SOCK_DGRAM, "arrival observer (udp)")]
        except BaseException:                  # incl. SystemExit from die(): keep no half-bind
            self.close()
            raise
        for _, sock in self._socks:
            sock.setblocking(False)
        # Recorded at construction, not read off the sockets on demand: what has to be proven
        # is what this observer *bound*, and a closed observer whose bound() answered "nothing"
        # would make the self-proof below vacuous — silence passing for the reason it must not.
        self._bound = [(proto, sock.getsockname()[0]) for proto, sock in self._socks]

    def bound(self):
        """The (proto, address) pairs this observer listened on, closed or not."""
        return list(self._bound)

    def self_test(self):
        """Send this observer's own token to every address it bound, both protocols. What
        comes back is what the caller may treat as functional; anything else makes this
        observer's later silence meaningless, and the run says so instead of concluding."""
        for proto, sock in self._socks:
            addr = sock.getsockname()[0]
            family = sock.family
            try:
                if proto == "tcp":
                    with socket.socket(family, socket.SOCK_STREAM) as probe:
                        probe.settimeout(2)
                        probe.connect((addr, self.port))
                        probe.sendall(self.self_token.encode())
                else:
                    with socket.socket(family, socket.SOCK_DGRAM) as probe:
                        probe.settimeout(2)
                        probe.sendto(self.self_token.encode(), (addr, self.port))
            except OSError:
                continue                       # the missing arrival is the report
        self.drain()

    def drain(self, settle=0.3):
        """Take everything the kernel has queued on these sockets into self.arrivals."""
        time.sleep(settle)                     # a loopback or VMM delivery lands in µs
        for proto, sock in self._socks:
            addr = sock.getsockname()[0]
            while True:
                try:
                    if proto == "tcp":
                        conn, peer = sock.accept()
                        with conn:
                            conn.settimeout(0.3)
                            try:
                                data = conn.recv(4096)
                            except OSError:    # connected and sent nothing: still an arrival
                                data = b""
                    else:
                        data, peer = sock.recvfrom(4096)
                except OSError:                # BlockingIOError included: nothing more queued
                    break
                self.arrivals.append({
                    "proto": proto, "addr": addr,
                    "peer": f"{peer[0]}:{peer[1]}" if isinstance(peer, tuple) else str(peer),
                    "data": data.decode("ascii", "replace")[:200],
                })

    def close(self):
        for _, sock in self._socks:
            try:
                sock.close()
            except OSError:
                pass
        self._socks = []


def _observer_problems(arrivals, *, bound, self_token, guest_token, port, proxy_port):
    """(problems, summary) for what did and did not reach the observer."""
    proved = {(a["proto"], a["addr"]) for a in arrivals if self_token in a["data"]}
    missing = [pair for pair in bound if pair not in proved]
    problems = []
    if missing:
        problems.append(("unproven",
                         "the arrival observer never received its own loopback send on "
                         + ", ".join(f"{proto} {addr}:{port}" for proto, addr in missing)
                         + " — a listener that cannot hear itself proves nothing by staying "
                         "silent, so this run observed nothing either way"))
    for a in arrivals:
        if guest_token in a["data"]:
            problems.append(("observed",
                             f"a {a['proto']} packet from the verify guest REACHED the host at "
                             f"{a['addr']}:{port} (peer {a['peer']}), carrying this run's "
                             f"token — the Tier-1 rule is wider than tcp:{proxy_port}, which "
                             "no probe inside the guest can see"))
        elif self_token not in a["data"]:
            problems.append(("observed",
                             f"a {a['proto']} arrival at {a['addr']}:{port} from {a['peer']} "
                             f"carried neither token ({a['data'][:60]!r}) — something reached a "
                             "host port this run denies, and it is not this fixture"))
    return problems, (f"observer: {len(proved)}/{len(bound)} self-sends heard, "
                      f"nothing from the guest at :{port}" if not problems
                      else f"observer: {len(problems)} problem(s) at :{port}")


def _recorder_rules(port):
    """The one verify-only rule that puts the recording endpoint in the guest's reach.

    It's the "host loopback service in reach" hazard, so it's narrow and in no profile: one
    port, one path, POST only (which also tests method enforcement). No `q:`, `h:`, or
    max_body, so stripping and the no-body default stay live.
    """
    return (f"# --- verify only: the host-side Tier-2 recorder, port {port} ---\n"
            f"{_RECORDER_HOST}:{port}{_RECORDER_PATH}/** POST "
            f"inject_auth={_VERIFY_SECRET_NAME}\n")


class _HeaderRecorder:
    """A host-loopback HTTP endpoint that RECORDS what arrived and reflects nothing.

    It tests "guest code execution can't steal the key" against the real proxy: the guest
    sends a dummy credential, the host holds a sentinel, and the header that arrives says
    which went upstream. It answers 204 and nothing else, so the guest learns nothing. It's
    not the reflector the docs warn about: it holds a sentinel, not a real key, for one run.
    """

    def __init__(self, port):
        # Local imports: only this fixture needs an HTTP server, and every `silkgate exec`
        # would otherwise pay for importing one.
        import threading
        from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

        self.port = port
        self.records = []
        records = self.records

        class Handler(BaseHTTPRequestHandler):
            protocol_version = "HTTP/1.1"
            server_version = "silkgate-verify-recorder"
            sys_version = ""

            def _record(self):
                length = int(self.headers.get("content-length") or 0)
                body = self.rfile.read(length) if length else b""
                records.append({"method": self.command, "target": self.path,
                                "headers": [(k.lower(), v) for k, v in self.headers.items()],
                                "body_len": len(body)})
                self.send_response(204)        # nothing useful: not the guest's oracle
                self.send_header("Content-Length", "0")
                self.end_headers()

            do_GET = do_POST = do_PUT = do_PATCH = do_DELETE = do_HEAD = _record
            do_OPTIONS = _record

            def log_message(self, *a):         # the audit log is the record; this is noise
                pass

        class V4Server(ThreadingHTTPServer):
            daemon_threads = True              # on subclasses of our own, never on the stdlib's

        class V6Server(V4Server):
            address_family = socket.AF_INET6

        self._servers = []
        for addr in PROXY_BINDS or ("127.0.0.1",):
            cls = V6Server if ":" in addr else V4Server
            try:
                server = cls((addr, port), Handler)
            except OSError as e:
                self.close()
                die(f"cannot bind the Tier-2 recorder at {addr}:{port} ({e.strerror}) — "
                    f"{_port_holder(port)}")
            self._servers.append(server)
            threading.Thread(target=server.serve_forever, daemon=True).start()

    def rules(self):
        return _recorder_rules(self.port)

    def close(self):
        for server in getattr(self, "_servers", []):
            try:
                server.shutdown()
                server.server_close()
            except Exception:                  # already down; the records are the point
                pass
        self._servers = []


def _clip_oracle(text, limit=200):
    """Guest-supplied text in a host-side message, bounded — a header the guest chose must not
    be able to bury the finding it is evidence for."""
    return text if len(text) <= limit else text[:limit] + "..."


def _recorder_problems(records, *, token, port):
    """(problems, summary) for what the recording endpoint received.

    Two sentinels decide it. The guest's token, sent in the query, the dummy credential, and
    an extra header, must appear in nothing that arrived. The host's sentinel must be the
    auth header's value on the request that sent one, and absent from the one that didn't.
    """
    by_path = {}
    for rec in records:
        by_path.setdefault(rec["target"].partition("?")[0], []).append(rec)
    problems, seen = [], []
    for leaf, why in (("replace", "the request that carried a credential"),
                      ("add", "the request that carried none")):
        path = f"{_RECORDER_PATH}/{leaf}"
        got = by_path.pop(path, [])
        if not got:
            problems.append(("unproven",
                             f"nothing arrived at {_RECORDER_HOST}:{port}{path} — {why} never "
                             "reached the recorder, so Tier 2 is not proven end to end here "
                             "(the guest's own reply code and the audit log say which hop "
                             "dropped it)"))
            continue
        rec = got[-1]
        seen.append(leaf)
        auth = [v for name, v in rec["headers"] if name == _VERIFY_AUTH_HEADER]
        arrived = rec["target"] + " " + " ".join(f"{n}: {v}" for n, v in rec["headers"])
        if token in arrived:
            problems.append(("observed",
                             f"the guest's own token crossed the proxy to {path}: "
                             f"{_clip_oracle(arrived)} — a query param, a header or a header "
                             "value the ruleset does not allow was forwarded"))
        if rec["method"] != "POST":
            problems.append(("observed",
                             f"{rec['method']} reached {path}, and the rule allows POST only"))
        if leaf == "replace" and not auth:
            problems.append(("unproven",
                             f"no {_VERIFY_AUTH_HEADER} arrived at {path} at all, though the "
                             "guest sent one and the rule injects into it — the request got "
                             "through with the header dropped, which proves nothing either way"))
        elif leaf == "replace" and auth != [_VERIFY_SENTINEL]:
            problems.append(("observed",
                             f"{_VERIFY_AUTH_HEADER} arrived at {path} as {auth!r}, not the "
                             "host's sentinel exactly once — the injected value must REPLACE "
                             "the header the guest sent"))
        elif leaf == "add" and auth:
            problems.append(("observed",
                             f"{_VERIFY_AUTH_HEADER} arrived at {path} as {auth!r}, and that "
                             "request sent none — the proxy ADDED a credential to a request "
                             "that did not carry one, which is the guarantee every guest is "
                             "given"))
    for path, got in by_path.items():
        problems.append(("observed",
                         f"{got[-1]['method']} {path} reached the recorder, and no rule in this "
                         "run's ruleset allows it — the proxy forwarded a request it must have "
                         "refused"))
    return problems, (f"recorder: credential replaced, never added, on {len(seen)}/2 requests "
                      f"at :{port}; nothing else got through" if not problems
                      else f"recorder: {len(problems)} problem(s) at :{port}")


def _oracle_guest_script(*, proxy_port, observer_port, recorder_port, token):
    """The probes the guest runs for the host-side oracles: tool-free bash, one line each.

    Only /dev/tcp, /dev/udp, and printf, so they run on the bare image, over plain HTTP
    through the proxy. Every literal is baked in, so nothing dynamic is quoted.

    The observer probes hit a port Tier 1 denies: the guest's errno is its evidence, the
    observer's silence the host's. The recorder requests carry the token where it must be
    stripped, a dummy where the sentinel must replace it, no credential where none may be
    added, and a forbidden method.
    """
    alias, req = PROXY_ALIAS, f"http://{_RECORDER_HOST}:{recorder_port}{_RECORDER_PATH}"
    host_hdr = f"Host: {_RECORDER_HOST}:{recorder_port}"

    def request(method, leaf, *headers):
        """One request as bash ANSI-C quoting will carry it: CRLF-terminated, body-less.

        `$'...'` and not a command substitution, because $() strips the trailing newlines —
        which here are the blank line that ends the request.
        """
        lines = [f"{method} {req}/{leaf} HTTP/1.1", host_hdr, *headers,
                 "Content-Length: 0", "Connection: close", "", ""]
        return "\\r\\n".join(lines)

    replace = request("POST", f"replace?leak={token}",
                      f"{_VERIFY_AUTH_HEADER}: DUMMY-{token}", f"x-exfil: {token}")
    return "\n".join([
        "set -u",
        f"probe(){{ if err=$(timeout 5 bash -c \"exec 3<>/dev/$1/{alias}/{observer_port} "
        f"&& printf %s {token} >&3\" 2>&1); then echo \"ORACLE observer-$1 sent\"; "
        "else echo \"ORACLE observer-$1 blocked $(printf %s \"$err\" | tr -d '\\r' | "
        "tail -n1 | cut -c1-90)\"; fi; }",
        "probe tcp",
        "probe udp",
        # One connection per request, and only the status line is read: the guest's view of the
        # fixture is a three-digit number, which is all a hostile guest could learn here. The
        # code is reported as 000 unless it really is three digits, so a connection that never
        # got a reply cannot be read on the host as a status the proxy sent.
        f"req(){{ label=$1; out=$(timeout 5 bash -c 'exec 3<>/dev/tcp/{alias}/{proxy_port} "
        "|| exit 9\n"
        'printf %s "$1" >&3\nIFS= read -r line <&3\nprintf %s "$line"\' _ "$2" 2>&1); rc=$?; '
        "out=$(printf %s \"$out\" | tr -d '\\r' | head -n1); set -- $out; code=${2:-000}; "
        "case $code in [0-9][0-9][0-9]) ;; *) code=000 ;; esac; "
        "echo \"ORACLE $label code=$code rc=$rc reply=$(printf %s \"$out\" | cut -c1-70)\"; }",
        "req recorder-replace $'" + replace + "'",
        "req recorder-add $'" + request("POST", "add") + "'",
        "req recorder-method $'" + request("GET", "method") + "'",
    ]) + "\n"


_ORACLE_LINE_RE = re.compile(r"ORACLE\s+(\S+)\s+(.*)")


def _oracle_report(lines):
    """{label: detail} from the guest's own ORACLE lines — what it says it attempted."""
    report = {}
    for line in lines:
        m = _ORACLE_LINE_RE.search(line)
        if m:
            report[m[1]] = m[2].strip()
    return report


def _probe_problems(report, *, observer_port):
    """(problems, summary) for what the guest says its probes did.

    The observer's silence counts only once the guest confirms it sent. A TCP refusal is the
    expected result, and its errno separates a boundary decision from a missing route. So
    `blocked` passes, and a missing line doesn't.
    """
    problems, notes = [], []
    for proto in ("tcp", "udp"):
        detail = report.get(f"observer-{proto}")
        if detail is None:
            problems.append(("unproven",
                             f"the guest never reported its {proto} probe of the observer "
                             f"port {observer_port}, so nothing observed there means anything"))
        else:
            notes.append(f"{proto} {detail}")
    if report.get("observer-udp", "").split()[:1] == ["blocked"]:
        problems.append(("unproven",
                         "the guest could not even open a UDP socket to the observer port "
                         f"({report['observer-udp']}) — a denied sendto succeeds everywhere "
                         "this was verified, so a failure here is a broken probe, not "
                         "containment"))
    for label, want in (("recorder-replace", "204"), ("recorder-add", "204"),
                        ("recorder-method", "403")):
        detail = report.get(label)
        if detail is None:
            problems.append(("unproven",
                             f"the guest never reported {label}, so its half of the Tier-2 "
                             "fixture did not run"))
            continue
        got = re.search(r"code=(\d{3})", detail)
        if got is None or got[1] == "000":
            problems.append(("unproven",
                             f"the guest got no status line for {label} ({detail}) — its "
                             "request reached no proxy at all, so it says nothing about what "
                             "the proxy does with one"))
        elif got[1] != want:
            observed = label == "recorder-method" and got[1].startswith("2")
            problems.append(("observed" if observed else "unproven",
                             f"the guest saw {got[1]} for {label}, not {want} ({detail}) — "
                             + ("a method the rule does not allow was forwarded"
                                if observed else
                                "so what that request proves about Tier 2 is not what this "
                                "fixture claims")))
    return problems, ("guest probes: " + "; ".join(notes) if notes else "guest probes: none")


def _audit_records(text):
    """The addon's JSON audit records out of a proxy log, in order.

    Drops mitmdump's timestamp prefix and its own chatter: everything before the first brace,
    and any line that doesn't parse. Like `logs --audit`, without the session filter.
    """
    records = []
    for line in text.splitlines():
        brace = line.find("{")
        if brace < 0:
            continue
        try:
            rec = json.loads(line[brace:])
        except ValueError:
            continue
        if isinstance(rec, dict) and rec.get("decision"):
            records.append(rec)
    return records


def _audit_expectations(*, full, recorder_port=None):
    """What this run's audit log must contain, each naming the guest line it corroborates."""
    expect = []
    if full:
        # Checks 1 and 2 are the two the guest reports as proxy-path results. Tying them to
        # the host's record is what closes the loop: a `403` the guest saw could have come
        # from anything on that port, and an allowed host it reached could have been reached
        # around the proxy entirely.
        expect.append({"decision": "allow", "host": _VERIFY_ALLOWED_HOST,
                       "why": "check 1's allowed host"})
        expect.append({"decision": "deny", "host": _VERIFY_UNLISTED_HOST,
                       "why": "check 2's unlisted host"})
    if recorder_port is not None:
        # Method, not path: the allow record is written after query stripping has rewritten the
        # request's path, and pinning the string mitmproxy leaves there would make this oracle
        # fail for a reason that is not about egress. The two POSTs are told apart at the
        # recorder, which sees what actually arrived.
        expect.append({"decision": "allow", "host": _RECORDER_HOST, "port": recorder_port,
                       "method": "POST", "why": "the recorder's two allowed POSTs"})
        expect.append({"decision": "deny", "host": _RECORDER_HOST, "port": recorder_port,
                       "method": "GET", "why": "the recorder request whose method no rule allows"})
    return expect


def _audit_missing(records, expectations):
    """The expectations no record satisfies — pure, because the poll loop below and the verdict
    itself must ask exactly the same question."""
    return [want for want in expectations
            if not any(all(rec.get(k) == v for k, v in want.items() if k != "why")
                       for rec in records)]


def _audit_problems(text, expectations, *, log_path):
    """(problems, summary) for the audit log against what this run should have provoked."""
    records = _audit_records(text)
    problems = []
    if not records:
        return ([("unproven",
                  f"{log_path} holds no audit record at all — either the addon stopped "
                  "auditing or the guest never reached this proxy, and the guest's own "
                  "proxy-path lines cannot tell those apart from success")],
                "audit: no records")
    for want in _audit_missing(records, expectations):
        fields = " ".join(f"{k}={v}" for k, v in want.items() if k != "why")
        problems.append(("unproven",
                         f"{log_path} holds no {fields} — nothing on the host corroborates "
                         f"{want['why']}, so that line is the guest's word alone"))
    if not any(rec["decision"] == "deny" for rec in records):
        problems.append(("unproven",
                         f"{log_path} records no deny at all, though every verify guest probes "
                         "the proxy with a host no ruleset allows (control 0) — an audit trail "
                         "with no refusal in it is not this run's"))
    elif not any(rec.get("host") == _VERIFY_CONTROL_HOST for rec in records):
        # Not fatal: the guest script owns that probe's URL, and a script that changed it is
        # not a containment finding. Worth a line, because this is the record that ties the
        # guest's `[OKAY] 0` to the proxy verify itself started.
        say(f"note: no audit record names {_VERIFY_CONTROL_HOST} — control 0's probe host is "
            "not the one this oracle expects, so only the remaining records tie the guest to "
            "this proxy")
    if _VERIFY_SENTINEL in text:
        problems.append(("observed",
                         f"the host's sentinel credential appears in {log_path} — the audit "
                         "trail is written where operators read it, and an injected value must "
                         "never be part of it"))
    decisions = {}
    for rec in records:
        decisions[rec["decision"]] = decisions.get(rec["decision"], 0) + 1
    counted = ", ".join(f"{n} {d}" for d, n in sorted(decisions.items()))
    return problems, (f"audit: {counted} in {log_path.name}" if not problems
                      else f"audit: {len(problems)} problem(s) in {log_path.name}")


def _await_audit(log_path, expectations, timeout=3.0):
    """The log's text once every expectation matches, or after `timeout` — mitmproxy logs
    through a StreamHandler, which flushes per record, but a decision made microseconds before
    the guest exited should not read as a missing one. The verdict is _audit_problems'; this
    only decides when to stop waiting for it."""
    deadline = time.monotonic() + timeout
    while True:
        try:
            text = log_path.read_text(errors="replace")
        except OSError as e:
            # No skip condition here, deliberately: the log is the host's half of the verdict,
            # and a run that cannot read it has no more evidence than the guest's word.
            die(f"cannot read the audit log {log_path} ({e.strerror}) — the run's own record "
                "is what the guest's verdict has to agree with, so nothing here is proven")
        records = _audit_records(text)
        settled = (records and not _audit_missing(records, expectations)
                   and any(rec["decision"] == "deny" for rec in records))
        if settled or time.monotonic() >= deadline:
            return text
        time.sleep(0.2)


_CHECK_LINE_RE = re.compile(r"\[(PASS|FAIL|SKIP)\]\s+(\d+)\.")


def _check_outcomes(lines):
    """{check id: 'PASS'|'FAIL'|'SKIP'} from the guest's own per-check lines.

    The per-check outcome, which the CHECKS/RESULT pair does not carry, and which the negative
    control needs: whether a *named* check failed where it should. Last line per id wins.
    """
    outcomes = {}
    for line in lines:
        m = _CHECK_LINE_RE.search(line)
        if m:
            outcomes[int(m[2])] = m[1]
    return outcomes


_NEGATIVE_CONTROL_CHECK = 3        # direct TCP to a live public service: what `allow` opens


def _negative_control_problem(contained, leaky):
    """(problem or None, summary) for the same script run in a guest that really leaks.

    Check 3 must fail there, by name, not by count: an msb that accepted `allow` and still
    enforced deny would pass every check in both guests, which must not read as "the checks
    work". Checks that passed in both guests are listed, not judged: the proxy-path ones
    should.
    """
    got = leaky.get(_NEGATIVE_CONTROL_CHECK, "no line")
    if got != "FAIL":
        return (f"the negative control established no leak: check {_NEGATIVE_CONTROL_CHECK} "
                f"reported {got} in the guest whose egress was left open, and that check is a "
                "direct connect to a live public service. Either msb no longer honours "
                "--net-default-egress allow or the probe cannot succeed on this host — either "
                "way nothing here shows the blocked-direction checks capable of failing, so "
                "this run draws no conclusion from them", None)
    both = sorted(i for i, outcome in leaky.items()
                  if outcome == "PASS" and contained.get(i) == "PASS")
    summary = (f"negative control: check {_NEGATIVE_CONTROL_CHECK} FAILED in the leaking guest"
               + (f"; checks {_ids(both)} passed in both guests" if both else
                  "; no check passed in both guests"))
    return None, summary


class _VerifyOracles:
    """The host-side half of one verify run: ports bound here, evidence read here.

    Built before the proxy, whose ruleset needs the recorder's port, and whose ports must be
    free first. Closed before the leaky guest boots, which may legitimately reach the
    observer.
    """

    def __init__(self, proxy_port):
        # The observer takes the port beside the proxy's deliberately: check 10 already probes
        # exactly that port from inside the guest and expects a refusal, so the host is now
        # watching the port the guest pokes — they agree, or the disagreement is the finding.
        self.proxy_port = proxy_port
        self.observer = _ArrivalObserver(_oracle_port(proxy_port, 1))
        try:
            self.recorder = _HeaderRecorder(_oracle_port(proxy_port, 2))
        except BaseException:                  # incl. SystemExit from die()
            self.observer.close()
            raise
        # The proxy inherits this process's environment, and SecretStore reads SILKGATE_EGRESS_SECRET_*
        # for the unscoped (single-ruleset) proxy verify starts. The value is the sentinel, so
        # what this fixture spends is never a credential.
        os.environ[f"SILKGATE_EGRESS_SECRET_{_VERIFY_SECRET_NAME.upper()}"] = \
            f"{_VERIFY_AUTH_HEADER}: {_VERIFY_SENTINEL}"

    def rules(self):
        return self.recorder.rules()

    def arm(self):
        """Prove the observer functional before anything is allowed to conclude from silence."""
        self.observer.self_test()

    def probe(self, sandbox):
        """Run the guest's half in `sandbox`, before the check script: check 7 changes the
        guest's routing and never restores it, so probes that run after it are measuring a
        network the script broke."""
        lines = []
        script = _oracle_guest_script(proxy_port=self.proxy_port,
                                      observer_port=self.observer.port,
                                      recorder_port=self.recorder.port,
                                      token=self.observer.guest_token)
        run_guest(lambda cmd: msb_exec_argv(sandbox, cmd), ["bash", "-c", script],
                  tty=False, on_line=lines.append)
        self.observer.drain()
        return _oracle_report(lines)

    def expectations(self):
        return _audit_expectations(full=False, recorder_port=self.recorder.port)

    def problems(self, report):
        """(problems, summaries) from the observer, the recorder and the guest's own report."""
        problems, summaries = [], []
        for found, summary in (
            _probe_problems(report, observer_port=self.observer.port),
            _observer_problems(self.observer.arrivals, bound=self.observer.bound(),
                               self_token=self.observer.self_token,
                               guest_token=self.observer.guest_token,
                               port=self.observer.port, proxy_port=self.proxy_port),
            _recorder_problems(self.recorder.records, token=self.observer.guest_token,
                               port=self.recorder.port),
        ):
            problems += found
            summaries.append(summary)
        return problems, summaries

    def close(self):
        self.observer.close()
        self.recorder.close()


def _oracle_die(problems, log_path):
    """Refuse the run, with the loudest framing the problems justify.

    "observed" means the host saw enforcement fail, which outranks what the guest said.
    "unproven" means an oracle can't be trusted, and must not read as a boundary failure:
    the fault is in the audit path, the ruleset, or which proxy the guest reached.
    """
    observed = [text for kind, text in problems if kind == "observed"]
    unproven = [text for kind, text in problems if kind == "unproven"]
    lines = []
    if observed:
        lines.append("CONTAINMENT FAILED OUTSIDE THE GUEST — the host itself saw this, so it "
                     "rests on nothing the guest printed:")
        lines += [f"  - {t}" for t in observed]
    if unproven:
        lines.append("  and the evidence for the rest is incomplete:" if observed else
                     "ORACLE UNPROVEN — the guest's checks passed and the host's own record of "
                     "the same run does not corroborate them. This is not a failed check: "
                     "suspect the audit path, the composed ruleset, or which proxy the guest "
                     "reached.")
        lines += [f"  - {t}" for t in unproven]
    lines.append(f"audit log: {log_path}")
    die("\n".join(lines))


def _verify_port(port):
    """The proxy port for one verify run: --port as given (a taken one fails, never moves),
    else the base of the first free POOL_SIZE range. Verify needs three ports, the proxy's
    and the two oracles' after it, and the pool scan proves them free. It also skips past a
    shared proxy's pool, so verify never contends with live sessions."""
    return port if port is not None else _find_free_pool(DEFAULT_BASE_PORT)[0]


def cmd_verify(args):
    preflight("msb", "mitmdump")
    args.port = _verify_port(args.port)
    _reap_leaked_verify_guests()
    rules_text = compose_rules(resolve_profiles(["probe"], allow_verify_only=True))
    oracles = _VerifyOracles(args.port) if args.oracles else None
    if oracles:
        rules_text += oracles.rules()
    load_ruleset(rules_text)
    script = "bash /mnt/poc/test/verify_guest.sh"
    mounts = [f"{REPO}:/mnt/poc:ro"]
    if args.full:
        mounts.append(f"{ensure_ca().parent}:/mnt/ca:ro")
        script = FULL_SETUP + script

    # The same relay as every guest command: msb streams live only with a terminal, and a
    # real one would make everything inside format for a screen. msb gets a PTY, the command
    # pipes. The parse below then reads the same cleaned text a human sees.
    found, lines, report = {}, [], {}

    def note(text):
        lines.append(text)
        m = re.search(r"RESULT: (\d+) passed, (\d+) failed", text)
        if m:
            found["result"] = (int(m[1]), int(m[2]))
        if "CHECKS: ran=" in text:
            found["checks"] = _parse_checks(text)

    guests, proxy = set(), None
    try:
        proxy, log_path = start_proxy(rules_text, args.port)
        say(f"proxy :{args.port} · audit: tail -f {log_path}")
        guest = _verify_guest_name("main")
        with _guarded_terminal():
            _create_verify_guest(guest, args.port, mounts=mounts)
            guests.add(guest)
            if oracles:
                oracles.arm()
                report = oracles.probe(guest)
            run_guest(lambda cmd: msb_exec_argv(guest, cmd), ["bash", "-c", script],
                      tty=False, on_line=note)
        _drop_verify_guest(guest, guests)      # nothing waits on it; the finally re-tries

        result, checks = found.get("result"), found.get("checks")
        if result is None:
            die("no RESULT line — the guest never ran verify_guest.sh (msb server started?)")
        if checks is None:
            die("no CHECKS line — the guest did not report which checks ran, so nothing is "
                "proven")
        passed, failed = result
        ran, skipped, unavailable = checks
        bad = _verify_shortfall(passed, failed, ran, skipped, unavailable, full=args.full)
        if bad:
            die(bad)

        # The guest's own verdict holds. Now the host's record of the same run, which is the
        # half no guest can write.
        expect = _audit_expectations(full=args.full,
                                     recorder_port=oracles.recorder.port if oracles else None)
        problems, summaries = [], []
        if oracles:
            problems, summaries = oracles.problems(report)
        audit_problems, audit_summary = _audit_problems(
            _await_audit(log_path, expect), expect, log_path=log_path)
        problems += audit_problems
        summaries.append(audit_summary)
        if problems:
            _oracle_die(problems, log_path)
        if oracles:
            oracles.close()                    # before any guest with open egress exists

        if args.negative_control:
            leaky = _verify_guest_name("leaky")
            say("negative control: booting a second guest with --net-default-egress allow, "
                "the setting that actually opens egress")
            leaky_lines = []
            with _guarded_terminal():
                _create_verify_guest(leaky, args.port, mounts=mounts, leaky=True,
                                     why=" — the control did not run, so this verify says "
                                         "nothing about whether its checks can fail")
                guests.add(leaky)
                run_guest(lambda cmd: msb_exec_argv(leaky, cmd), ["bash", "-c", script],
                          tty=False, on_line=leaky_lines.append)
            _drop_verify_guest(leaky, guests)
            problem, summary = _negative_control_problem(_check_outcomes(lines),
                                                         _check_outcomes(leaky_lines))
            if problem:
                die(problem)
            summaries.append(summary)

        left = sorted(guests)
        if left:
            die(f"verify guest(s) {', '.join(left)} could not be removed — each still holds a "
                f"Tier-1 rule and a port allowance, and the next verify collides with proxy "
                f"port {args.port}. `msb stop NAME && msb rm NAME`, then re-run")
        for summary in summaries:
            say(summary)
        # _verify_shortfall already refused any unavailable id without a declared subject,
        # so the lookup below cannot miss; the guest's [UNAV] lines above carry the detail.
        absent = ", ".join(sorted({_VERIFY_SUBJECTS[i] for i in unavailable}))
        say(f"containment holds ({passed} passed, 0 failed; checks {_ids(ran)} ran; "
            + (f"checks {_ids(unavailable)} had no subject — this guest has no {absent}, "
               "see their [UNAV] lines; " if unavailable else "")
            + ("host-side oracles agree" if oracles else "host-side oracles skipped") + ")")
    finally:
        if proxy is not None:
            stop(proxy)
        if oracles:
            oracles.close()
        for name in sorted(guests):
            if not _remove_sandbox(name):
                say(f"could not remove verify guest {name} — `msb stop {name} && msb rm "
                    f"{name}` by hand; it holds a Tier-1 rule and a port allowance")


# --- entry point ---------------------------------------------------------------
# The two argument types that reach a generated Dockerfile or an msb argv are checked by
# argparse itself, so a rejection names the flag it came from: `--with node@22.11.0` is
# exactly the token a reviewer's eye slides over on a command line composed for approval.

def _mount_arg(spec):
    """argparse type for -v/--mount: SRC:DST[:MODE] syntax alone — the path guards run at
    dispatch, where the mount list is checked as a whole (_mount_args)."""
    if _split_mount(spec) is None:
        raise argparse.ArgumentTypeError(
            f"invalid mount {spec!r} — expected SRC:DST[:ro|rw] (MODE defaults to ro)")
    return spec


def _with_arg(spec):
    """argparse type for --with: `name[@version][:arg]`. The name is resolved later,
    against the profiles that exist; the version and arg charsets are asked here."""
    try:
        _parse_spec(spec)
    except ValueError as e:
        raise argparse.ArgumentTypeError(str(e))
    return spec


def _image_arg(ref):
    """argparse type for --base and --image."""
    bad = _image_error(ref)
    if bad:
        raise argparse.ArgumentTypeError(bad)
    return ref


def _memory_arg(value):
    """argparse type for --memory: the shape msb documents for -m, digits then M or G."""
    if not re.fullmatch(r"[0-9]+[MG]", value):
        raise argparse.ArgumentTypeError(
            f"invalid memory size {value!r} — expected digits then M or G, "
            "for example 512M or 1G")
    return value


def _cpus_arg(value):
    """argparse type for --cpus: the shape msb documents for -c, a positive integer."""
    if not re.fullmatch(r"[1-9][0-9]*", value):
        raise argparse.ArgumentTypeError(
            f"invalid cpu count {value!r} — expected a positive integer, "
            "for example 2 or 4")
    return value


class _MarkedParser(argparse.ArgumentParser):
    """argparse whose stderr lines carry silkgate's voice mark.

    argparse's `usage:` and `error:` lines are host voice, so they get say()'s mark. The
    status and text stay argparse's own. error() and exit() are argparse's override points,
    and add_subparsers() reuses this class, so every subcommand is covered. Help goes to
    stdout, bare.
    """

    def exit(self, status=0, message=None):
        # argparse passes a message here only on the error path; help and version print
        # to stdout elsewhere and call this bare.
        if message:
            mark = _ERR_TAG.decode()
            sys.stderr.write("".join(mark + ln for ln in message.splitlines(keepends=True)))
            sys.stderr.flush()
        sys.exit(status)

    def error(self, message):
        # Exactly what stock error() prints — usage, then "prog: error: message" — folded
        # into one exit() message so every line passes through the marking above.
        self.exit(2, f"{self.format_usage()}{self.prog}: error: {message}\n")


# The run, up, and exec options are mirrored in README.md (More flags). Update both.
def main():
    ap = _MarkedParser(prog="silkgate", description=__doc__,
                       formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="command", required=True)

    def profile_opts(p, *, rules_only=False):
        p.add_argument("-w", "--with", dest="with_", action="append",
                       metavar="PROFILE[@VER][:ARG]", type=_with_arg,
                       help="add a profile: what to install and what it may reach "
                            "(repeatable; see `silkgate profiles`)")
        if not rules_only:
            p.add_argument("--base", default=BASE_IMAGE, type=_image_arg,
                           help=f"base image under the profiles (default: {BASE_IMAGE})")
        p.add_argument("--rule", action="append", metavar="RULE",
                       help="add one rule, e.g. 'example.com/** GET' (repeatable)")

    def env_opt(p):
        p.add_argument("-e", "--env", action="append", default=[], metavar="NAME=VALUE",
                       help="set an env var in the guest (repeatable). Secrets go in "
                            "SILKGATE_EGRESS_SECRET_<NAME> instead.")
        p.add_argument("--no-context", action="store_true",
                       help=f"don't write {GUEST_CONTEXT} or $SILKGATE_CONTEXT")
        p.add_argument("--no-settings", action="store_true",
                       help="don't copy your Claude Code model and effortLevel into the guest")

    def brief_opt(p, scope):
        p.add_argument("--brief", metavar="FILE",
                       help=f"{scope} task brief, copied to {GUEST_BRIEF} (max 1 MiB)")

    # Session guests default to 1G and half the host's CPUs — msb's own 512M / 1 vCPU
    # OOM-kills a guest that runs an agent beside a test suite. Both are limits the
    # host scheduler shares, not reservations, so oversubscription across guests is safe.
    default_cpus = str(max(1, (os.cpu_count() or 2) // 2))

    def guest_opts(p):
        """The options `run` and `up` share: the guest's image, resources, and workspace."""
        p.add_argument("--name", metavar="N", help="session name (default: a random 6-char id)")
        profile_opts(p)
        p.add_argument("--image", metavar="REF", type=_image_arg,
                       help="run this image as-is instead of building one. It must trust "
                            "the proxy's CA.")
        p.add_argument("--memory", metavar="SIZE", type=_memory_arg, default="1G",
                       help="guest memory, e.g. 512M or 2G (default: %(default)s)")
        p.add_argument("--cpus", metavar="COUNT", type=_cpus_arg, default=default_cpus,
                       help="guest CPUs (default: %(default)s, half the host's)")
        p.add_argument("--port", type=int, default=DEFAULT_BASE_PORT,
                       help="where the proxy's 16-port pool starts, if this command starts "
                            "the proxy (default: %(default)s)")
        p.add_argument("-v", "--mount", action="append", default=[], metavar="SRC:DST[:ro|rw]",
                       type=_mount_arg,
                       help="mount host directory SRC at DST, read-only unless :rw "
                            "(repeatable). $HOME, /, and silkgate's own files are refused.")
        p.add_argument("--allow-git-dir", action="store_true",
                       help="allow an rw mount that holds a .git directory. Its hooks then "
                            "run on your host the next time you use git there.")
        p.add_argument("--checkout", nargs="?", const="HEAD", default=None, metavar="REF",
                       help="give the guest a throwaway clone of this repo at REF (default "
                            "HEAD) in /workspace. Nothing comes back. Needs --with git.")
        p.add_argument("--branch", metavar="NAME",
                       help="like --checkout, on a new branch NAME whose commits come back "
                            "when the session ends. --checkout REF sets its base.")
        env_opt(p)

    p = sub.add_parser("profiles", help="list the profiles, or print the rules a spec composes")
    p.add_argument("--render", action="append", metavar="PROFILE[@VER][:ARG]",
                   type=_with_arg,
                   help="print the rules a session with these --with specs enforces "
                        "(repeatable)")
    p.set_defaults(fn=cmd_profiles)

    p = sub.add_parser("doctor", help="list missing tools (docker, msb, mitmdump), with "
                                      "install commands")
    p.set_defaults(fn=cmd_doctor)

    p = sub.add_parser("build", help="build the image for a profile list, into msb")
    profile_opts(p)
    p.add_argument("--platform", metavar="P", help="docker platform (default: the host's)")
    p.set_defaults(fn=cmd_build)

    p = sub.add_parser("proxy", help="run one ruleset on one port, in the foreground")
    profile_opts(p, rules_only=True)
    p.add_argument("--port", type=int, default=8090, help="listen port (default: 8090)")
    p.set_defaults(fn=cmd_proxy)

    p = sub.add_parser("verify", help="prove containment from inside a root guest")
    p.add_argument("--full", action="store_true",
                   help="also install probe tools through the proxy, and trust its CA")
    p.add_argument("--port", type=int, default=None,
                   help="proxy port (default: the first free 16-port range from 8090). "
                        "An explicit port fails if taken.")
    p.add_argument("--oracles", action=argparse.BooleanOptionalAction, default=True,
                   help="also check from outside the guest: the audit log, a listener that "
                        "must hear nothing, and a recorder that must see the credential "
                        "swapped (default: on)")
    p.add_argument("--negative-control", action="store_true",
                   help="also run a guest with egress open, which must fail check 3: the "
                        "proof the checks can fail")
    p.set_defaults(fn=cmd_verify)

    p = sub.add_parser("run", help="run one command in a fresh guest, then remove it")
    guest_opts(p)
    brief_opt(p, "this run's")
    p.add_argument("-t", "--tty", action=argparse.BooleanOptionalAction,
                   help="give the command a terminal (default: if stdin is one). "
                        "--no-tty keeps stdout and stderr apart.")
    p.add_argument("cmd", nargs=argparse.REMAINDER, metavar="-- CMD ...",
                   help="guest command (default: the profile's command)")
    p.set_defaults(fn=cmd_run)

    p = sub.add_parser("up", help="start a session: a guest that stays up between commands")
    guest_opts(p)
    brief_opt(p, "the default")
    p.set_defaults(fn=cmd_up)

    p = sub.add_parser("exec", help="run a command in a session's guest")
    p.add_argument("name", metavar="NAME", help="session name")
    p.add_argument("-t", "--tty", action=argparse.BooleanOptionalAction,
                   help="give the command a terminal (default: if stdin is one). "
                        "--no-tty keeps stdout and stderr apart.")
    brief_opt(p, "this exec's")
    env_opt(p)
    # nargs='*' (not REMAINDER): with a positional NAME first, REMAINDER would swallow
    # -t/-e that follow NAME. '*' lets them parse; use `--` to pass flags on to CMD.
    p.add_argument("cmd", nargs="*", metavar="-- CMD ...",
                   help="guest command (put -- before one with flags)")
    p.set_defaults(fn=cmd_exec)

    p = sub.add_parser("attach", help="open a terminal on a session, running its profile's "
                                      "command")
    p.add_argument("name", metavar="NAME", help="session name")
    p.set_defaults(fn=cmd_attach)

    p = sub.add_parser("logs", help="print a session's guest output, or its proxy decisions")
    p.add_argument("name", metavar="NAME", help="session name")
    p.add_argument("-f", "--follow", action="store_true", help="keep printing new lines")
    p.add_argument("--tail", type=int, metavar="N", help="start from the last N lines")
    p.add_argument("--since", metavar="DUR",
                   help="only lines newer than DUR, e.g. 30s or 5m (guest output only)")
    p.add_argument("--audit", action="store_true",
                   help="print this session's allow and deny decisions")
    p.add_argument("--interval", type=float, default=1.0, metavar="SECS",
                   help="poll interval for -f (default: 1.0)")
    p.set_defaults(fn=cmd_logs)

    p = sub.add_parser("ui", help="serve the audit UI on 127.0.0.1")
    p.add_argument("--port", type=int, default=DEFAULT_UI_PORT,
                   help=f"listen port (default: {DEFAULT_UI_PORT})")
    p.set_defaults(fn=cmd_ui)

    p = sub.add_parser("harvest", help="bring a --branch session's commits back now, "
                                       "without stopping it")
    p.add_argument("name", metavar="NAME", help="session name")
    p.set_defaults(fn=cmd_harvest)

    p = sub.add_parser("down", help="stop and remove a session. The last one stops the proxy.")
    p.add_argument("name", metavar="NAME", help="session name")
    p.set_defaults(fn=cmd_down)

    p = sub.add_parser("ls", help="list sessions and proxy health")
    p.add_argument("-a", "--all", action="store_true",
                   help="include archived sessions. ID is the archive's sid.")
    p.set_defaults(fn=cmd_ls)

    p = sub.add_parser("secret", help="push or list the secrets the proxy holds")
    ssub = p.add_subparsers(dest="secret_cmd", required=True)
    q = ssub.add_parser("set", help="push SILKGATE_EGRESS_SECRET_<NAME> to one session. "
                                    "The value never touches argv.")
    q.add_argument("name", metavar="NAME", help="secret name: reads SILKGATE_EGRESS_SECRET_<NAME>")
    q.add_argument("--session", required=True, metavar="SESSION",
                   help="the session that may spend it")
    q.set_defaults(fn=cmd_secret_set)
    q = ssub.add_parser("ls", help="list secret names, never values")
    q.add_argument("--session", metavar="SESSION",
                   help="one session only (default: all, by session)")
    q.set_defaults(fn=cmd_secret_ls)

    # SIGTERM must run the finally-blocks that stop mitmdump/msb, not kill us outright.
    signal.signal(signal.SIGTERM, lambda *a: sys.exit(143))
    # SIGHUP — the terminal going away over a live run — gets the same treatment and
    # the same 128+signo status, or every session and proxy this process holds would
    # outlive it. An inherited SIG_IGN (nohup) is the caller declaring hangups
    # expected, and stays.
    if signal.getsignal(signal.SIGHUP) != signal.SIG_IGN:
        signal.signal(signal.SIGHUP, lambda *a: sys.exit(129))
    args = ap.parse_args()
    try:
        args.fn(args)
    except KeyboardInterrupt:
        # An interrupt isn't an error: the finally-blocks already unwound, so just exit 130.
        # os._exit skips shutdown, which would print a pending SIGINT as a traceback.
        # SIGINT is ignored first, so a late Ctrl-C can't land in this handler.
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        try:
            sys.stdout.flush()
        except (OSError, ValueError):
            pass
        os._exit(130)
    except BrokenPipeError:
        # The reader went away (`silkgate ... | head -3`) and the unwind has already
        # run. 141 is how a shell reports a pipe death; os._exit skips interpreter
        # shutdown, whose flush of the dead stream would print "Exception ignored"
        # noise over the quiet exit.
        os._exit(141)


if __name__ == "__main__":
    main()
